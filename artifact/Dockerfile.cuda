# GraphMend CGO 2027 artifact: CUDA image, for the latency and throughput
# claims C8, C9 and C10: up to 26x cold-start forward pass speedup (5x on
# average), up to 1.39x steady-state forward pass speedup, and up to 15%
# throughput improvement, on NVIDIA RTX 3090, A40 and H100.
#
# ============================================================================
# BUILT AND GPU-VERIFIED. This image builds, reaches a physical GPU, and runs
# GraphMend on it. Verified on an RTX 3090, driver 580.65.06:
#
#   torch 2.12.1+cu126, cuda 12.6, transformers 4.52.4
#   torch.cuda.is_available() True, device "NVIDIA GeForce RTX 3090"
#   a 4096x4096 matmul executes
#   t5-small break count through the harness: off=3 on=0
#
# The host used for that has Docker WITHOUT the NVIDIA Container Toolkit, so
# `--gpus all` is refused there. It is not needed. torch's cu126 wheel vendors
# its own CUDA runtime, so all the container wants from the host is the driver
# and the device nodes, and both can be passed through directly:
#
#   D=/usr/lib/x86_64-linux-gnu
#   docker run --rm \
#     --device /dev/nvidia0 --device /dev/nvidiactl \
#     --device /dev/nvidia-uvm --device /dev/nvidia-uvm-tools \
#     -v $D/libcuda.so.<VER>:$D/libcuda.so.1:ro \
#     -v $D/libcuda.so.<VER>:$D/libcuda.so:ro \
#     -v $D/libnvidia-ml.so.<VER>:$D/libnvidia-ml.so.1:ro \
#     -v $D/libnvidia-ptxjitcompiler.so.<VER>:$D/libnvidia-ptxjitcompiler.so.1:ro \
#     -e TRITON_LIBCUDA_PATH=$D \
#     --entrypoint bash graphmend-cuda -lc '...'
#
# BOTH libcuda mounts are required, and the second one is easy to miss. The
# versioned name is what the driver API resolves, so with only that,
# torch.cuda.is_available() returns True, the device is named correctly, and a
# matmul runs. Triton, which compiles the kernels Inductor emits, dlopens the
# UNVERSIONED libcuda.so, and without it every compile fails with
#
#     AssertionError: libcuda.so cannot found!
#
# So the device checks and the graph-break counts pass while every timing run
# dies, which is a confusing way to find out.
#
# <VER> is the host driver version, from `ls $D/libcuda.so.*`. Mounting a
# libcuda that does not match the loaded kernel driver fails at cuInit, so read
# it rather than copying a version from here.
#
# With the toolkit installed, `--gpus all` is simpler and equivalent.
# ============================================================================
#
# Intended use, from the REPOSITORY ROOT:
#
#   docker build -f artifact/Dockerfile.cuda -t graphmend-cuda .
#   docker run --rm --gpus all graphmend-cuda t5-small
#   docker run --rm --gpus all --entrypoint bash graphmend-cuda
#
# `--gpus all` needs the NVIDIA Container Toolkit on the host. Without it the
# daemon fails with `could not select device driver "" with capabilities:
# [[gpu]]`; use the device passthrough above instead, which needs no toolkit
# and no root.
#
# The break-elimination and correctness claims do not need a GPU at all. Use
# artifact/Dockerfile.cpu for those; it is smaller and needs no device setup.

# Same interpreter as the CPU image, and for a reason that is not cosmetic.
# The obvious base here is nvidia/cuda:*-runtime-ubuntu24.04, but Ubuntu 24.04
# ships Python 3.12 as python3, and the Jac toolchain's from-source path is
# exercised on 3.13. Picking the base image's interpreter would put the
# toolchain on an untested one to gain a system CUDA install that is redundant
# anyway: torch's cu126 wheels vendor their own CUDA runtime through the
# nvidia-* dependencies, and the kernel driver comes from the host via
# `--gpus all`. So the slim image plus the CUDA wheel is both smaller and the
# better-tested combination.
FROM python:3.13-slim

# Pinned for the same reason as the CPU image, and to the same version: the
# paper's torch 2.12, which is what every recorded row was measured on.
ARG TORCH_VERSION=2.12.1
ARG TORCHVISION_VERSION=0.27.1
# cu126 is the paper's CUDA 12.6.
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu126
ARG NUMPY_VERSION=2.4.6
ARG TRANSFORMERS_VERSION=4.52.4

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1 \
    XDG_CACHE_HOME=/opt/jac/cache

# Unlike the CPU image, this one needs a C++ compiler at RUN time, not just at
# build time. TorchInductor generates C++ host-side wrapper code for every
# compiled region and invokes the system compiler on it; without g++ the
# backend the latency claims are about cannot run at all. The CPU image omits
# this because it only ever counts graphs, which does not codegen.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates build-essential git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --index-url "${TORCH_INDEX}" \
        "torch==${TORCH_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}" \
        "numpy==${NUMPY_VERSION}"

RUN pip install "transformers==${TRANSFORMERS_VERSION}"

# The same opt-in model dependencies as the CPU image. stella-en-400M-v5 is
# the one row that needs a GPU to run at all, so unlike the CPU image this one
# does install xformers for it.
RUN pip install \
        "timm==1.0.28" \
        "einops==0.8.2" \
        "accelerate==1.14.0" \
        "pillow==12.1.1" \
        "chronos-forecasting==2.3.1" \
        "transformers-stream-generator==0.0.5" \
        "xformers==0.0.35"

# stella-en-400M-v5 uses its unpadding path only when xformers is importable.
RUN python -c "import xformers"

# Unlike the CPU image, this check must NOT assert cuda is None: here a CUDA
# build is the point. It does not assert a GPU is visible either, because
# `docker build` has no access to a device: that can only be checked at run
# time, and the header records the result of doing so.
RUN python -c "import torch, transformers; \
print('torch', torch.__version__, 'cuda:', torch.version.cuda); \
print('transformers', transformers.__version__); \
assert torch.version.cuda is not None, 'expected a CUDA wheel, got the CPU build'"

# The toolchain is not vendored in this repository: it is the pinned jaseci
# submodule plus patches/graphmend.patch. Copy the submodule checkout, the
# patch, the harness and the artifact package, then let setup.sh assemble them.
# The build context must therefore be a clone with submodules initialised:
#   git clone --recurse-submodules <url> && docker build -f artifact/Dockerfile.cpu .
COPY jac.toml   /opt/artifact/jac.toml
COPY jaseci     /opt/artifact/jaseci
COPY patches    /opt/artifact/patches
COPY scripts    /opt/artifact/scripts
COPY paper_eval /opt/artifact/paper_eval
COPY artifact   /opt/artifact/artifact

ENV PYTHONPATH=/opt/artifact/jaseci/jac:/opt/artifact

# Both steps are explained at length in artifact/Dockerfile.cpu, which carries
# the identical pair. In short: the typeshed stdlib stubs are gitignored and
# must be materialized or no Jac compile works, and the warm-up is a real
# `jac run` because it caches 162 modules where `--help` caches 31, and because
# it doubles as the build-time proof that the toolchain works in this image.
# setup.sh applies patches/graphmend.patch into the submodule and fetches the
# typeshed stubs. It verifies the submodule is at the pinned commit first, so a
# context built from the wrong checkout fails here with a clear message rather
# than much later with a missing pass.
RUN bash /opt/artifact/scripts/setup.sh

RUN cd /opt/artifact/jaseci/jac \
    && printf 'with entry { print("jac toolchain ok"); }\n' > /tmp/warm.jac \
    && python -m jaclang run /tmp/warm.jac \
    && rm -f /tmp/warm.jac \
    && test -d "$XDG_CACHE_HOME/jac/jir/bootstrap" \
    && test -d "$XDG_CACHE_HOME/jac/jir/modules" \
    && chmod -R a+rX /opt/jac/cache

WORKDIR /opt/artifact

# The benchmark takes model names, so `docker run ... graphmend-cuda t5-small`
# works and `--count` reports break counts instead of timings. It prints
# CUDA-graph launches per arm beside every number, which is the check that the
# transform actually fired: identical launch counts mean it did not.
ENTRYPOINT ["python", "/opt/artifact/artifact/gpu/bench.py"]
