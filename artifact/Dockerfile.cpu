# GraphMend CGO 2027 artifact: CPU image.
#
# Reproduces the break-elimination (Table 2 fix rate) and output-correctness
# claims. No GPU. The default run needs no network and downloads no weights.
#
# Build from the REPOSITORY ROOT, not from this directory:
#
#   docker build -f artifact/Dockerfile.cpu -t graphmend-cpu .
#   docker run --rm graphmend-cpu                     # kick-the-tires, PASS/FAIL
#   docker run --rm graphmend-cpu --quick             # shorter
#
# The entrypoint is run_all.sh and its arguments are passed through, so an
# interactive shell or another command needs --entrypoint:
#
#   docker run --rm -it --entrypoint bash graphmend-cpu
#
# The full 21-row offline sweep, which the default entrypoint does not run:
#   docker run --rm --entrypoint bash graphmend-cpu \
#     -lc 'cd /opt/jaseci/jac && python -m paper_eval.run_eval'
#
# The 6 network rows need network and a Hugging Face cache; mount one so a
# re-run does not re-download:
#   docker run --rm -v "$PWD/hf-cache:/hf" -e HF_HOME=/hf \
#     --entrypoint bash graphmend-cpu \
#     -lc 'cd /opt/jaseci/jac && python -m paper_eval.run_eval Florence-2'
#
# NOT VERIFIED: this image has never been built. The install recipe mirrors the
# repository's own `GraphMend Graph Counts` CI lane (CPU wheel index, pinned
# torch and numpy), but a clean build has not been done. See the "What we ran
# and what we did not" section of artifact/README.md.

# 3.13 is the Python the recorded results were measured on. The repository's
# packaging manifest floors the toolchain at 3.14 for the shipped binary; the
# from-source path used here runs on 3.13, which is what the measurements used,
# so 3.13 is what is pinned.
FROM python:3.13-slim

# PINNED, not floored. The claim is an exact graph count, and a Dynamo version
# change can move it: which regions Dynamo splits on is a property of the
# release, so a floor here would let a reviewer resolve a torch that reports
# different numbers and read that as a failed reproduction.
#
# 2.12.1 is the paper's torch 2.12, and is the version every row in
# artifact/RESULTS.md was measured on.
ARG TORCH_VERSION=2.12.1
# torchvision is not optional. The grounding-dino rows call
# `torchvision.ops.nms`, and a torchvision built against a different torch
# fails to register that operator -- which surfaces far from its cause, as
# `ModuleNotFoundError: PreTrainedModel` while transformers imports. 0.27.1 is
# the build paired with torch 2.12.1 and must move with it.
ARG TORCHVISION_VERSION=0.27.1
# torch warns on import without numpy, and parts of the suite run under
# `filterwarnings = error`, which turns that warning into cascading failures.
# 2.4.6 is the version the recorded measurements ran on. numpy does not
# participate in what Dynamo splits on, so the graph counts are not a function
# of it, but pinning what was measured keeps the image honest.
ARG NUMPY_VERSION=2.4.6
ARG TRANSFORMERS_VERSION=4.52.4

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1

# A fixed, HOME-independent cache root. The Jac compiler's own modules are
# compiled once into a content-keyed cache under $XDG_CACHE_HOME/jac/jir, and
# pinning it here means the warm-up below lands where every later container
# process looks, whatever uid or HOME the container runs as.
ENV XDG_CACHE_HOME=/opt/jac/cache

# bash for run_all.sh; the slim image has it, this only makes it explicit and
# adds nothing else. No compiler toolchain is needed: torch, numpy,
# transformers and their dependencies all ship manylinux wheels for cp313.
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# PyPI's torch bundles the multi-GB CUDA stack. This index serves the CPU
# build, which is what the CPU claims need and is roughly a tenth of the size.
# Installed in its own step so the transformers dependency closure still
# resolves against PyPI.
RUN pip install --index-url https://download.pytorch.org/whl/cpu \
        "torch==${TORCH_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}" \
        "numpy==${NUMPY_VERSION}"

RUN pip install "transformers==${TRANSFORMERS_VERSION}"

# The six NETWORK_MODELS rows in jac/paper_eval/registry.py are opt-in: the
# default entrypoint never runs them, because they download code or weights.
# Their dependencies are installed anyway, so that a reviewer who does opt in
# gets a download rather than a traceback. Each line names the row that needs
# it. Versions are the ones the recorded measurements ran on.
#
# stella-en-400M-v5 is the exception and is deliberately absent: it needs
# xformers, which has no CPU build worth shipping. It is also the paper's one
# 0%-fixed row, so the CPU image cannot reproduce it and does not pretend to.
RUN pip install \
        "timm==1.0.28" \
        "einops==0.8.2" \
        "accelerate==1.14.0" \
        "pillow==12.1.1" \
        "chronos-forecasting==2.3.1" \
        "transformers-stream-generator==0.0.5"

# Prove the index pin held: a CPU wheel reports cuda None. A CUDA build here
# would still run, and would make the image ten times larger for nothing.
RUN python -c "import torch, transformers; \
print('torch', torch.__version__, 'cuda:', torch.version.cuda); \
print('transformers', transformers.__version__); \
assert torch.version.cuda is None, 'expected the CPU wheel'"

# The toolchain is used from source, on PYTHONPATH. It declares no runtime
# PyPI dependencies, so there is nothing to pip install for it, and there is no
# Python packaging backend to `pip install -e` against: the repository's
# manifest is jac.toml and the shipped binary is built with Zig, which this
# image deliberately does not do.
#
# jac.toml at the repo root carries [dev] jaclang_source = "jac", which reroutes
# `import jaclang` to the in-tree source. It is copied for that reason and for
# its [test] paths.
COPY jac.toml /opt/jaseci/jac.toml
COPY jac /opt/jaseci/jac
COPY artifact /opt/jaseci/artifact

ENV PYTHONPATH=/opt/jaseci/jac

# Materialize the typeshed stdlib stubs. Without this the image builds fine and
# then fails at RUN time on the first real compile, because type inference is on
# the critical path of every Jac compilation and `jaclang/vendor/typeshed/stdlib`
# is gitignored -- a fresh clone does not have it. See the script's header.
#
# This needs network at build time. It is the only step that does, and it is
# checksum-pinned against the repository's own TARBALL_SHA256.
#
# A checkout that already carries the stubs short-circuits it with no download.
# A checkout that symlinks them at a shared tree (which is what a git worktree
# tends to do) copies a link into the image that dangles, and this replaces it.
RUN python /opt/jaseci/artifact/fetch_typeshed.py /opt/jaseci/jac

# Warm the compiler cache at build time. The first jac command on a cold cache
# compiles the Jac compiler's own .jac sources into $XDG_CACHE_HOME/jac/jir,
# which is a cost a reviewer would otherwise pay at first run.
#
# The warm-up is a real `jac run` of a real program, and that is deliberate on
# two counts. `python -m jaclang --help` only takes the bootstrap path and
# caches 31 modules, where compiling an actual program caches 162 -- warming
# with --help leaves the container recompiling the CLI, the test runner and the
# pass pipeline on its first command. And a real run exercises the full compile
# schedule, so it is also the build-time proof that the toolchain WORKS in this
# image: the missing-typeshed failure above was invisible to every cheaper
# check and surfaced only here.
#
# Not `--version`: the toolchain is on PYTHONPATH rather than pip-installed, so
# it has no distribution metadata, and `--version` resolves its number through
# importlib.metadata and dies with PackageNotFoundError.
#
# The `test -d` guards keep a warm-up that silently wrote nothing from passing.
RUN cd /opt/jaseci/jac \
    && printf 'with entry { print("jac toolchain ok"); }\n' > /tmp/warm.jac \
    && python -m jaclang run /tmp/warm.jac \
    && rm -f /tmp/warm.jac \
    && test -d "$XDG_CACHE_HOME/jac/jir/bootstrap" \
    && test -d "$XDG_CACHE_HOME/jac/jir/modules" \
    && chmod -R a+rX /opt/jac/cache

WORKDIR /opt/jaseci

# Default: the kick-the-tires path. Extra arguments are passed through, so
# `docker run --rm graphmend-cpu --quick` works.
ENTRYPOINT ["bash", "/opt/jaseci/artifact/run_all.sh"]
