+returns a 0-dim tensor, so predicating these turns an int, a bool or a float
+into a tensor for every non-tensor consumer (f-string, dict value, `is`, a
+plain-Python API); all three shapes must decline. A scalar operand inside a
+tensor expression is unaffected: `b * -1` is still a tensor."""
+import torch;
+
+@torch.compile()
+def f(x: any) -> any {
+    if (x.sum() > 0) {
+        n = 1;
+    } else {
+        n = 2;
+    }
+    return f"count {n}";
+}
+
+@torch.compile()
+def g(x: any) -> any {
+    if (x.sum() > 0) {
+        ok = True;
+    } else {
+        ok = False;
+    }
+    return {"ok": ok};
+}
+
+@torch.compile()
+def h(x: any) -> any {
+    if (x.sum() > 0) {
+        return -1;
+    } else {
+        return 0.5;
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_unsafe_setup.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_unsafe_setup.jac
new file mode 100644
index 0000000..a57aff6
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/where_unsafe_setup.jac
@@ -0,0 +1,21 @@
+"""Soundness: a data-dependent branch whose setup performs a non-idempotent,
+observable write (incrementing an attribute counter) before the shared trailing
+call. Hoisting that write to run on BOTH paths would change observable state, so
+GraphMend must DECLINE -- the break is left intact rather than unsoundly
+predicated. Contrast with where_multi_stmt.jac, whose setups are licensed
+(existence-guarded init + idempotent device move)."""
+import torch;
+
+@torch.compile()
+def f(self_obj: any, position_ids: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if (seq_len > 8) {
+        self_obj.calls = self_obj.calls + 1;
+        self_obj.register_buffer("inv_freq", self_obj.long_inv_freq, persistent=False);
+    } else {
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_unused_device_move.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_unused_device_move.jac
