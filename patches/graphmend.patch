@@ -0,0 +1,13 @@
+"""Data-dependent control flow: both branches return -> torch.where."""
+import torch;
+
+@torch.compile()
+def with_breaks(a: any, b: any) -> any {
+    x = a / (torch.abs(a) + 1);
+    b = x * 1.414;
+    if (b.sum() < 0) {
+        return x * (b * -1);
+    } else {
+        return x * (b * -2);
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_scalar_branch.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_scalar_branch.jac
