+    # it to an effectful function; the binding is the proof, not the name.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "a device move whose consumers all normalize first is licensed" {
+    src = _pysrc("where_device_move_shared.jac", True);
+    # The other function's first mention of the attribute is the same
+    # normalizing move, so no consumer can observe the hoisted placement.
+    assert "register_buffer('inv_freq', torch.where(" in src;
+    assert "if seq_len > 8:" not in src;
+}
+
+test "a normalization that does not dominate its reads is declined" {
+    src = _pysrc("where_conditional_normalizer.jac", True);
+    # `peek` normalizes only under a flag; the read outside that branch can
+    # observe the hoisted placement. Textual order is not dominance.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "a device move with a raw reader elsewhere is declined" {
+    src = _pysrc("where_raw_consumer.jac", True);
+    # `peek` reads the attribute without normalizing, so it can observe the
+    # placement change on originally-untaken executions.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "a device move whose target the region never consumes is declined" {
+    src = _pysrc("where_unused_device_move.jac", True);
+    # The move license exists to put a value consumed by the merged call on
+    # the right device; an unconsumed target is a bare attribute mutation.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "a twice-called helper is a diamond, not a cycle, and stays licensed" {
+    src = _pysrc("guard_diamond_init.jac", True);
+    # The sub-helper is proven once per call site (floor and ceil bounds);
+    # only a helper still on the recursion stack declines. The initializer
+    # also exercises floor/ceil and a tensor method on a local call's result.
+    assert "register_buffer('inv_freq', torch.where(" in src;
+    assert "if seq_len > 8:" not in src;
+}
+
+test "py source: a guard-imported torch root still proves" {
+    # Model code imports torch behind an availability guard, which leaves the
+    # name without a symbol binding; the proof falls back to the module's
+    # plain import statement, and module-level rebinding still declines.
+    src = _compile_path_of_py(PY_GUARDED_IMPORT_SRC, "py_guarded_import.py");
+    assert "register_buffer('inv_freq', torch.where(" in src;
+    assert "if seq_len > 8:" not in src;
+}
+
+test "a recursive initializer helper is declined" {
+    src = _pysrc("guard_recursive_init.jac", True);
+    # Each helper body is clean, but the call graph has a cycle; termination
+    # of the speculated call is unprovable, so the hoist declines.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "an initializer helper that writes an attribute is declined" {
+    src = _pysrc("guard_helper_write.jac", True);
+    # The helper neither raises nor calls anything impure, but it assigns
+    # `config.cache`; purity covers writes too, so the hoist declines.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "an initializer helper that deletes an attribute is declined" {
+    src = _pysrc("guard_helper_delete.jac", True);
+    # A delete is a write the assignment walk cannot see, so it needs its own
+    # check; without one the helper reads as pure and the hoist proceeds.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "config read proven by a constructor invariant licenses the hoist" {
+    src = _pysrc("guard_config_get.jac", True);
+    # `config.rope_scaling.get("factor")` is on no purity list; the fact pass
+    # proves it from RopeConfig's constructor, which raises unless the
+    # attribute is a dict. The receiver type comes from the call-site
+    # argument's annotation, not from the callee's declared parameter.
+    assert "register_buffer('inv_freq', torch.where(" in src;
+    assert "if seq_len > 8:" not in src;
+}
+
+test "a constructor invariant one import away is materialized and proves" {
+    src = _pysrc("where_config_import.jac", True);
+    # RopeConfig lives in a sibling module: the query follows the import and
+    # compiles that module's AST into the hub on demand, then reads the
+    # invariant from it.
+    assert "register_buffer('inv_freq', torch.where(" in src;
+    assert "if seq_len > 8:" not in src;
+}
+
+test "config read without the constructor invariant is declined" {
+    src = _pysrc("guard_config_get_unproven.jac", True);
+    # LooseConfig never validates rope_scaling, so `.get` stays opaque: the
+    # same shape could be a session object doing I/O. Must decline.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "existence-guarded init calling a tensor-named method on an opaque receiver is declined" {
+    src = _pysrc("guard_opaque_method_init.jac", True);
+    # `config.store.clone()` matches the pure-tensor-method name list, but the
+    # receiver is not a pure call, so nothing proves the method is a no-op.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "existence-guarded init calling an effectful torch API is declined" {
+    src = _pysrc("guard_torch_effect_init.jac", True);
+    # `torch.save` is rooted at torch but writes a file; purity is decided by
+    # the checked pure-op list, not by the root module.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "hasattr guard whose key is not the memoized attribute is declined" {
+    src = _pysrc("guard_key_mismatch.jac", True);
+    # The `hasattr` header does not close over `counter`/`long_inv_freq`, so the
+    # body is not idempotent: matching the guard *shape* alone would hoist a
+    # non-idempotent write onto the untaken path. Must decline.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+    assert "self_obj.counter = self_obj.counter + 1" in src;
+}
+
+test "hasattr guard body with extra observable effects is declined" {
+    src = _pysrc("guard_body_effects.jac", True);
+    # Key matches the memoized write, but the body also mutates `self_obj.log`;
+    # that effect would fire on runs the original never took. Must decline.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+    assert "self_obj.log.append('init')" in src;
+}
+
+test "hasattr-initialized attribute read outside the region is declined" {
+    src = _pysrc("guard_attr_escapes.jac", True);
+    # Hoisting creates `long_inv_freq` earlier than the original would; another
+    # reader in the module can observe that, so the state change is not
+    # confined and the hoist is declined.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "a call paired with a literal branch value is declined" {
+    src = _pysrc("call_vs_literal.jac", True);
+    # torch.where would speculate the call onto the untaken path; torch.cond
+    # cannot return the float. Neither is sound, so the branch stays.
+    assert "torch.where(" not in src;
+    assert "torch.cond(" not in src;
+    assert "if x.sum() > 0:" in src;
+    assert "__gm_true_0 = side_effecting" not in src;
+}
+
+test "provably non-tensor branch values are declined" {
+    src = _pysrc("where_nontensor_branch.jac", True);
+    # torch.where cannot select a string or a container: rewriting would trade
+    # a working conditional for a runtime TypeError, so both shapes decline.
+    assert "torch.where(" not in src;
+    assert "torch.cond(" not in src;
+    assert "y = 'big'" in src;
+    assert "return [x, 1]" in src;
+    assert "dyn_ctrl_fl" in _break_kinds("where_nontensor_branch.jac");
+}
+
+test "scalar literal branch values are declined" {
+    src = _pysrc("where_scalar_branch.jac", True);
+    # torch.where returns a 0-dim tensor, so predicating an int, a float or a
+    # bool branch changes the variable's type for every non-tensor consumer.
+    assert "torch.where(" not in src;
+    assert "torch.cond(" not in src;
+    assert "n = 1" in src;
+    assert "ok = True" in src;
+    assert "return -1" in src;
+    assert "dyn_ctrl_fl" in _break_kinds("where_scalar_branch.jac");
+}
+
+test "a scalar inside a tensor expression still predicates" {
+    # The decline is about the branch VALUE being a scalar, not about a scalar
+    # appearing anywhere in it: `x * (b * -1)` is a tensor.
+    src = _pysrc("where_return.jac", True);
+    assert "torch.where(" in src;
+}
+
+test "existence-guarded init with an impure initializer is declined" {
+    src = _pysrc("guard_impure_init.jac", True);
+    # The attribute callee cannot be pinned to one table entry, so every
+    # signature-compatible candidate must be pure; `_compute_dirty` prints, so
+    # speculating the init could emit output on runs the original never made.
+    assert "torch.where(" not in src;
+    assert "if seq_len > 8:" in src;
+}
+
+test "nested guard in a data-dependent branch composes trap + predication" {
+    src = _pysrc("nested_guard_in_branch.jac", True);
+    # the data-dependent outer branch is predicated...
+    assert "__gm_cond_0 = x.sum() > 0" in src;
+    assert "out.copy_(torch.where(__gm_cond_0," in src;
+    # ...and the inner validation guard is lowered to a graph-native assert,
+    # re-gated on the branch predicate so it only fires when the branch is taken.
+    assert "torch._assert_async(" in src;
+    # the gate is plain logical_or: trap lowering only fires on a receiver
+    # proven to be a tensor, so the check needs no coercion.
+    assert ("torch.logical_or(torch.logical_not(__gm_cond_0), (x == y).all())" in src);
+    # no raw control flow / raise survives -- one contiguous graph.
+    assert "raise ValueError" not in src;
+    assert "if x.sum()" not in src;
+    assert "if not (x == y)" not in src;
+}
+
+test "nested-compound break preserved when graphmend disabled" {
+    src = _pysrc("nested_guard_in_branch.jac", False);
+    assert "torch.where(" not in src;
+    assert "torch._assert_async(" not in src;
+    assert "raise ValueError('x and y must match')" in src;
+    assert "if not (x == y).all():" in src;
+}
+
+test "control flow preserved when graphmend disabled" {
+    src = _pysrc("where_return.jac", False);
+    assert "torch.where(" not in src;
+    assert "if " in src;
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_default.jac b/jac/tests/compiler/passes/test_graphmend_default.jac
new file mode 100644
index 0000000..24472b2
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_default.jac
@@ -0,0 +1,512 @@
+"""GraphMend engages by default on torch-importing modules; others stay byte-identical."""
+import os;
+import from pathlib { Path }
+import from tempfile { TemporaryDirectory }
+import from tests.support {
+    GRAPHMEND_FIXTURES as FIXTURES,
+    code_mentions_symbol as _mentions_symbol,
+    graphmend_compile_opts as _compile
+}
+import from jaclang.compiler.driver.program { JacProgram }
+import from jaclang.compiler.driver.compile_options { CompileOptions }
+import from jaclang.compiler.driver.jir { get_module_cache_path }
+import from jaclang.project.config { JacConfig }
+import jaclang.project.config as config_mod;
+
+glob TORCH_MAIN = "import torch;\n\n"
+         + "@torch.compile()\n"
+         + "def f(x: any, mask: torch.Tensor) -> any {\n"
+         + "    x = torch.relu(x);\n"
+         + "    if not mask.all() {\n"
+         + "        raise ValueError(\"mask must be all true\");\n"
+         + "    }\n"
+         + "    return torch.sin(x) * 2.0;\n"
+         + "}\n",
+     PLAIN_HELPER = "def triple(x: int) -> int {\n"
+         + "    if x > 0 {\n"
+         + "        print(\"positive\");\n"
+         + "        return x * 3;\n"
+         + "    }\n"
+         + "    return x;\n"
+         + "}\n";
+
+glob CLAIMED_NET_SRC = '''
+import torch
+
+
+class Net(torch.nn.Module):
+    def forward(self, x):
+        print("in-forward")
+        return torch.relu(x)
+''';
+
+"""Drop any installed GraphMend loader patch; return what was there."""
+def _unhook_loader -> any {
+    import from importlib.machinery { SourceFileLoader }
+    prev = SourceFileLoader.__dict__.get("get_code");
+    if prev is not None {
+        delattr(SourceFileLoader, "get_code");
+    }
+    if "_jac_graphmend_hooked" in SourceFileLoader.__dict__ {
+        delattr(SourceFileLoader, "_jac_graphmend_hooked");
+    }
+    return prev;
+}
+
+"""Put back a patch `_unhook_loader` removed."""
+def _rehook_loader(prev: any) {
+    import from importlib.machinery { SourceFileLoader }
+    if prev is not None {
+        setattr(SourceFileLoader, "get_code", prev);
+        setattr(SourceFileLoader, "_jac_graphmend_hooked", True);
+    }
+}
+
+"""Create a temp project with a jac.toml, a torch entry, and a plain helper."""
+def _mk_gm_project(tmp: str) -> tuple[str, str] {
+    with open(os.path.join(tmp, "jac.toml"), "w") as fh {
+        fh.write(
+            "[project]\nname = \"gmdefault\"\nversion = \"0.1.0\"\n"
+                + "entry-point = \"main.jac\"\n"
+        );
+    }
+    main_path = os.path.join(tmp, "main.jac");
+    with open(main_path, "w") as fh {
+        fh.write(TORCH_MAIN);
+    }
+    helper_path = os.path.join(tmp, "helper.jac");
+    with open(helper_path, "w") as fh {
+        fh.write(PLAIN_HELPER);
+    }
+    return (main_path, helper_path);
+}
+
+test "the graphmend gate is open by default at every layer that carries it" {
+    assert CompileOptions().graphmend is True;
+    assert JacConfig.from_toml_str("[project]\nname = \"p\"\n").run.graphmend is True;
+    assert JacConfig.from_toml_str("[run]\nmain = true\n").run.graphmend is True;
+    assert JacConfig.from_toml_str("[run]\ngraphmend = false\n").run.graphmend is False;
+}
+
+test "default compile options transform a torch module" {
+    target = os.path.join(FIXTURES, "val_guard_all.jac");
+    (src_default, _bc) = _compile(target, CompileOptions());
+    (src_off, _bc2) = _compile(target, CompileOptions(graphmend=False));
+    assert src_default != src_off;
+    assert "torch._assert_async(" in src_default;
+    assert "raise ValueError" not in src_default;
+}
+
+test "default compile options leave a torch-free module identical to off" {
+    target = os.path.join(FIXTURES, "no_torch_plain.jac");
+    (src_default, bc_default) = _compile(target, CompileOptions());
+    (src_off, bc_off) = _compile(target, CompileOptions(graphmend=False));
+    assert src_default == src_off;
+    assert bc_default == bc_off;
+}
+
+test "run graphmend in jac toml is the off switch without a cli flag" {
+    import from jaclang.runtime.runtime { JacRuntime as Jac }
+    import jaclang.cli.commands.execution as execution;
+    old_config = config_mod._config;
+    try {
+        config_mod._config = JacConfig.from_toml_str("[run]\nmain = true\n");
+        assert execution._apply_graphmend("") is True;
+        assert CompileOptions().graphmend is True;
+        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
+        assert execution._apply_graphmend("") is False;
+        assert CompileOptions().graphmend is False;
+        config_mod._config = JacConfig.from_toml_str("[project]\nname = \"p\"\n");
+        assert execution._apply_graphmend(" trap ") is True;
+        assert CompileOptions().graphmend is True;
+        assert CompileOptions().graphmend_disable == ["trap"] , (
+            "the cli flag must reach the carrier every entry point reads"
+        );
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+test "a run with no torch leaves the stdlib loader untouched" {
+    # The loader hook patches a stdlib class method, so it may only go in where
+    # GraphMend can actually claim something: a run that never loads PyTorch
+    # must leave SourceFileLoader exactly as it found it.
+    import sys;
+    import from importlib.machinery { SourceFileLoader }
+    import from jaclang.runtime.runtime { JacRuntime as Jac }
+    import jaclang.cli.commands.execution as execution;
+    old_config = config_mod._config;
+    prev_hook = _unhook_loader();
+    saved_torch = sys.modules.pop("torch", None);
+    before = SourceFileLoader.__dict__.get("get_code");
+    try {
+        config_mod._config = JacConfig.from_toml_str("[run]\nmain = true\n");
+        assert execution._apply_graphmend("") is True;
+        assert SourceFileLoader.__dict__.get("get_code") is before , (
+            "a torch-free run must not patch SourceFileLoader.get_code"
+        );
+        assert not getattr(SourceFileLoader, "_jac_graphmend_hooked", False) , (
+            "a torch-free run must not mark the stdlib loader as hooked"
+        );
+    } finally {
+        if saved_torch is not None {
+            sys.modules["torch"] = saved_torch;
+        }
+        _unhook_loader();
+        _rehook_loader(prev_hook);
+        config_mod._config = old_config;
+    }
+}
+
+test "torch entering the process installs the hook only under the opt in" {
+    # torch is the first moment a claim can be granted, so that import is the
+    # install point; but claiming imported code is its own consent, so with
+    # [run] graphmend_claim_imports unset even torch leaves the class alone.
+    import sys;
+    import from importlib.machinery { SourceFileLoader }
+    import from jaclang.meta_importer { JacMetaImporter }
+    old_config = config_mod._config;
+    prev_hook = _unhook_loader();
+    saved_torch = sys.modules.pop("torch", None);
+    try {
+        config_mod._config = JacConfig.from_toml_str(
+            "[run]\ngraphmend_claim_imports = true\n"
+        );
+        JacMetaImporter().find_spec("json.decoder", None);
+        assert not getattr(SourceFileLoader, "_jac_graphmend_hooked", False) , (
+            "an unrelated import must not install the hook"
+        );
+        JacMetaImporter().find_spec("torch", None);
+        assert getattr(SourceFileLoader, "_jac_graphmend_hooked", False) , (
+            "importing torch under the opt-in must install the hook"
+        );
+        _unhook_loader();
+        config_mod._config = JacConfig.from_toml_str("[run]\nmain = true\n");
+        JacMetaImporter().find_spec("torch", None);
+        assert not getattr(SourceFileLoader, "_jac_graphmend_hooked", False) , (
+            "without the claim-imports opt-in torch must not install the hook"
+        );
+        config_mod._config = JacConfig.from_toml_str(
+            "[run]\ngraphmend = false\ngraphmend_claim_imports = true\n"
+        );
+        JacMetaImporter().find_spec("torch", None);
+        assert not getattr(SourceFileLoader, "_jac_graphmend_hooked", False) , (
+            "an off run must stay unpatched even under torch"
+        );
+    } finally {
+        if saved_torch is not None {
+            sys.modules["torch"] = saved_torch;
+        }
+        _unhook_loader();
+        _rehook_loader(prev_hook);
+        config_mod._config = old_config;
+    }
+}
+
+test "the loader hook transforms a claimed py loaded from a file location" {
+    # A spec built straight from a file location never reaches a meta-path
+    # finder, so the hook on SourceFileLoader.get_code is its only interception
+    # point; a registered claim plus the claim-imports opt-in is enough, with
+    # no torch in the process.
+    import importlib.util;
+    import sys;
+    import from jaclang.runtime.runtime { JacRuntime as Jac }
+    import from jaclang.meta_importer { install_graphmend_loader_hook }
+    prog = Jac.get_program();
+    old_config = config_mod._config;
+    prev_hook = _unhook_loader();
+    saved_torch = sys.modules.pop("torch", None);
+    with TemporaryDirectory() as tmpdir {
+        path = os.path.join(tmpdir, "claimed_net.py");
+        with open(path, "w") as fh {
+            fh.write(CLAIMED_NET_SRC);
+        }
+        real = os.path.realpath(path);
+        try {
+            config_mod._config = JacConfig.from_toml_str(
+                "[run]\ngraphmend_claim_imports = true\n"
+            );
+            prog.graphmend_claimed.add(real);
+            install_graphmend_loader_hook();
+            spec = importlib.util.spec_from_file_location("claimed_net", path);
+            assert spec is not None;
+            spec_loader: any = spec.loader;
+            assert spec_loader is not None;
+            code = spec_loader.get_code("claimed_net");
+            assert code is not None;
+            assert _mentions_symbol(code, "__jac_se_emit__") , (
+                "a claimed .py loaded by file location was not transformed"
+            );
+        } finally {
+            if saved_torch is not None {
+                sys.modules["torch"] = saved_torch;
+            }
+            prog.graphmend_claimed.discard(real);
+            _unhook_loader();
+            _rehook_loader(prev_hook);
+            config_mod._config = old_config;
+        }
+    }
+}
+
+test "a graphmend compile is cached and a same-config recompile hits" {
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, helper_path) = _mk_gm_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_a = JacProgram();
+            code_a = prog_a.get_bytecode(main_path);
+            assert code_a is not None;
+            assert prog_a.mod.hub , "first compile should not be a cache hit";
+            assert _mentions_symbol(code_a, "_assert_async");
+            assert get_module_cache_path(main_path).exists() , (
+                "a graphmend-active compile must write the bytecode cache"
+            );
+            prog_b = JacProgram();
+            code_b = prog_b.get_bytecode(main_path);
+            assert code_b is not None;
+            assert not prog_b.mod.hub , (
+                "a same-config recompile must hit the cache, not recompile"
+            );
+            assert _mentions_symbol(code_b, "_assert_async");
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+test "flipping the graphmend configuration misses the cached variant" {
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, helper_path) = _mk_gm_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_a = JacProgram();
+            code_a = prog_a.get_bytecode(main_path);
+            assert code_a is not None and _mentions_symbol(code_a, "_assert_async");
+            config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
+            prog_off = JacProgram();
+            code_off = prog_off.get_bytecode(main_path);
+            assert prog_off.mod.hub , (
+                "an off run must not reuse the graphmend-on artifact"
+            );
+            assert not _mentions_symbol(code_off, "_assert_async");
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_on = JacProgram();
+            code_on = prog_on.get_bytecode(main_path);
+            assert prog_on.mod.hub , (
+                "a default run must not reuse the graphmend-off artifact"
+            );
+            assert _mentions_symbol(code_on, "_assert_async");
+            cfg_dis = JacConfig.load(Path(tmpdir) / "jac.toml");
+            cfg_dis.run.graphmend_disable = "trap";
+            config_mod._config = cfg_dis;
+            prog_dis = JacProgram();
+            code_dis = prog_dis.get_bytecode(main_path);
+            assert prog_dis.mod.hub , (
+                "a disable-list flip must invalidate the cached variant"
+            );
+            assert not _mentions_symbol(code_dis, "_assert_async");
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+test "an open gate shares the cache artifact with off for a torch-free module" {
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, helper_path) = _mk_gm_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_a = JacProgram();
+            code_a = prog_a.get_bytecode(helper_path);
+            assert code_a is not None;
+            assert prog_a.mod.hub;
+            config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
+            prog_off = JacProgram();
+            code_off = prog_off.get_bytecode(helper_path);
+            assert code_off is not None;
+            assert not prog_off.mod.hub , (
+                "a gate resolving to off must share the explicit-off artifact"
+            );
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+test "a compile with no cli run command honors run graphmend false" {
+    # The serve, test, build and library paths reach get_bytecode without ever
+    # passing through the cli run command, so the config alone must gate them.
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, helper_path) = _mk_gm_project(tmpdir);
+            config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
+            code = JacProgram().get_bytecode(main_path);
+            assert code is not None;
+            assert not _mentions_symbol(code, "_assert_async") , (
+                "a compile outside the cli run path ignored run graphmend false"
+            );
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+glob RACE_PLAIN = "def spin(x: int) -> int {\n"
+         + "    if x > 0 {\n        return x + 1;\n    }\n    return x;\n}\n";
+
+glob _RACE_ORIG: list[any] = [],
+     _RACE_GATE: dict[str, any] = {},
+     _RACE_DONE: dict[str, any] = {};
+
+"""Stand in for JacCompiler.compile so a gated path can park mid-compile."""
+def _race_compile_hook(
+    self: any,
+    file_path: str,
+    target_program: any,
+    use_str: any = None,
+    options: any = None
+) -> any {
+    gate = _RACE_GATE.get(os.path.realpath(file_path));
+    if gate is not None {
+        gate[0].set();
+        gate[1].`wait(60);
+        if gate[2] {
+            raise RuntimeError("compile blew up mid-flight");
+        }
+    }
+    orig = _RACE_ORIG[0];
+    if options is None {
+        return orig(self, file_path, target_program, use_str);
+    }
+    return orig(self, file_path, target_program, use_str, options);
+}
+
+def _install_race_hook {
+    import from jaclang.compiler.driver.compiler { JacCompiler }
+    _RACE_ORIG.append(JacCompiler.compile);
+    JacCompiler.compile = _race_compile_hook;
+}
+
+def _remove_race_hook {
+    import from jaclang.compiler.driver.compiler { JacCompiler }
+    JacCompiler.compile = _RACE_ORIG.pop();
+    _RACE_GATE.clear();
+    _RACE_DONE.clear();
+}
+
+"""The ambient GraphMend cache variant this thread would compile under."""
+def _ambient_variant -> str {
+    import from jaclang.compiler.driver.jir { swap_graphmend_cache_variant }
+    seen = swap_graphmend_cache_variant("");
+    swap_graphmend_cache_variant(seen);
+    return seen;
+}
+
+"""Compile one module on its own thread; nothing shared crosses the boundary."""
+def _race_worker(path: str) -> any {
+    prog = JacProgram();
+    try {
+        return prog.get_bytecode(path);
+    } finally {
+        done = _RACE_DONE.get(os.path.realpath(path));
+        if done is not None {
+            done.set();
+        }
+    }
+}
+
+test "concurrent compiles under different settings keep their own cache key" {
+    import threading;
+    old_config = config_mod._config;
+    _install_race_hook();
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, helper_path) = _mk_gm_project(tmpdir);
+            plain_path = os.path.join(tmpdir, "plain.jac");
+            with open(plain_path, "w") as fh {
+                fh.write(RACE_PLAIN);
+            }
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            (engaged_in, off_in, engaged_done) = (
+                threading.Event(),
+                threading.Event(),
+                threading.Event()
+            );
+            _RACE_GATE[os.path.realpath(main_path)] = (engaged_in, off_in, False);
+            _RACE_GATE[os.path.realpath(plain_path)] = (off_in, engaged_done, False);
+            _RACE_DONE[os.path.realpath(main_path)] = engaged_done;
+            engaged = flow _race_worker(main_path) ;
+            assert engaged_in.`wait(60) , "the engaged compile never started";
+            plain_arg = str(plain_path);
+            plain = flow _race_worker(plain_arg) ;
+            code_on = wait engaged ;
+            code_plain = wait plain ;
+            left_behind = _ambient_variant();
+            assert code_on is not None and code_plain is not None;
+            assert _mentions_symbol(code_on, "_assert_async");
+            config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
+            prog_after = JacProgram();
+            code_after = prog_after.get_bytecode(main_path);
+            assert code_after is not None;
+            assert prog_after.mod.hub , (
+                "an off run was served the artifact of a concurrent engaged compile"
+            );
+            assert not _mentions_symbol(code_after, "_assert_async");
+            assert left_behind == "" , (
+                "a finished compile left its cache variant on the next compile"
+            );
+        }
+    } finally {
+        _remove_race_hook();
+        config_mod._config = old_config;
+    }
+}
+
+test "a compile that raises leaves no cache variant behind" {
+    import threading;
+    old_config = config_mod._config;
+    _install_race_hook();
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, helper_path) = _mk_gm_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            gate = threading.Event();
+            gate.set();
+            _RACE_GATE[os.path.realpath(main_path)] = (threading.Event(), gate, True);
+            raised = False;
+            try {
+                JacProgram().get_bytecode(main_path);
+            } except RuntimeError {
+                raised = True;
+            }
+            assert raised , "the gated compile should have raised";
+            assert _ambient_variant() == "" , (
+                "a failed compile left its cache variant behind"
+            );
+        }
+    } finally {
+        _remove_race_hook();
+        config_mod._config = old_config;
+    }
+}
+
+test "the run manifest drops the graphmend and scope flags but keeps disable" {
+    import from jaclang.cli.manifest { get_command_meta }
+    meta = get_command_meta("run");
+    assert meta is not None;
+    by_name = {a.name: a for a in meta.args};
+    assert "graphmend" not in by_name;
+    assert "graphmend_scope" not in by_name;
+    assert by_name["graphmend_disable"].config_key == "run.graphmend_disable";
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_defer_integration.jac b/jac/tests/compiler/passes/test_graphmend_defer_integration.jac
new file mode 100644
index 0000000..109be36
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_defer_integration.jac
@@ -0,0 +1,324 @@
+"""Torch-gated: deferral collapses the split forward pass back to one FX graph."""
+import builtins;
+import contextlib;
+import io;
+import logging;
+import os;
+import tempfile;
+import from tests.support {
+    GRAPHMEND_FIXTURES as FIXTURES,
+    graphmend_compile_path as _compile_path
+}
+
+"""nn.Module logger models, written to temp files at test time rather than
+checked in as .py fixtures: the repository does not accept new Python files.
+The logger call sits inside `forward` (a traced region) and the model is
+wrapped at a call site (`model = torch.compile(Net())`), so the slot-registry
+mechanism plus the injected forward hooks are what preserve the log."""
+glob PY_FORWARD_HOOK_SRC = '''
+import logging
+
+import torch
+
+logger = logging.getLogger("gm_forward_hook")
+
+
+class Net(torch.nn.Module):
+    def forward(self, x):
+        x = torch.relu(x)
+        logger.warning("GM-FORWARD-HOOK-LOG")
+        return torch.sin(x) * 2.0
+
+
+model = torch.compile(Net())
+''',
+     PY_FORWARD_HOOK_RAISES_SRC = '''
+import logging
+
+import torch
+
+logger = logging.getLogger("gm_forward_hook_raises")
+
+
+class Net(torch.nn.Module):
+    def forward(self, x):
+        x = torch.relu(x)
+        logger.warning("GM-RAISING-FORWARD-LOG")
+        raise ValueError("GM-BOOM")
+
+
+model = torch.compile(Net())
+''';
+
+"""Import torch or skip the calling test."""
+def _torch -> any {
+    try {
+        import torch;
+        return torch;
+    } except ImportError {
+        testskip("torch not installed");
+    }
+}
+
+"""Compile a generated .py model source and return its Python lowering."""
+def _py_model_src(py_src: str, name: str, gm: bool) -> str {
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, name);
+        with open(path, "w") as fh {
+            fh.write(py_src);
+        }
+        return _compile_path(path, gm);
+    }
+}
+
+"""Exec generated Python with @torch.compile rebound to identity, so the
+caller can drive the raw function/model through a backend itself."""
+def _exec_src(src: str, label: str) -> dict {
+    torch = _torch();
+    ns: dict = {};
+    orig_compile = torch.compile;
+    def _shim(*a: any, **k: any) -> any {
+        if a {
+            return a[0];
+        }
+        def _wrap(f: any) -> any {
+            return f;
+        }
+        return _wrap;
+    }
+    torch.compile = _shim;
+    try {
+        exec(compile(src, label, "exec"), ns);
+    } finally {
+        torch.compile = orig_compile;
+    }
+    return ns;
+}
+
+"""Count the contiguous graphs the backend receives for one call of `target`."""
+def _count_graphs_of(target: any, args: tuple) -> int {
+    torch = _torch();
+    graphs: list = [];
+    def _backend(gm: any, inputs: any) -> any {
+        graphs.append(gm);
+        return gm.forward;
+    }
+    torch._dynamo.reset();
+    torch.compile(target, backend=_backend)(*args);
+    return len(graphs);
+}
+
+"""Compile a .jac fixture, exec it, and count graphs for one call of fn_name."""
+def _count_graphs(fixture: str, gm: bool, fn_name: str, args: tuple) -> int {
+    src = _compile_path(os.path.join(FIXTURES, fixture), gm);
+    ns = _exec_src(src, fixture);
+    return _count_graphs_of(ns[fn_name], args);
+}
+
+test "side-effect calls defragment to one contiguous graph" {
+    # side_effect.jac doubles as the guard-cost check: the prepended
+    # @__jac_se_guard__ boundary must not itself split the graph.
+    torch = _torch();
+    x = torch.tensor([1.0, 2.0, 3.0]);
+    for fixture in [
+        "side_effect.jac",
+        "side_effect_logger.jac",
+        "side_effect_clone.jac"
+    ] {
+        orig = _count_graphs(fixture, False, "f", (x, ));
+        fixed = _count_graphs(fixture, True, "f", (x, ));
+        assert orig >= 2 , f"{fixture}: expected >=2 graphs without GraphMend, got {orig}";
+        assert fixed == 1 , f"{fixture}: expected 1 graph with GraphMend, got {fixed}";
+    }
+}
+
+test "buffered arg is snapshotted against later in-place mutation" {
+    # relu([1,2,3]) = [1,2,3]; the fixture then adds 100 in place. The clone at
+    # the call site means the flushed print still reports the pre-mutation
+    # value, not [101,102,103].
+    torch = _torch();
+    src = _compile_path(os.path.join(FIXTURES, "side_effect_clone.jac"), True);
+    ns = _exec_src(src, "side_effect_clone.jac");
+    buf = io.StringIO();
+    torch._dynamo.reset();
+    with contextlib.redirect_stdout(buf) {
+        _count_graphs_of(ns["f"], (torch.tensor([1.0, 2.0, 3.0]), ));
+    }
+    out = buf.getvalue();
+    assert "snap:" in out , f"deferred print did not run: {repr(out)}";
+    assert "101" not in out , f"deferred print saw the post-mutation value: {repr(
+        out
+    )}";
+    assert "1., 2., 3." in out , f"deferred print lost the snapshot value: {repr(out)}";
+}
+
+test "deferred print flushes on the exceptional exit" {
+    # Deferral moves WHEN the print is emitted; an exit that never reaches the
+    # in-function flush would lose it. The @__jac_se_guard__ boundary sits above
+    # @torch.compile, so its finally runs on the raising path too.
+    torch = _torch();
+    def _run(gm: bool) -> tuple {
+        src = _compile_path(os.path.join(FIXTURES, "side_effect_raises.jac"), gm);
+        ns = _exec_src(src, "side_effect_raises.jac");
+        printed: list = [];
+        real_print = builtins.print;
+        def _capture(*a: any, **k: any) {
+            printed.append(" ".join([str(v) for v in a]));
+        }
+        builtins.print = _capture;
+        caught: any = None;
+        try {
+            torch._dynamo.reset();
+            try {
+                ns["f"](torch.tensor([1.0, 2.0]));
+            } except Exception as exc {
+                caught = exc;
+            }
+        } finally {
+            builtins.print = real_print;
+        }
+        return (printed, caught);
+    }
+    (orig_out, orig_exc) = _run(False);
+    assert any(["GM-SE-BEFORE-RAISE" in line for line in orig_out]);
+    assert isinstance(orig_exc, ValueError) and ("GM-SE-BOOM" in str(orig_exc));
+    (fixed_out, fixed_exc) = _run(True);
+    assert isinstance(fixed_exc, ValueError) , f"expected ValueError, got {repr(
+        fixed_exc
+    )}";
+    assert "GM-SE-BOOM" in str(fixed_exc);
+    assert any(["GM-SE-BEFORE-RAISE" in line for line in fixed_out]) , (
+        "deferred print was lost on the exceptional exit -- the __jac_se_guard__ "
+        "boundary must flush the global buffer in its finally"
+    );
+}
+
+"""Run a generated logger model; return (graph_count, captured log messages)."""
+def _run_model(py_src: str, name: str, logger_name: str, gm: bool) -> tuple {
+    torch = _torch();
+    src = _py_model_src(py_src, name, gm);
+    ns = _exec_src(src, name);
+    messages: list = [];
+    class _Capture(logging.Handler) {
+        def emit(self: any, record: any) {
+            messages.append(record.getMessage());
+        }
+    }
+    handler = _Capture();
+    logging.getLogger(logger_name).addHandler(handler);
+    try {
+        count = _count_graphs_of(ns["model"], (torch.tensor([1.0, 2.0, 3.0]), ));
+    } finally {
+        logging.getLogger(logger_name).removeHandler(handler);
+    }
+    return (count, messages);
+}
+
+test "logger forward hook defragments and preserves the log" {
+    _torch();
+    (orig_graphs, orig_msgs) = _run_model(
+        PY_FORWARD_HOOK_SRC, "logger_forward_hook.py", "gm_forward_hook", False
+    );
+    (fixed_graphs, fixed_msgs) = _run_model(
+        PY_FORWARD_HOOK_SRC, "logger_forward_hook.py", "gm_forward_hook", True
+    );
+    assert orig_graphs >= 2 , f"expected a break without GraphMend, got {orig_graphs}";
+    assert fixed_graphs == 1 , f"expected one graph with GraphMend, got {fixed_graphs}";
+    # The log is preserved: replayed by the injected forward hook after the graph.
+    assert "GM-FORWARD-HOOK-LOG" in fixed_msgs , "logger output was lost";
+    assert "GM-FORWARD-HOOK-LOG" in orig_msgs;
+}
+
+test "the flush hook is registered with always_call=True" {
+    # Without it the flush runs only on a successful forward, so a raising
+    # forward drops every buffered logger call. Asserted on the generated source
+    # so the guarantee is visible even where torch's hook semantics are not
+    # exercised.
+    _torch();
+    src = _py_model_src(PY_FORWARD_HOOK_SRC, "logger_forward_hook.py", True);
+    assert "register_forward_hook(__jac_log_flush_hook__, always_call=True)" in src;
+    # The registrations are guarded: a call-site wrap of a plain function has
+    # no hook methods, so unguarded registration would crash the import.
+    assert "if hasattr(model, 'register_forward_pre_hook'):" in src;
+}
+
+test "a function wrapped at a call site does not crash on hook injection" {
+    # `fast = torch.compile(fn)` is a legitimate entry shape; the injected hook
+    # registrations must be hasattr-guarded because a compiled function has no
+    # register_forward_pre_hook. The buffered print falls back to immediate
+    # emission (region depth 0: no guard opens a region for this shape).
+    torch = _torch();
+    py_src = '''
+import torch
+
+
+def fn(x):
+    x = torch.relu(x)
+    print("GM-FN-WRAP-PRINT")
+    return torch.sin(x)
+
+
+fast = torch.compile(fn)
+''';
+    src = _py_model_src(py_src, "fn_wrap.py", True);
+    ns = _exec_src(src, "fn_wrap.py");
+    printed: list = [];
+    real_print = builtins.print;
+    def _capture(*a: any, **k: any) {
+        printed.append(" ".join([str(v) for v in a]));
+    }
+    builtins.print = _capture;
+    try {
+        out = ns["fast"](torch.tensor([1.0, 2.0]));
+    } finally {
+        builtins.print = real_print;
+    }
+    assert any(["GM-FN-WRAP-PRINT" in line for line in printed]) , (
+        "print output was lost for a call-site-wrapped function"
+    );
+    assert out is not None;
+}
+
+test "deferred logger flushes when the forward raises" {
+    # A plain forward hook only runs on a successful return; always_call=True is
+    # what replays the buffered log before the exception propagates.
+    torch = _torch();
+    def _run(gm: bool) -> tuple {
+        src = _py_model_src(
+            PY_FORWARD_HOOK_RAISES_SRC, "logger_forward_hook_raises.py", gm
+        );
+        ns = _exec_src(src, "logger_forward_hook_raises.py");
+        messages: list = [];
+        class _Capture(logging.Handler) {
+            def emit(self: any, record: any) {
+                messages.append(record.getMessage());
+            }
+        }
+        handler = _Capture();
+        logging.getLogger("gm_forward_hook_raises").addHandler(handler);
+        caught: any = None;
+        try {
+            torch._dynamo.reset();
+            try {
+                torch.compile(ns["model"], backend="eager")(torch.tensor([1.0, 2.0]));
+            } except Exception as exc {
+                caught = exc;
+            }
+        } finally {
+            logging.getLogger("gm_forward_hook_raises").removeHandler(handler);
+        }
+        return (messages, caught);
+    }
+    (orig_msgs, orig_exc) = _run(False);
+    assert "GM-RAISING-FORWARD-LOG" in orig_msgs;
+    assert isinstance(orig_exc, ValueError) and ("GM-BOOM" in str(orig_exc));
+    (fixed_msgs, fixed_exc) = _run(True);
+    assert isinstance(fixed_exc, ValueError) , f"expected ValueError, got {repr(
+        fixed_exc
+    )}";
+    assert "GM-BOOM" in str(fixed_exc);
+    assert "GM-RAISING-FORWARD-LOG" in fixed_msgs , (
+        "deferred logger output was lost on the exceptional exit -- the flush "
+        "hook must be registered with always_call=True"
+    );
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_facts_scope.jac b/jac/tests/compiler/passes/test_graphmend_facts_scope.jac
new file mode 100644
index 0000000..aac8a74
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_facts_scope.jac
@@ -0,0 +1,237 @@
+"""Per-compilation GraphMend facts: they live on the compiled module's gen."""
+import ast;
+import os;
+import jaclang.compiler.frontend.unitree as uni;
+import from tests.support { GRAPHMEND_FIXTURES as FIXTURES }
+import from jaclang.compiler.driver.compile_options { CompileOptions }
+import from jaclang.compiler.driver.compiler { JacCompiler }
+import from jaclang.compiler.driver.program { JacProgram }
+import from jaclang.compiler.passes.graphmend.graph_break_detect_pass {
+    GraphBreakDetectPass
+}
+
+"""Compile a fixture with graphmend on under a fresh program and return the
+compiled module; its facts are read straight off `mod.gen`."""
+def _compile_gm(name: str) -> any {
+    return JacProgram().compile(
+        file_path=os.path.join(FIXTURES, name), options=CompileOptions(graphmend=True)
+    );
+}
+
+"""Unparse a compiled module's generated Python source."""
+def _unparse(mod: any) -> str {
+    pa = mod.gen.py_ast;
+    mod_ast: any = pa[0] if isinstance(pa, list) else pa;
+    return ast.unparse(mod_ast);
+}
+
+"""Find the single top-level ability named `f` in a compiled module."""
+def _entry_ability(mod: any) -> uni.Ability {
+    found: (uni.Ability | None) = None;
+    for ab in mod.get_all_sub_nodes(uni.Ability) {
+        if ab.sym_name == 'f' {
+            found = ab;
+        }
+    }
+    assert found is not None;
+    return found;
+}
+
+test "an interleaved compile does not clobber the in-flight break table" {
+    # Splits the codegen schedule after detection and runs a second graphmend
+    # compile on the same program, the shape of concurrent language-server
+    # compiles; the outer compile's guard must still lower.
+    prog = JacProgram();
+    orig: any = JacCompiler.run_schedule;
+    state = {"interleaved": False};
+    def _spy(
+        self: any, mod: any, target_program: any, passes: any, cancel_token: any = None
+    ) {
+        is_entry = str(mod.loc.mod_path).endswith("val_guard.jac");
+        if state["interleaved"]
+            or (GraphBreakDetectPass not in passes)
+            or not is_entry {
+            orig(self, mod, target_program, passes, cancel_token);
+            return;
+        }
+        state["interleaved"] = True;
+        i = passes.index(GraphBreakDetectPass);
+        orig(self, mod, target_program, passes[:i + 1], cancel_token);
+        target_program.get_bytecode(os.path.join(FIXTURES, "side_effect.jac"));
+        orig(self, mod, target_program, passes[i + 1:], cancel_token);
+    }
+    JacCompiler.run_schedule = _spy;
+    try {
+        mod = prog.compile(
+            file_path=os.path.join(FIXTURES, "val_guard.jac"),
+            options=CompileOptions(graphmend=True)
+        );
+    } finally {
+        JacCompiler.run_schedule = orig;
+    }
+    assert state["interleaved"] , "the interleaved compile never ran";
+    src = _unparse(mod);
+    assert "__jac_tensor_eq_assert__" in src , (
+        "the interleaved compile wiped the outer break table"
+    );
+}
+
+test "an interleaved compile records its facts on its own module" {
+    prog = JacProgram();
+    orig: any = JacCompiler.run_schedule;
+    state = {"interleaved": False};
+    def _spy(
+        self: any, mod: any, target_program: any, passes: any, cancel_token: any = None
+    ) {
+        is_entry = str(mod.loc.mod_path).endswith("val_guard.jac");
+        if state["interleaved"]
+            or (GraphBreakDetectPass not in passes)
+            or not is_entry {
+            orig(self, mod, target_program, passes, cancel_token);
+            return;
+        }
+        state["interleaved"] = True;
+        i = passes.index(GraphBreakDetectPass);
+        orig(self, mod, target_program, passes[:i + 1], cancel_token);
+        # compile() rather than get_bytecode(): a bytecode-cache hit would skip
+        # the passes entirely and leave nothing to observe on the inner module
+        target_program.compile(
+            file_path=os.path.join(FIXTURES, "side_effect.jac"),
+            options=CompileOptions(graphmend=True)
+        );
+        orig(self, mod, target_program, passes[i + 1:], cancel_token);
+    }
+    JacCompiler.run_schedule = _spy;
+    try {
+        mod = prog.compile(
+            file_path=os.path.join(FIXTURES, "val_guard.jac"),
+            options=CompileOptions(graphmend=True)
+        );
+    } finally {
+        JacCompiler.run_schedule = orig;
+    }
+    assert state["interleaved"] , "the interleaved compile never ran";
+    facts = mod.gen.graphmend_facts;
+    assert facts is not None , "the outer compile left no facts on its module";
+    kinds = [k.value for k in facts.breaks.values()];
+    assert "val_guard" in kinds;
+    assert "side_effect" not in kinds , (
+        "the interleaved compile leaked its facts onto the outer module"
+    );
+    side_mod: any = None;
+    for (path, m) in prog.mod.hub.items() {
+        if str(path).endswith("side_effect.jac") {
+            side_mod = m;
+        }
+    }
+    assert side_mod is not None , "the interleaved module never reached the hub";
+    side_facts = side_mod.gen.graphmend_facts;
+    assert side_facts is not None , "the interleaved compile left no facts";
+    side_kinds = [k.value for k in side_facts.breaks.values()];
+    assert "side_effect" in side_kinds , (
+        "the interleaved compile's facts did not land on its own module"
+    );
+}
+
+test "boundary entries key on nodes and helpers collapse to a set" {
+    import from jaclang.compiler.frontend.constant { GraphMendHelper }
+    mod = _compile_gm("val_guard.jac");
+    facts = mod.gen.graphmend_facts;
+    assert facts is not None , "the compile left no facts on the module";
+    assert facts.boundary , "the compile seeded no boundary entries";
+    for (k, v) in facts.boundary.items() {
+        assert isinstance(k, uni.Ability) , (
+            "boundary entries are keyed by a recyclable address, not by node"
+        );
+        assert isinstance(v, uni.Ability);
+    }
+    assert facts.helpers , "the compile recorded no helper needs";
+    assert isinstance(facts.helpers, set) , (
+        "helpers regrew a module-keyed map instead of the per-module set"
+    );
+    for h in facts.helpers {
+        assert isinstance(h, GraphMendHelper);
+    }
+    seed = _entry_ability(mod);
+    assert facts.boundary.get(seed) is seed , (
+        "the compiled entry does not resolve to itself by node identity"
+    );
+}
+
+test "a distinct node with an equal shape does not resolve in the boundary" {
+    mod_a = _compile_gm("val_guard.jac");
+    mod_b = _compile_gm("val_guard.jac");
+    twin = _entry_ability(mod_b);
+    facts_a = mod_a.gen.graphmend_facts;
+    facts_b = mod_b.gen.graphmend_facts;
+    assert facts_b is not None;
+    assert facts_b.boundary.get(twin) is twin;
+    assert facts_a is not None;
+    assert facts_a.boundary.get(twin) is None , (
+        "a boundary lookup resolved a node the compile never saw"
+    );
+}
+
+test "facts live on the compiled module and not in a process-wide context" {
+    import jaclang.compiler.frontend.codeinfo as codeinfo;
+    mod = _compile_gm("val_guard.jac");
+    assert mod.gen.graphmend_facts is not None , (
+        "the facts are not reachable from the unit that was compiled"
+    );
+    for hook in [
+        "swap_graphmend_facts",
+        "installed_graphmend_facts",
+        "current_graphmend_facts",
+        "_graphmend_facts_ctx"
+    ] {
+        assert not hasattr(codeinfo, hook) , (
+            f"codeinfo still exposes the context-variable hook {hook}"
+        );
+    }
+}
+
+test "a module outside every compiled region records itself as a noop" {
+    mod = _compile_gm("region_no_compile.jac");
+    facts = mod.gen.graphmend_facts;
+    assert facts is not None , "detection left no facts on the module";
+    assert facts.noop is True , (
+        "a module with no compiled region did not record the noop fact"
+    );
+    active = _compile_gm("val_guard.jac");
+    active_facts = active.gen.graphmend_facts;
+    assert active_facts is not None;
+    assert active_facts.noop is False , (
+        "a module with a compiled region recorded itself as a noop"
+    );
+}
+
+test "a recompile after invalidation starts from fresh facts" {
+    prog = JacProgram();
+    opts = CompileOptions(graphmend=True);
+    path = os.path.join(FIXTURES, "val_guard.jac");
+    mod_1 = prog.compile(file_path=path, options=opts);
+    facts_1 = mod_1.gen.graphmend_facts;
+    assert facts_1 is not None;
+    assert facts_1.breaks;
+    hub_key: any = None;
+    for p in prog.mod.hub.keys() {
+        if str(p).endswith("val_guard.jac") {
+            hub_key = p;
+        }
+    }
+    assert hub_key is not None;
+    prog.invalidate_module(hub_key);
+    mod_2 = prog.compile(file_path=path, options=CompileOptions(graphmend=True));
+    assert mod_2 is not mod_1 , "the recompile reused the stale module object";
+    facts_2 = mod_2.gen.graphmend_facts;
+    assert facts_2 is not None;
+    assert facts_2 is not facts_1 , (
+        "the recompiled module inherited the previous compile's facts"
+    );
+    stale_ids = {id(k) for k in facts_1.breaks};
+    for k in facts_2.breaks {
+        assert id(k) not in stale_ids , (
+            "the fresh facts carry a node from the invalidated parse"
+        );
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_import_integration.jac b/jac/tests/compiler/passes/test_graphmend_import_integration.jac
new file mode 100644
index 0000000..f332a2f
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_import_integration.jac
@@ -0,0 +1,171 @@
+"""Torch-gated: an imported .py module that seeds GraphMend is claimed at
+import time under the [run] graphmend_claim_imports opt-in, runs its
+transformed bytecode, and still raises its original exception. Skipped when
+PyTorch is absent."""
+import ast;
+import dis;
+import importlib;
+import os;
+import sys;
+import tempfile;
+import from jaclang.compiler.driver.program { JacProgram }
+import from jaclang.compiler.driver.compile_options { CompileOptions }
+
+glob PY_CLAIMED_NET_SRC = '''
+import torch
+
+
+class Net(torch.nn.Module):
+    def forward(self, x):
+        x = torch.relu(x)
+        if x.sum() > 0:
+            return x * 2.0
+        else:
+            return x * 3.0
+''';
+
+"""Import torch or skip the calling test."""
+def _torch -> any {
+    try {
+        import torch;
+        return torch;
+    } except ImportError {
+        testskip("torch not installed");
+    }
+}
+
+"""Lay out a one-module package under `tmp` and put it on sys.path."""
+def _mk_pkg(tmp: str, src: str) {
+    pkg = os.path.join(tmp, "claimedmodel");
+    os.mkdir(pkg);
+    with open(os.path.join(pkg, "__init__.py"), "w") as fh {
+        fh.write("");
+    }
+    with open(os.path.join(pkg, "net.py"), "w") as fh {
+        fh.write(src);
+    }
+}
+
+test "an imported model package is claimed and transformed under the opt in" {
+    # No local torch.compile: the module is claimed because it seeds GraphMend
+    # on its own, once [run] graphmend_claim_imports grants consent for
+    # imported code.
+    torch = _torch();
+    import from jaclang.project.config { JacConfig }
+    import jaclang.project.config as config_mod;
+    old_config = config_mod._config;
+    with tempfile.TemporaryDirectory() as tmp {
+        _mk_pkg(tmp, PY_CLAIMED_NET_SRC);
+        sys.path.insert(0, tmp);
+        try {
+            config_mod._config = JacConfig.from_toml_str(
+                "[run]\ngraphmend_claim_imports = true\n"
+            );
+            sys.modules.pop("claimedmodel", None);
+            sys.modules.pop("claimedmodel.net", None);
+            net = importlib.import_module("claimedmodel.net");
+            names = [
+                i.argval
+                for i in dis.get_instructions(net.Net.forward.__code__)
+                if isinstance(i.argval, str)
+            ];
+            assert "where" in names , "imported model module was not transformed";
+            # torch itself must be unaffected
+            assert hasattr(torch, "_dynamo");
+        } finally {
+            config_mod._config = old_config;
+            sys.path.remove(tmp);
+            sys.modules.pop("claimedmodel", None);
+            sys.modules.pop("claimedmodel.net", None);
+        }
+    }
+}
+
+glob PY_GUARDED_NET_SRC = '''
+import torch
+
+
+class Net(torch.nn.Module):
+    def forward(self, x, mask):
+        x = torch.relu(x)
+        if not mask.all():
+            raise ValueError("mask must be all true")
+        return torch.sin(x)
+''',
+     PY_GUARD_ENTRY_SRC = '''
+import torch
+
+from claimedmodel.net import Net
+
+model = torch.compile(Net())
+''';
+
+test "a claimed guard raises the original exception through the boundary" {
+    # The entry's call site gets `model = __jac_trap_guard__(model)`, which
+    # wraps `forward` in place on the instance. A failing guard must surface as
+    # the original ValueError, and the good path must compute normally.
+    torch = _torch();
+    import from jaclang.project.config { JacConfig }
+    import jaclang.project.config as config_mod;
+    old_config = config_mod._config;
+    with tempfile.TemporaryDirectory() as tmp {
+        _mk_pkg(tmp, PY_GUARDED_NET_SRC);
+        entry_path = os.path.join(tmp, "entry.py");
+        with open(entry_path, "w") as fh {
+            fh.write(PY_GUARD_ENTRY_SRC);
+        }
+        eprog = JacProgram();
+        emod = eprog.compile(
+            file_path=entry_path, options=CompileOptions(graphmend=True)
+        );
+        pa = emod.gen.py_ast;
+        mod_ast: any = pa[0] if isinstance(pa, list) else pa;
+        entry_src = ast.unparse(mod_ast);
+        assert "model = __jac_trap_guard__(model)" in entry_src;
+        sys.path.insert(0, tmp);
+        ns: dict = {};
+        orig_compile = torch.compile;
+        def _shim(*a: any, **k: any) -> any {
+            if a {
+                return a[0];
+            }
+            def _wrap(f: any) -> any {
+                return f;
+            }
+            return _wrap;
+        }
+        torch.compile = _shim;
+        try {
+            config_mod._config = JacConfig.from_toml_str(
+                "[run]\ngraphmend_claim_imports = true\n"
+            );
+            sys.modules.pop("claimedmodel", None);
+            sys.modules.pop("claimedmodel.net", None);
+            exec(compile(entry_src, "entry.py", "exec"), ns);
+            x = torch.tensor([1.0, 2.0, 3.0]);
+            good = torch.tensor([True, True, True]);
+            bad = torch.tensor([True, False, True]);
+            out = ns["model"](x, good);
+            assert torch.allclose(out, torch.sin(torch.relu(x)));
+            raised: any = None;
+            try {
+                ns["model"](x, bad);
+            } except BaseException as e {
+                raised = e;
+            }
+            assert type(raised) is ValueError , f"expected ValueError, got {repr(
+                raised
+            )}";
+            assert str(raised) == "mask must be all true" , (
+                f"message lost: {repr(raised)}"
+            );
+            assert "GM-TRAP" not in str(raised) , "internal trap marker leaked";
+        } finally {
+            torch.compile = orig_compile;
+            config_mod._config = old_config;
+            sys.path.remove(tmp);
+            sys.modules.pop("claimedmodel", None);
+            sys.modules.pop("claimedmodel.net", None);
+        }
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_py_support.jac b/jac/tests/compiler/passes/test_graphmend_py_support.jac
new file mode 100644
index 0000000..8e38d13
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_py_support.jac
@@ -0,0 +1,500 @@
+"""Entry-point resolution and claiming on plain Python source."""
+import ast;
+import os;
+import tempfile;
+import from tests.support { GRAPHMEND_FIXTURES as FIXTURES }
+import from jaclang.compiler.driver.program { JacProgram }
+import from jaclang.compiler.driver.compile_options { CompileOptions }
+
+"""A Python model wrapped at a call site through a variable, written to a temp
+file at test time rather than checked in as a .py fixture: the repository does
+not accept new Python files, and the point of the fixture is only that
+GraphMend ingests .py source, which a generated file exercises just as well."""
+glob PY_CALLSITE_SRC = '''
+import torch
+
+
+class MyModel(torch.nn.Module):
+    def forward(self, x):
+        x = torch.relu(x)
+        if x.sum() > 0:
+            return x * 2.0
+        else:
+            return x * 3.0
+
+
+model = MyModel()
+compiled = torch.compile(model)
+''';
+
+"""Write the generated .py model to a temp file, compile it, and return its
+generated Python source."""
+def _pysrc(gm: bool) -> str {
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, "py_callsite_module.py");
+        with open(path, "w") as fh {
+            fh.write(PY_CALLSITE_SRC);
+        }
+        prog = JacProgram();
+        mod = prog.compile(file_path=path, options=CompileOptions(graphmend=gm));
+        pa = mod.gen.py_ast;
+        mod_ast: any = pa[0] if isinstance(pa, list) else pa;
+        return ast.unparse(mod_ast);
+    }
+}
+
+"""Compile a checked-in fixture and return its generated Python source."""
+def _fixture_src(name: str) -> str {
+    prog = JacProgram();
+    mod = prog.compile(
+        file_path=os.path.join(FIXTURES, name), options=CompileOptions(graphmend=True)
+    );
+    pa = mod.gen.py_ast;
+    mod_ast: any = pa[0] if isinstance(pa, list) else pa;
+    return ast.unparse(mod_ast);
+}
+
+test "py: torch.compile(model) call site tags the wrapped class methods" {
+    # The entry point is the call site (resolved through `model = MyModel()`),
+    # not a decorator; the undecorated forward method's data-dependent branch
+    # must still be rewritten.
+    src = _pysrc(True);
+    assert "torch.where(" in src;
+    assert "if x.sum() > 0" not in src;
+}
+
+test "py: call-site wrapped model untouched when graphmend disabled" {
+    src = _pysrc(False);
+    assert "torch.where(" not in src;
+    assert "if x.sum() > 0" in src;
+}
+
+test "a helper defers to the caller's region instead of flushing" {
+    # Dynamo inlines the helper into the decorated entry's graph, so the
+    # reachability closure covers it: the helper's print buffers and only the
+    # entry drains it. A flush at the helper's return would split the graph
+    # from the inside.
+    src = _fixture_src("se_in_helper.jac");
+    # the helper buffers...
+    assert "__jac_se_emit__(print," in src;
+    # ...but emits NO flush of its own -- that would split the caller's graph
+    assert "__jac_se_flush__()" not in src;
+    # ...and the compiled entry carries the guard that drains it, even though
+    # the entry holds no side-effect call itself.
+    assert "@__jac_se_guard__" in src;
+    assert src.index("@__jac_se_guard__") < src.index("@torch.compile");
+}
+
+"""Compile a generated .py the way an imported model module is compiled: no
+local torch.compile, seeded by its proven Module forwards."""
+def _py_model_src(py_src: str, name: str) -> str {
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, name);
+        with open(path, "w") as fh {
+            fh.write(py_src);
+        }
+        prog = JacProgram();
+        mod = prog.compile(file_path=path, options=CompileOptions(graphmend=True));
+        pa = mod.gen.py_ast;
+        mod_ast: any = pa[0] if isinstance(pa, list) else pa;
+        return ast.unparse(mod_ast);
+    }
+}
+
+glob PY_MODEL_GUARD_SRC = '''
+import torch
+
+
+class Net(torch.nn.Module):
+    def forward(self, x, mask: torch.Tensor):
+        x = torch.relu(x)
+        if not mask.all():
+            raise ValueError("mask must be all true")
+        return torch.sin(x)
+''',
+     PY_WRAPPED_GUARD_SRC = '''
+import torch
+
+
+class Net(torch.nn.Module):
+    def forward(self, x, mask: torch.Tensor):
+        x = torch.relu(x)
+        if not mask.all():
+            raise ValueError("mask must be all true")
+        return torch.sin(x)
+
+
+model = torch.compile(Net())
+''';
+
+test "a validation guard with no boundary in reach is declined" {
+    # No decorated function and no call-site wrap, so nothing would decode the
+    # marker.
+    src = _py_model_src(PY_MODEL_GUARD_SRC, "model_guard.py");
+    assert "torch._assert_async(" not in src;
+    assert "raise ValueError('mask must be all true')" in src;
+}
+
+test "a validation guard lowers behind the call-site wrap boundary" {
+    # The boundary is the call site, not the method: a decorator on `forward`
+    # would sit inside the compiled callable and never see the async assert.
+    src = _py_model_src(PY_WRAPPED_GUARD_SRC, "wrapped_guard.py");
+    assert (
+        "torch._assert_async(mask.all(), "
+        "'[[GM-TRAP ValueError]]mask must be all true[[/GM-TRAP]]')"
+        in src
+    );
+    assert "raise ValueError" not in src;
+    assert "@__jac_trap_guard__" not in src;
+    assert "model = __jac_trap_guard__(model)" in src;
+}
+
+glob PY_ENTRY_WRAP_SRC = '''
+import torch
+
+
+class Net(torch.nn.Module):
+    def forward(self, x):
+        return torch.relu(x)
+
+
+model = torch.compile(Net())
+''';
+
+test "the entry wrap gets the trap boundary attach" {
+    # Every torch.compile call-site assignment gets the boundary attached; for
+    # a torch Module the runtime wraps `forward` in place, so an async assert
+    # failure from any guard the compiled call reaches is restored to its
+    # original exception at the outermost eager frame.
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, "entry_wrap.py");
+        with open(path, "w") as fh {
+            fh.write(PY_ENTRY_WRAP_SRC);
+        }
+        prog = JacProgram();
+        mod = prog.compile(file_path=path, options=CompileOptions(graphmend=True));
+        pa = mod.gen.py_ast;
+        mod_ast: any = pa[0] if isinstance(pa, list) else pa;
+        src = ast.unparse(mod_ast);
+    }
+    assert "model = __jac_trap_guard__(model)" in src;
+    # the helper import must be emitted by the preamble
+    assert any(
+        [
+            ("from jaclang" in line) and ("__jac_trap_guard__" in line)
+            for line in src.splitlines()
+        ]
+    );
+}
+
+"""A discriminant validation guard from a real model file (Apache-2.0),
+vendored against upstream drift. The message is a literal because formatting a
+tensor inside the graph would itself force a break."""
+glob PY_DISCRIMINANT_GUARD_SRC = '''
+import torch
+
+
+def rational_quadratic_spline_root(a: torch.Tensor, b: torch.Tensor, c: torch.Tensor):
+    discriminant = b.pow(2) - 4 * a * c
+    if not (discriminant >= 0).all():
+        raise RuntimeError("invalid discriminant in rational quadratic spline")
+    return (2 * c) / (-b - torch.sqrt(discriminant))
+
+
+class Spline(torch.nn.Module):
+    def forward(self, a, b, c):
+        return rational_quadratic_spline_root(a, b, c)
+
+
+model = torch.compile(Spline())
+''',
+     PY_DISCRIMINANT_GUARD_FSTRING_SRC = '''
+import torch
+
+
+def rational_quadratic_spline_root(a: torch.Tensor, b: torch.Tensor, c: torch.Tensor):
+    discriminant = b.pow(2) - 4 * a * c
+    if not (discriminant >= 0).all():
+        raise RuntimeError(f"invalid discriminant {discriminant}")
+    return (2 * c) / (-b - torch.sqrt(discriminant))
+
+
+class Spline(torch.nn.Module):
+    def forward(self, a, b, c):
+        return rational_quadratic_spline_root(a, b, c)
+
+
+model = torch.compile(Spline())
+''';
+
+test "the real discriminant guard shape lowers under a literal message" {
+    src = _py_model_src(PY_DISCRIMINANT_GUARD_SRC, "discriminant_guard.py");
+    assert (
+        "torch._assert_async((discriminant >= 0).all(), "
+        "'[[GM-TRAP RuntimeError]]invalid discriminant in rational quadratic "
+        "spline[[/GM-TRAP]]')"
+        in src
+    );
+    assert "if not (discriminant >= 0).all():" not in src;
+}
+
+test "a guard with a non-literal message is declined" {
+    # The verbatim upstream form carries an f-string message; folding it into
+    # the assert would evaluate the tensor format on every call inside the
+    # graph, so the lowering declines and the break is left intact.
+    src = _py_model_src(
+        PY_DISCRIMINANT_GUARD_FSTRING_SRC, "discriminant_guard_fstring.py"
+    );
+    assert "torch._assert_async(" not in src;
+    assert "if not (discriminant >= 0).all():" in src;
+}
+
+glob PY_MODEL_MIXED_SRC = '''
+import torch
+
+
+def reachable_helper(x):
+    print("IN-HELPER", x)
+    return x * 2
+
+
+def unreachable_util(x):
+    print("UTIL", x)
+    if x.sum() > 0:
+        y = x * 2
+    else:
+        y = x * 3
+    return y
+
+
+class Net(torch.nn.Module):
+    def forward(self, x):
+        return reachable_helper(torch.relu(x))
+''';
+
+test "only forward-reachable code is transformed" {
+    # The compiled region is the reachability closure over the call graph
+    # (what Dynamo would inline), not the whole module: a utility no forward
+    # reaches keeps its print and its data-dependent branch untouched.
+    src = _py_model_src(PY_MODEL_MIXED_SRC, "model_mixed.py");
+    assert "__jac_se_emit__(print," in src;
+    assert "print('UTIL', x)" in src;
+    assert "torch.where(" not in src;
+}
+
+"""The decorated forward is replaced at class-definition time by the
+decorator's `wrapper` closure, so the closure, not the decorated body, is what
+runs under torch.compile."""
+glob PY_MODEL_DECORATOR_SRC = '''
+import torch
+from functools import wraps
+
+
+def dynamic_update(rope_forward):
+
+    @wraps(rope_forward)
+    def wrapper(self, x):
+        if x.sum() > 0:
+            y = x * 2.0
+        else:
+            y = x * 3.0
+        return rope_forward(self, y)
+    return wrapper
+
+
+class Net(torch.nn.Module):
+    @dynamic_update
+    def forward(self, x):
+        return torch.relu(x)
+''';
+
+test "a decorator's wrapper closure is analyzed and transformed" {
+    # The module has a forward, so the whole-module fallback stays off and the
+    # closure is reachable ONLY through the decorator edge: forward's decorator
+    # resolves to `dynamic_update`, whose nested closures join the region.
+    src = _py_model_src(PY_MODEL_DECORATOR_SRC, "model_decorator.py");
+    assert "torch.where(" in src;
+    assert "if x.sum() > 0" not in src;
+}
+
+"""The wrapper calls a SIBLING closure that holds the break; resolving it
+needs lexical scope, since a module-level lookup cannot see it."""
+glob PY_MODEL_SIBLING_SRC = '''
+import torch
+
+
+def dynamic_update(rope_forward):
+
+    def frequency_update(self, x):
+        if x.sum() > 0:
+            y = x * 2.0
+        else:
+            y = x * 3.0
+        return y
+
+    def wrapper(self, x):
+        x = frequency_update(self, x)
+        return rope_forward(self, x)
+    return wrapper
+
+
+class Net(torch.nn.Module):
+    @dynamic_update
+    def forward(self, x):
+        return torch.relu(x)
+''';
+
+test "a wrapper's sibling closure is reached through lexical scope" {
+    # Only `wrapper` is enqueued from the decorator (it is the one that invokes
+    # the decorated function); the break lives one call deeper in a sibling
+    # closure, which resolves only by walking enclosing function scopes.
+    src = _py_model_src(PY_MODEL_SIBLING_SRC, "model_sibling.py");
+    assert "torch.where(" in src;
+    assert "if x.sum() > 0" not in src;
+}
+
+"""A decorator that rewrites metadata and returns the ORIGINAL function: its
+body runs once at decoration time, never inside the graph."""
+glob PY_MODEL_METADATA_DECO_SRC = '''
+import torch
+
+
+def describe(fn):
+    print('DESCRIBING')
+    fn.__doc__ = build_doc(fn)
+    return fn
+
+
+def build_doc(fn):
+    print('BUILDING', fn.__name__)
+    return 'doc'
+
+
+class Net(torch.nn.Module):
+    @describe
+    def forward(self, x):
+        return torch.relu(x)
+''';
+
+test "a metadata decorator's helpers stay out of the region" {
+    # `describe` never invokes the decorated function -- it returns it -- so it
+    # is not a call-time wrapper and neither it nor `build_doc` runs inside the
+    # graph. Deferring their prints would replay import-time output at the
+    # first forward.
+    src = _py_model_src(PY_MODEL_METADATA_DECO_SRC, "model_metadata_deco.py");
+    assert "__jac_se_emit__(" not in src;
+    assert "print('DESCRIBING')" in src;
+    assert "print('BUILDING', fn.__name__)" in src;
+}
+
+glob PY_MODEL_DECO_NOISY_SRC = '''
+import torch
+
+
+def noisy_decorator(fn):
+    print('DECORATING', fn.__name__)
+
+    def wrapper(self, x):
+        print('CALLING', x)
+        return fn(self, x)
+    return wrapper
+
+
+class Net(torch.nn.Module):
+    @noisy_decorator
+    def forward(self, x):
+        return torch.relu(x)
+''';
+
+test "decoration-time code stays out of the compiled region" {
+    # Only the decorator's closures run under the compiled graph; the
+    # decorator's own body runs once at class-definition time, so deferring
+    # its side effects would replay them at the wrong moment. The closure's
+    # runtime print buffers, the decoration-time print must stay eager.
+    src = _py_model_src(PY_MODEL_DECO_NOISY_SRC, "model_deco_noisy.py");
+    assert "__jac_se_emit__(print," in src;
+    assert "print('DECORATING', fn.__name__)" in src;
+}
+
+"""Write a generated .py source to a temp file and compile it in entry-file
+mode (no scope): the region comes from the local torch.compile entries."""
+def _py_entry_src(py_src: str, name: str) -> str {
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, name);
+        with open(path, "w") as fh {
+            fh.write(py_src);
+        }
+        prog = JacProgram();
+        mod = prog.compile(file_path=path, options=CompileOptions(graphmend=True));
+        pa = mod.gen.py_ast;
+        mod_ast: any = pa[0] if isinstance(pa, list) else pa;
+        return ast.unparse(mod_ast);
+    }
+}
+
+glob PY_ENTRY_DECORATOR_SRC = '''
+import torch
+
+
+def logging_wrap(fn):
+
+    def wrapper(x):
+        if x.sum() > 0:
+            y = x * 2.0
+        else:
+            y = x * 3.0
+        return fn(y)
+    return wrapper
+
+
+@torch.compile
+@logging_wrap
+def entry(x):
+    return torch.relu(x)
+''';
+
+test "entry-file: a stacked decorator's closure is analyzed and transformed" {
+    # `torch.compile` receives `logging_wrap(entry)`, i.e. the closure, so the
+    # closure is the compiled code. The decorated entry is the seed and the
+    # decorator edge pulls `wrapper` into the region without any scope flag.
+    src = _py_entry_src(PY_ENTRY_DECORATOR_SRC, "entry_decorator.py");
+    assert "torch.where(" in src;
+    assert "if x.sum() > 0" not in src;
+}
+
+"""An init behind an existence guard calls a function whose body calls its OWN
+nested helper; the purity proof must resolve that helper lexically, and one
+unresolvable callee declines the merge."""
+glob PY_MODEL_NESTED_PURITY_SRC = '''
+import torch
+
+
+def compute_inv(v):
+
+    def clamp01(s):
+        if s <= 0:
+            return 0.0
+        return s
+    return clamp01(v) + 1.0
+
+
+class Net(torch.nn.Module):
+    def forward(self, x, position_ids, limit):
+        seq_len = torch.max(position_ids) + 1
+        if seq_len > limit:
+            if not hasattr(self, "long_state"):
+                self.long_state = compute_inv(2.0)
+            self.register_buffer("state", self.long_state)
+        else:
+            self.register_buffer("state", self.base_state)
+        return torch.relu(x)
+''';
+
+test "a candidate's nested helper resolves in the purity proof" {
+    # The tag on the outer branch is only useful if the transform CONSUMES it:
+    # the setup's init calls compute_inv, whose nested clamp01 must resolve
+    # lexically for the body to prove pure and the common call to merge.
+    src = _py_model_src(PY_MODEL_NESTED_PURITY_SRC, "model_nested_purity.py");
+    assert "torch.where(" in src;
+    assert "if seq_len > limit" not in src;
+}
