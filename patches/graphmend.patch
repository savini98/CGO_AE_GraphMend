+         'float',
+         'double',
+         'clone',
+         'detach'
+     },
+     _TENSOR_BOOL_REDUCERS: set[str] = {'all', 'any'},
+     _PURE_TORCH_FNS: set[str] = {
+         'arange',
+         'as_tensor',
+         'cat',
