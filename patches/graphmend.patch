+runs out. The direct `.sum()` licenses detection by itself, so only the
+scalar query giving up safely keeps `a11`, a Python bool, out of
+`torch.where`."""
+import torch;
+
+@torch.compile()
+def f(x: any, m: any, n: any) -> any {
+    a0 = x.item();
+    a1 = a0 + 1;
+    a2 = a1 + 1;
+    a3 = a2 + 1;
+    a4 = a3 + 1;
+    a5 = a4 + 1;
+    a6 = a5 + 1;
+    a7 = a6 + 1;
+    a8 = a7 + 1;
+    a9 = a8 + 1;
+    a10 = a9 + 1;
+    a11 = a10 + 1;
+    if (x.sum() > 0) and (a11 > 5) {
+        return m;
+    } else {
+        return n;
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/scalar_predicate.jac b/jac/tests/compiler/passes/fixtures/graphmend/scalar_predicate.jac
new file mode 100644
index 0000000..40b70b3
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/scalar_predicate.jac
@@ -0,0 +1,39 @@
+"""Soundness: a predicate that materializes a Python scalar.
+
+`torch.where` takes a tensor condition; `.item()`, `torch.equal` and
+`torch.allclose` produce a Python bool, and passing one raises TypeError. The
+materializing call is itself the graph break, so predication could not remove
+it in any case. All three shapes are detected and then declined: the direct
+one, the one reached through a use-def chain, and the one behind a bare
+alias."""
+import torch;
+
+@torch.compile()
+def direct(x: any, m: any, n: any) -> any {
+    if (x.item() > 5) {
+        return m;
+    } else {
+        return n;
+    }
+}
+
+@torch.compile()
+def traced(x: any, m: any, n: any) -> any {
+    hits = x.sum().item();
+    if (hits > 5) {
+        return m;
+    } else {
+        return n;
+    }
+}
+
+@torch.compile()
+def aliased(x: any, m: any, n: any) -> any {
+    hits = x.item();
+    same = hits;
+    if (x.sum() > 0) and (same > 5) {
+        return m;
+    } else {
+        return n;
+    }
+}
