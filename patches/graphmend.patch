+    def _base_binds_logger(t: uni.AtomTrailer) -> bool;
+    def _is_user_defined(nd: uni.FuncCall, name: str) -> bool;
+}
diff --git a/mod_jac/jaclang/compiler/passes/graphmend/impl/defer_side_effect_pass.impl.jac b/jac/jaclang/compiler/passes/graphmend/impl/defer_side_effect_pass.impl.jac
new file mode 100644
index 0000000..4f6974a
--- /dev/null
+++ b/jac/jaclang/compiler/passes/graphmend/impl/defer_side_effect_pass.impl.jac
@@ -0,0 +1,309 @@
+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.frontend.constant {
+    GraphBreakKind,
+    GraphMendHelper,
+    Tokens as Tok
+}
+import from jaclang.compiler.passes.graphmend.ast_edit {
+    append_stmt,
+    facts_for,
+    gen_name,
+    gen_string,
+    insert_after,
+    insert_before,
+    need_helper,
+    split_params
+}
+import from jaclang.compiler.passes.graphmend.torch_attr_table {
+    has_torch_compile_decorator
+}
+
+impl DeferSideEffectPass.before_pass -> None {
+    import from jaclang.compiler.driver.compile_options { defer_declines_here }
+    self._enabled = (self.prog.options.graphmend is True)
+        and "defer" not in (self.prog.options.graphmend_disable or [])
+        and (not defer_declines_here());
+    if not self._enabled {
+        self.prune_signal = True;
+    }
+    self._pending_regs = [];
+}
+
+impl DeferSideEffectPass.exit_func_call(nd: uni.FuncCall) -> None {
+    if not self._enabled {
+        return;
+    }
+    if facts_for(nd).breaks.get(nd) != GraphBreakKind.SIDE_EFFECT {
+        return;
+    }
+    parent = nd.parent;
+    if not isinstance(parent, uni.ExprStmt) {
+        return;
+    }
+    ability = nd.find_parent_of_type(uni.Ability);
+    if ability is None {
+        return;
+    }
+    if self._has_unpack(nd) {
+        return;
+    }
+    if self._is_logger_call(nd) and (ability?.sym_name == 'forward') {
+        emit_call = self._logger_emit(nd);
+        if emit_call is not None {
+            parent.expr = emit_call;
+            parent.set_kids([emit_call]);
+            return;
+        }
+    }
+    (`entry, hoists) = self._buffer_entry(nd);
+    append_call = self._buffer_append(nd, `entry);
+    parent.expr = append_call;
+    parent.set_kids([append_call]);
+    for h in hoists {
+        insert_before(parent, h);
+    }
+    self._needs_se.add(id(ability));
+}
+
+impl DeferSideEffectPass.exit_module(nd: uni.Module) -> None {
+    if not self._enabled {
+        return;
+    }
+    if id(nd) in self._defer_mods {
+        for ab in nd.get_all_sub_nodes(uni.Ability) {
+            if has_torch_compile_decorator(ab) and (id(ab) not in self._guarded) {
+                self._attach_se_guard(ab);
+            }
+        }
+    }
+    if not self._pending_regs {
+        return;
+    }
+    for (anchor, reg) in self._pending_regs {
+        placed = False;
+        if (anchor is not None) and (anchor.parent is nd) and (anchor in nd.kid) {
+            placed = insert_after(anchor, reg);
+        }
+        if not placed {
+            append_stmt(nd, reg);
+        }
+    }
+    self._pending_regs = [];
+}
+
+impl DeferSideEffectPass.exit_return_stmt(nd: uni.ReturnStmt) -> None {
+    if not self._enabled {
+        return;
+    }
+    ability = nd.find_parent_of_type(uni.Ability);
+    if (ability is None) or (id(ability) not in self._needs_se) {
+        return;
+    }
+    if not self._is_compiled_entry(ability) {
+        return;
+    }
+    if nd.expr is None {
+        insert_before(nd, self._flush_stmt(nd));
+        return;
+    }
+    n = self._counter;
+    self._counter += 1;
+    tmp = gen_name(nd, f"__gm_ret_{n}", True);
+    ret_assign = uni.Assignment(
+        target=[tmp], value=nd.expr, type_tag=None, mutable=True, kid=[tmp, nd.expr]
+    );
+    ref = gen_name(nd, f"__gm_ret_{n}", False);
+    nd.expr = ref;
+    nd.set_kids([ref]);
+    insert_before(nd, ret_assign);
+    insert_before(nd, self._flush_stmt(nd));
+}
+
+impl DeferSideEffectPass.exit_ability(nd: uni.Ability) -> None {
+    if not self._enabled {
+        return;
+    }
+    if id(nd) not in self._needs_se {
+        return;
+    }
+    body = nd.body;
+    if (not isinstance(body, list)) or (not body) {
+        return;
+    }
+    mod = nd.find_parent_of_type(uni.Module);
+    if mod is not None {
+        self._defer_mods.add(id(mod));
+    }
+    if not self._is_compiled_entry(nd) {
+        return;
+    }
+    tail = body[-1];
+    if not isinstance(tail, uni.ReturnStmt) {
+        append_stmt(nd, self._flush_stmt(nd));
+    }
+    if has_torch_compile_decorator(nd) {
+        self._attach_se_guard(nd);
+    }
+}
+
+impl DeferSideEffectPass._attach_se_guard(nd: uni.Ability) -> None {
+    if id(nd) in self._guarded {
+        return;
+    }
+    need_helper(nd, GraphMendHelper.SE_GUARD);
+    guard = gen_name(nd, '__jac_se_guard__', False);
+    nd.decorators = [guard] + list(nd.decorators or []);
+    nd.set_kids([guard] + list(nd.kid));
+    guard.parent = nd;
+    self._guarded.add(id(nd));
+}
+
+impl DeferSideEffectPass._is_compiled_entry(nd: uni.Ability) -> bool {
+    return facts_for(nd).boundary.get(nd) is nd;
+}
+
+impl DeferSideEffectPass._str(at: uni.UniNode, text: str) -> uni.String {
+    return gen_string(at, f'"{text}"');
+}
+
+impl DeferSideEffectPass._has_unpack(call: uni.FuncCall) -> bool {
+    for p in (call.params or []) {
+        if isinstance(p, uni.KWPair) {
+            if p.key is None {
+                return True;
+            }
+        } elif isinstance(p, uni.UnaryExpr)
+            and (p.op.name in [Tok.STAR_MUL, Tok.STAR_POW]) {
+            return True;
+        }
+    }
+    return False;
+}
+
+impl DeferSideEffectPass._tuple(
+    at: uni.UniNode, values: list[uni.Expr]
+) -> uni.TupleVal {
+    kid: list[uni.UniNode] = (
+        list(values)
+            if values
+            else [at.gen_token(Tok.LPAREN, '('), at.gen_token(Tok.RPAREN, ')')]
+    );
+    return uni.TupleVal(values=values, kid=kid);
+}
+
+impl DeferSideEffectPass._dict_from_kws(
+    at: uni.UniNode, kws: list[uni.KWPair]
+) -> uni.DictVal {
+    pairs: list[uni.KVPair] = [];
+    for kw in kws {
+        key_nm = kw.key;
+        if key_nm is None {
+            continue;
+        }
+        key = self._str(at, key_nm.sym_name);
+        pairs.append(uni.KVPair(key=key, value=kw.value, kid=[key, kw.value]));
+    }
+    kid: list[uni.UniNode] = (
+        list(pairs)
+            if pairs
+            else [at.gen_token(Tok.LBRACE, '{'), at.gen_token(Tok.RBRACE, '}')]
+    );
+    return uni.DictVal(kv_pairs=pairs, kid=kid);
+}
+
+impl DeferSideEffectPass._buffer_entry(
+    call: uni.FuncCall
+) -> tuple[uni.TupleVal, list[uni.UniNode]] {
+    (pos, kws) = split_params(call.params);
+    hoists: list[uni.UniNode] = [];
+    new_pos: list[uni.Expr] = [];
+    for p in pos {
+        if isinstance(p, (uni.Literal, uni.MultiString, uni.FString)) {
+            new_pos.append(p);
+        } else {
+            new_pos.append(self._snapshot(call, p, hoists));
+        }
+    }
+    new_kws: list[uni.KWPair] = [];
+    for kw in kws {
+        v = kw.value;
+        if isinstance(v, (uni.Literal, uni.MultiString, uni.FString))
+            or (kw.key is None) {
+            new_kws.append(kw);
+        } else {
+            snap = self._snapshot(call, v, hoists);
+            new_kws.append(uni.KWPair(key=kw.key, value=snap, kid=[kw.key, snap]));
+        }
+    }
+    args_tuple = self._tuple(call, new_pos);
+    kwargs_dict = self._dict_from_kws(call, new_kws);
+    items: list[uni.Expr] = [call.target, args_tuple, kwargs_dict];
+    return (uni.TupleVal(values=items, kid=items), hoists);
+}
+
+impl DeferSideEffectPass._snapshot(
+    call: uni.FuncCall, v: uni.Expr, hoists: list[uni.UniNode]
+) -> uni.Expr {
+    n = self._se_arg_counter;
+    self._se_arg_counter += 1;
+    tmp = f"__gm_se_arg_{n}";
+    store = gen_name(call, tmp, True);
+    hoists.append(
+        uni.Assignment(
+            target=[store], value=v, type_tag=None, mutable=True, kid=[store, v]
+        )
+    );
+    return self._clone_guard(call, tmp);
+}
+
+impl DeferSideEffectPass._clone_guard(at: uni.UniNode, tmp: str) -> uni.IfElseExpr {
+    recv = gen_name(at, tmp, False);
+    clone_nm = gen_name(at, 'clone', False);
+    trailer = uni.AtomTrailer(
+        target=recv,
+        right=clone_nm,
+        is_attr=True,
+        is_null_ok=False,
+        kid=[recv, clone_nm]
+    );
+    clone_call = uni.FuncCall(
+        target=trailer, params=[], genai_call=None, kid=[trailer]
+    );
+    has_nm = gen_name(at, 'hasattr', False);
+    test_recv = gen_name(at, tmp, False);
+    attr_name = self._str(at, 'clone');
+    `test = uni.FuncCall(
+        target=has_nm,
+        params=[test_recv, attr_name],
+        genai_call=None,
+        kid=[has_nm, test_recv, attr_name]
+    );
+    else_recv = gen_name(at, tmp, False);
+    val_cfg = uni.CfgExpr(expr=clone_call, kid=[clone_call]);
+    cond_cfg = uni.CfgExpr(expr=`test, kid=[`test]);
+    else_cfg = uni.CfgExpr(expr=else_recv, kid=[else_recv]);
+    return uni.IfElseExpr(
+        value=val_cfg,
+        condition=cond_cfg,
+        else_value=else_cfg,
+        kid=[val_cfg, cond_cfg, else_cfg]
+    );
+}
+
+impl DeferSideEffectPass._buffer_append(
+    at: uni.UniNode, ent: uni.TupleVal
+) -> uni.FuncCall {
+    need_helper(at, GraphMendHelper.SE_EMIT);
+    emit = gen_name(at, '__jac_se_emit__', False);
+    params = list(ent.values);
+    return uni.FuncCall(
+        target=emit, params=params, genai_call=None, kid=[emit] + params
+    );
+}
+
+impl DeferSideEffectPass._flush_stmt(at: uni.UniNode) -> uni.ExprStmt {
+    need_helper(at, GraphMendHelper.SE_FLUSH);
+    helper = gen_name(at, '__jac_se_flush__', False);
+    call = uni.FuncCall(target=helper, params=[], genai_call=None, kid=[helper]);
+    return uni.ExprStmt(expr=call, in_fstring=False, kid=[call]);
+}
diff --git a/mod_jac/jaclang/compiler/passes/graphmend/impl/defer_side_effect_pass.logger.impl.jac b/jac/jaclang/compiler/passes/graphmend/impl/defer_side_effect_pass.logger.impl.jac
new file mode 100644
index 0000000..5437a5d
--- /dev/null
+++ b/jac/jaclang/compiler/passes/graphmend/impl/defer_side_effect_pass.logger.impl.jac
@@ -0,0 +1,155 @@
+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.frontend.constant { GraphMendHelper }
+import from jaclang.compiler.passes.graphmend.ast_edit {
+    gen_bool,
+    gen_name,
+    insert_after,
+    need_helper,
+    split_params
+}
+import from jaclang.compiler.passes.graphmend.torch_attr_table { is_torch_attr_target }
+
+impl DeferSideEffectPass._is_logger_call(nd: uni.FuncCall) -> bool {
+    t = nd.target;
+    if not isinstance(t, uni.AtomTrailer) {
+        return False;
+    }
+    if (not isinstance(t.right, uni.Name))
+        or (t.right.value not in self._LOG_METHODS) {
+        return False;
+    }
+    base = t.target;
+    return isinstance(base, uni.Name)
+        and (base.value not in {'self', 'cls'})
+        and self._base_binds_at_module(base);
+}
+
+impl DeferSideEffectPass._base_binds_at_module(base: uni.Name) -> bool {
+    sym = base.sym;
+    if sym is None {
+        return False;
+    }
+    decl = sym.decl;
+    return (decl is not None) and (decl.find_parent_of_type(uni.Ability) is None);
+}
+
+impl DeferSideEffectPass._logger_emit(nd: uni.FuncCall) -> (uni.FuncCall | None) {
+    callee = nd.target;
+    n = self._counter;
+    self._counter += 1;
+    slot_name = f"_gm_log_slot_{n}";
+    reg = self._register_assignment(nd, slot_name, callee);
+    self._pending_regs.append((self._toplevel_archetype(nd), reg));
+    need_helper(nd, GraphMendHelper.LOG_EMIT);
+    (pos, kws) = split_params(nd.params);
+    emit = gen_name(nd, '__jac_log_emit__', False);
+    slot_ref = gen_name(nd, slot_name, False);
+    args_tuple = self._tuple(nd, pos);
+    kwargs_dict = self._dict_from_kws(nd, kws);
+    params: list[uni.Expr] = [slot_ref, args_tuple, kwargs_dict];
+    return uni.FuncCall(
+        target=emit, params=params, genai_call=None, kid=[emit] + params
+    );
+}
+
+impl DeferSideEffectPass._register_assignment(
+    at: uni.UniNode, slot_name: str, callee: uni.Expr
+) -> uni.Assignment {
+    need_helper(at, GraphMendHelper.LOG_REGISTER);
+    reg_fn = gen_name(at, '__jac_log_register__', False);
+    reg_call = uni.FuncCall(
+        target=reg_fn, params=[callee], genai_call=None, kid=[reg_fn, callee]
+    );
+    slot = gen_name(at, slot_name, True);
+    return uni.Assignment(
+        target=[slot], value=reg_call, type_tag=None, mutable=True, kid=[slot, reg_call]
+    );
+}
+
+impl DeferSideEffectPass._toplevel_archetype(
+    nd: uni.UniNode
+) -> (uni.Archetype | None) {
+    mod = nd.find_parent_of_type(uni.Module);
+    top: (uni.Archetype | None) = None;
+    cur: (uni.Archetype | None) = nd.find_parent_of_type(uni.Archetype);
+    while (cur is not None) and (cur.find_parent_of_type(uni.Module) is mod) {
+        top = cur;
+        cur = cur.find_parent_of_type(uni.Archetype);
+    }
+    return top;
+}
+
+impl DeferSideEffectPass.exit_assignment(nd: uni.Assignment) -> None {
+    if not self._enabled {
+        return;
+    }
+    value = nd.value;
+    if (
+        (not isinstance(value, uni.FuncCall))
+        or (not is_torch_attr_target(value.target, 'compile'))
+    ) {
+        return;
+    }
+    if (not nd.target) or (len(nd.target) != 1) {
+        return;
+    }
+    tgt = nd.target[0];
+    if not isinstance(tgt, uni.Name) {
+        return;
+    }
+    hooks: list = [
+        self._pre_hook_register_stmt(nd, tgt.value),
+        self._hook_register_stmt(nd, tgt.value)
+    ];
+    if not insert_after(nd, self._hook_guard_stmt(nd, tgt.value, hooks)) {
+        return;
+    }
+    need_helper(nd, GraphMendHelper.SE_REGION_OPEN);
+    need_helper(nd, GraphMendHelper.LOG_FLUSH_HOOK);
+}
+
+impl DeferSideEffectPass._hook_guard_stmt(
+    at: uni.UniNode, name: str, body: list
+) -> uni.IfStmt {
+    has_nm = gen_name(at, 'hasattr', False);
+    recv = gen_name(at, name, False);
+    attr = self._str(at, 'register_forward_pre_hook');
+    `test = uni.FuncCall(
+        target=has_nm, params=[recv, attr], genai_call=None, kid=[has_nm, recv, attr]
+    );
+    return uni.IfStmt(condition=`test, body=body, kid=[`test] + body);
+}
+
+impl DeferSideEffectPass._pre_hook_register_stmt(
+    at: uni.UniNode, name: str
+) -> uni.ExprStmt {
+    recv = gen_name(at, name, False);
+    meth = gen_name(at, 'register_forward_pre_hook', False);
+    target = uni.AtomTrailer(
+        target=recv, right=meth, is_attr=True, is_null_ok=False, kid=[recv, meth]
+    );
+    hook = gen_name(at, '__jac_se_region_open__', False);
+    call = uni.FuncCall(
+        target=target, params=[hook], genai_call=None, kid=[target, hook]
+    );
+    return uni.ExprStmt(expr=call, in_fstring=False, kid=[call]);
+}
+
+impl DeferSideEffectPass._hook_register_stmt(
+    at: uni.UniNode, name: str
+) -> uni.ExprStmt {
+    recv = gen_name(at, name, False);
+    meth = gen_name(at, 'register_forward_hook', False);
+    target = uni.AtomTrailer(
+        target=recv, right=meth, is_attr=True, is_null_ok=False, kid=[recv, meth]
+    );
+    hook = gen_name(at, '__jac_log_flush_hook__', False);
+    kw_key = gen_name(at, 'always_call', False);
+    kw_val = gen_bool(at, True);
+    always = uni.KWPair(key=kw_key, value=kw_val, kid=[kw_key, kw_val]);
+    params: list = [hook, always];
+    call = uni.FuncCall(
+        target=target, params=params, genai_call=None, kid=[target] + params
+    );
+    return uni.ExprStmt(expr=call, in_fstring=False, kid=[call]);
+}
diff --git a/mod_jac/jaclang/compiler/passes/graphmend/impl/graph_break_detect_pass.impl.jac b/jac/jaclang/compiler/passes/graphmend/impl/graph_break_detect_pass.impl.jac
new file mode 100644
index 0000000..9b81e0e
--- /dev/null
+++ b/jac/jaclang/compiler/passes/graphmend/impl/graph_break_detect_pass.impl.jac
@@ -0,0 +1,195 @@
+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.frontend.constant { GraphBreakKind }
+import from jaclang.compiler.passes.graphmend.ast_edit { facts_for }
+import from jaclang.compiler.passes.graphmend.scope_facts {
+    body_is_only,
+    collect_wrap_entries,
+    compiled_region_ids,
+    materialize_claim_chain,
+    module_has_wrap_site,
+    register_claim
+}
+import from jaclang.compiler.passes.graphmend.torch_attr_table {
+    cond_is_data_dependent,
+    defining_assignment,
+    is_side_effect_name,
+    symbol_is_builtin
+}
+
+impl GraphBreakDetectPass.before_pass -> None {
+    self._enabled = self.prog.options.graphmend is True;
+    if not self._enabled {
+        self.prune_signal = True;
+        return;
+    }
+    register_claim(self.prog, self.ir_in, self._mat_seen);
+    materialize_claim_chain(self.prog, self.ir_in.loc.mod_path, self._mat_seen);
+    self._saw_compile_call = module_has_wrap_site(self.ir_in);
+    wrapped = collect_wrap_entries(
+        self.prog, self.ir_in, self._mat_seen, facts_for(self.ir_in).wrapped_keys
+    );
+    self._entry_ids = set();
+    for e in wrapped {
+        if isinstance(e, uni.Ability) {
+            self._entry_ids.add(id(e));
+        }
+    }
+    self._entry_ids |= compiled_region_ids(
+        self.prog, self.ir_in, self._mat_seen, wrapped
+    );
+    members: list[uni.UniNode] = [];
+    members.extend(self.ir_in.get_all_sub_nodes(uni.Ability));
+    members.extend(self.ir_in.get_all_sub_nodes(uni.Archetype));
+    local = False;
+    for member in members {
+        if id(member) in self._entry_ids {
+            local = True;
+            break;
+        }
+    }
+    self._record_noop(local);
+    if not local {
+        self._enabled = False;
+        self.prune_signal = True;
+        return;
+    }
+    self._spine_ids = set();
+    for member in members {
+        if id(member) in self._entry_ids {
+            cur: (uni.UniNode | None) = member.parent;
+            while cur is not None {
+                self._spine_ids.add(id(cur));
+                cur = cur.parent;
+            }
+        }
+    }
+}
+
+impl GraphBreakDetectPass._record_noop(local: bool) -> None {
+    facts_for(self.ir_in).noop = (not local) and (not self._saw_compile_call);
+}
+
+impl GraphBreakDetectPass.enter_ability(nd: uni.Ability) -> None {
+    if not self._enabled {
+        return;
+    }
+    if (id(nd) in self._entry_ids) or (id(nd) in self._spine_ids) {
+        return;
+    }
+    if self._in_torch_compiled_scope(nd) {
+        return;
+    }
+    self.prune_signal = True;
+}
+
+impl GraphBreakDetectPass._in_torch_compiled_scope(nd: uni.UniNode) -> bool {
+    cur = nd.parent;
+    while cur {
+        if id(cur) in self._entry_ids {
+            return True;
+        }
+        cur = cur.parent;
+    }
+    return False;
+}
+
+impl GraphBreakDetectPass.enter_func_call(nd: uni.FuncCall) -> None {
+    if not self._enabled {
+        return;
+    }
+    if not self._in_torch_compiled_scope(nd) {
+        return;
+    }
+    name = self._call_name(nd);
+    if (name is not None) and is_side_effect_name(name) {
+        if self._is_user_defined(nd, name) {
+            return;
+        }
+        target = nd.target;
+        if isinstance(target, uni.AtomTrailer) {
+            if not self._base_binds_logger(target) {
+                return;
+            }
+        } elif name != 'print' {
+            return;
+        }
+        facts_for(nd).breaks[nd] = GraphBreakKind.SIDE_EFFECT;
+    }
+}
+
+impl GraphBreakDetectPass._base_binds_logger(t: uni.AtomTrailer) -> bool {
+    base = t.target;
+    if not isinstance(base, uni.Name) {
+        return False;
+    }
+    st = base.sym_tab;
+    sym = st.lookup(base.value, deep=True) if st else None;
+    if sym is None {
+        return False;
+    }
+    decl = sym.decl;
+    if decl is not None {
+        mi = decl.find_parent_of_type(uni.ModuleItem);
+        if (mi is not None) and isinstance(mi.name, uni.Name) {
+            local = mi.alias.value if (mi.alias is not None) else mi.name.value;
+            if local in {'logging', 'warnings'} {
+                return True;
+            }
+        }
+        mp = decl.find_parent_of_type(uni.ModulePath);
+        if (mp is not None)
+            and (mp.dot_path_str.lstrip('.').split('.')[-1] in {'logging', 'warnings'}) {
+            return True;
+        }
+    }
+    assign = defining_assignment(sym);
+    v = assign.value if (assign is not None) else None;
+    if not isinstance(v, uni.FuncCall) {
+        return False;
+    }
+    leaf = v.target.right if isinstance(v.target, uni.AtomTrailer) else v.target;
+    return isinstance(leaf, uni.Name) and (leaf.value in {'getLogger', 'get_logger'});
+}
+
+impl GraphBreakDetectPass._call_name(nd: uni.FuncCall) -> (str | None) {
+    target = nd.target;
+    if isinstance(target, uni.Name) {
+        return target.value;
+    }
+    if (isinstance(target, uni.AtomTrailer) and isinstance(target.right, uni.Name)) {
+        return target.right.value;
+    }
+    return None;
+}
+
+impl GraphBreakDetectPass._is_user_defined(nd: uni.FuncCall, name: str) -> bool {
+    st = nd.sym_tab;
+    if not st {
+        return False;
+    }
+    sym = st.lookup(name, deep=True);
+    if (sym is not None) and symbol_is_builtin(sym) {
+        return False;
+    }
+    return bool(sym and sym.defn);
+}
+
+impl GraphBreakDetectPass.enter_if_stmt(nd: uni.IfStmt) -> None {
+    if not self._enabled {
+        return;
+    }
+    if isinstance(nd, uni.ElseIf) {
+        return;
+    }
+    if not self._in_torch_compiled_scope(nd) {
+        return;
+    }
+    if not cond_is_data_dependent(nd.condition) {
+        return;
+    }
+    if body_is_only(nd.body, uni.RaiseStmt) {
+        facts_for(nd).breaks[nd] = GraphBreakKind.VAL_GUARD;
+    } else {
+        facts_for(nd).breaks[nd] = GraphBreakKind.DYN_CTRL_FL;
+    }
+}
diff --git a/mod_jac/jaclang/compiler/passes/graphmend/impl/predicate_ctrl_flow_pass.impl.jac b/jac/jaclang/compiler/passes/graphmend/impl/predicate_ctrl_flow_pass.impl.jac
new file mode 100644
index 0000000..dd44df4
--- /dev/null
+++ b/jac/jaclang/compiler/passes/graphmend/impl/predicate_ctrl_flow_pass.impl.jac
@@ -0,0 +1,596 @@
+import from jaclang.compiler.tools.unparse_pass { unparse_node }
+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.frontend.constant { GraphBreakKind, Tokens as Tok }
+import from jaclang.compiler.passes.graphmend.ast_edit {
+    facts_for,
+    gen_name,
+    replace_stmt,
+    split_params,
+    split_params_keyed,
+    torch_call
+}
+import from jaclang.compiler.passes.graphmend.scope_facts {
+    module_reaches_autograd,
+    region_in_inference_ctx
+}
+import from jaclang.compiler.passes.graphmend.torch_attr_table {
+    cond_is_data_dependent,
+    cond_materializes_scalar,
+    is_torch_attr_target
+}
+
+impl PredicateCtrlFlowPass.before_pass -> None {
+    self._enabled = (self.prog.options.graphmend is True)
+        and "where" not in (self.prog.options.graphmend_disable or []);
+    if not self._enabled {
+        self.prune_signal = True;
+        return;
+    }
+    self._autograd_reachable = module_reaches_autograd(self.ir_in);
+}
+
+impl PredicateCtrlFlowPass.exit_if_stmt(nd: uni.IfStmt) -> None {
+    if not self._enabled {
+        return;
+    }
+    if facts_for(nd).breaks.get(nd) != GraphBreakKind.DYN_CTRL_FL {
+        return;
+    }
+    before = self._counter;
+    self._where_family(nd);
+    if self._counter == before {
+        self._strengthen_guard(nd);
+    }
+}
+
+impl PredicateCtrlFlowPass._where_family(nd: uni.IfStmt) -> None {
+    grad_gated = self._autograd_reachable and (not region_in_inference_ctx(nd));
+    eb = nd.else_body;
+    if eb is None {
+        self._rewrite_predicated_update(nd, grad_gated);
+        return;
+    }
+    if grad_gated {
+        return;
+    }
+    if not isinstance(eb, uni.ElseStmt) {
+        return;
+    }
+    tb = nd.body;
+    fb = eb.body;
+    if (not tb) or (not fb) {
+        return;
+    }
+    if cond_materializes_scalar(nd.condition) {
+        return;
+    }
+    if (len(tb) == 1) and (len(fb) == 1) {
+        a0 = tb[0];
+        b0 = fb[0];
+        if isinstance(a0, uni.Assignment) and isinstance(b0, uni.Assignment) {
+            lhs = self._same_lhs(a0, b0);
+            av = a0.value;
+            bv = b0.value;
+            if (lhs is not None)
+                and isinstance(av, uni.Expr)
+                and isinstance(bv, uni.Expr)
+                and (not self._has_none(av, bv)) {
+                self._rewrite_assignment(nd, lhs, av, bv);
+            }
+        } elif isinstance(a0, uni.ReturnStmt) and isinstance(b0, uni.ReturnStmt) {
+            if (a0.expr is not None)
+                and (b0.expr is not None)
+                and (not self._has_none(a0.expr, b0.expr)) {
+                self._rewrite_return(nd, a0.expr, b0.expr);
+            }
+        } elif isinstance(a0, uni.ExprStmt) and isinstance(b0, uni.ExprStmt) {
+            self._merge_common_call(nd, a0.expr, b0.expr, [], []);
+        }
+        return;
+    }
+    a_last = tb[-1];
+    b_last = fb[-1];
+    if isinstance(a_last, uni.ExprStmt) and isinstance(b_last, uni.ExprStmt) {
+        (ts, fs) = (tb[:-1], fb[:-1]);
+        if (not (self._setup_writes(ts) & self._setup_writes(fs)))
+            and self._setups_safe(ts, nd)
+            and self._setups_safe(fs, nd) {
+            self._merge_common_call(nd, a_last.expr, b_last.expr, ts, fs);
+        }
+    }
+}
+
+impl PredicateCtrlFlowPass._rewrite_assignment(
+    nd: uni.IfStmt, lhs: uni.Name, true_e: uni.Expr, false_e: uni.Expr
+) -> None {
+    if self._has_call(true_e) or self._has_call(false_e) {
+        return;
+    }
+    if self._provably_non_tensor(true_e) or self._provably_non_tensor(false_e) {
+        return;
+    }
+    (stmts, c_ref, t_ref, f_ref) = self._hoist(nd, nd.condition, true_e, false_e);
+    where_call = torch_call(nd, 'where', [c_ref, t_ref, f_ref]);
+    replace_stmt(nd, stmts + [self._assign(lhs, where_call)]);
+}
+
+impl PredicateCtrlFlowPass._rewrite_return(
+    nd: uni.IfStmt, true_e: uni.Expr, false_e: uni.Expr
+) -> None {
+    if self._has_call(true_e) or self._has_call(false_e) {
+        return;
+    }
+    if self._provably_non_tensor(true_e) or self._provably_non_tensor(false_e) {
+        return;
+    }
+    (stmts, c_ref, t_ref, f_ref) = self._hoist(nd, nd.condition, true_e, false_e);
+    where_call = torch_call(nd, 'where', [c_ref, t_ref, f_ref]);
+    ret = uni.ReturnStmt(expr=where_call, kid=[where_call]);
+    replace_stmt(nd, stmts + [ret]);
+}
+
+impl PredicateCtrlFlowPass._rewrite_predicated_update(
+    nd: uni.IfStmt, grad_gated: bool
+) -> None {
+    updates = self._update_targets(nd);
+    if updates is None {
+        return;
+    }
+    if not self._torch_bound(nd) {
+        return;
+    }
+    (static_cond, tensor_cond) = self._static_and_prefix(nd.condition);
+    if tensor_cond is None {
+        return;
+    }
+    lowered = self._lower_tensor_bool(nd, tensor_cond, False);
+    if lowered is None {
+        return;
+    }
+    n = self._counter;
+    self._counter += 1;
+    cond_tmp = gen_name(nd, f"__gm_cond_{n}", True);
+    new_stmts: list = [self._assign(cond_tmp, lowered)];
+    for (stmt, tgt, value) in updates {
+        if tgt is None {
+            new_stmts.append(stmt);
+            continue;
+        }
+        cref = gen_name(nd, f"__gm_cond_{n}", False);
+        prev = gen_name(tgt, tgt.value, False);
+        sel = torch_call(nd, 'where', [cref, value, prev]);
+        new_stmts.append(self._assign(gen_name(tgt, tgt.value, True), sel));
+    }
+    if not grad_gated {
+        if static_cond is None {
+            replace_stmt(nd, new_stmts);
+            return;
+        }
+        holder: any = nd;
+        setattr(holder, 'condition', static_cond);
+        setattr(holder, 'body', new_stmts);
+        nd.set_kids([static_cond] + new_stmts);
+        return;
+    }
+    self._specialize_on_grad(nd, static_cond, new_stmts);
+}
+
+impl PredicateCtrlFlowPass._specialize_on_grad(
+    nd: uni.IfStmt, static_cond: (uni.Expr | None), new_stmts: list
+) -> None {
+    kept_cond = nd.condition;
+    kept_body = list(nd.body or []);
+    kept = uni.IfStmt(
+        condition=kept_cond, body=kept_body, kid=[kept_cond] + kept_body
+    );
+    taken: list = new_stmts;
+    if static_cond is not None {
+        inner = uni.IfStmt(
+            condition=static_cond, body=new_stmts, kid=[static_cond] + new_stmts
+        );
+        taken = [inner];
+    }
+    otherwise = uni.ElseStmt(body=taken, kid=taken);
+    grad_cond = torch_call(nd, 'is_grad_enabled', []);
+    holder: any = nd;
+    setattr(holder, 'condition', grad_cond);
+    setattr(holder, 'body', [kept]);
+    setattr(holder, 'else_body', otherwise);
+    nd.set_kids([grad_cond, kept, otherwise]);
+}
+
+impl PredicateCtrlFlowPass._unwrap_expr(e: uni.Expr) -> uni.Expr {
+    cur: uni.Expr = e;
+    while True {
+        if isinstance(cur, uni.CfgExpr) {
+            cur = cur.expr;
+            continue;
+        }
+        if isinstance(cur, uni.AtomUnit) and isinstance(cur.value, uni.Expr) {
+            cur = cur.value;
+            continue;
+        }
+        return cur;
+    }
+}
+
+impl PredicateCtrlFlowPass._bool_join(e: uni.Expr) -> (str | None) {
+    if (not isinstance(e, uni.BoolExpr)) or (e.op is None) {
+        return None;
+    }
+    if e.op.name == Tok.KW_AND {
+        return 'and';
+    }
+    if e.op.name == Tok.KW_OR {
+        return 'or';
+    }
+    return None;
+}
+
+impl PredicateCtrlFlowPass._lower_tensor_bool(
+    at: uni.UniNode, e: uni.Expr, merged: bool
+) -> (uni.Expr | None) {
+    term = self._unwrap_expr(e);
+    join = self._bool_join(term);
+    if (join is not None) and isinstance(term, uni.BoolExpr) {
+        fname = 'logical_and' if (join == 'and') else 'logical_or';
+        parts: list = [];
+        for v in term.values {
+            lv = self._lower_tensor_bool(at, v, True);
+            if lv is None {
+                return None;
+            }
+            parts.append(lv);
+        }
+        acc = parts[0];
+        for p in parts[1:] {
+            acc = torch_call(at, fname, [acc, p]);
+        }
+        return acc;
+    }
+    if isinstance(term, uni.UnaryExpr)
+        and (term.op is not None)
+        and (term.op.name == Tok.NOT) {
+        inner = self._lower_tensor_bool(at, term.operand, merged);
+        if inner is None {
+            return None;
+        }
+        return torch_call(at, 'logical_not', [inner]);
+    }
+    if not self._tensor_bool_atom(term) {
+        return None;
+    }
+    if merged and (not self._pure_value(term)) {
+        return None;
+    }
+    return term;
+}
+
+impl PredicateCtrlFlowPass._merge_common_call(
+    nd: uni.IfStmt,
+    ca: uni.Expr,
+    cb: uni.Expr,
+    true_setups: Sequence[uni.CodeBlockStmt],
+    false_setups: Sequence[uni.CodeBlockStmt]
+) -> None {
+    if (not isinstance(ca, uni.FuncCall)) or (not isinstance(cb, uni.FuncCall)) {
+        return;
+    }
+    if (
+        unparse_node(ca.target).replace(' ', '')
+        != unparse_node(cb.target).replace(' ', '')
+    ) {
+        return;
+    }
+    (a_pos, a_kw) = split_params_keyed(ca.params);
+    (b_pos, b_kw) = split_params_keyed(cb.params);
+    if len(a_pos) != len(b_pos) {
+        return;
+    }
+    if set(a_kw.keys()) != set(b_kw.keys()) {
+        return;
+    }
+    for k in a_kw {
+        if unparse_node(a_kw[k].value) != unparse_node(b_kw[k].value) {
+            return;
+        }
+    }
+    diff = [];
+    for i in range(len(a_pos)) {
+        if unparse_node(a_pos[i]) != unparse_node(b_pos[i]) {
+            diff.append(i);
+        }
+    }
+    if not diff {
+        return;
+    }
+    for i in diff {
+        if self._has_call(a_pos[i]) or self._has_call(b_pos[i]) {
+            return;
+        }
+        if self._provably_non_tensor(a_pos[i]) or self._provably_non_tensor(b_pos[i]) {
+            return;
+        }
+    }
+    for s in (list(true_setups) + list(false_setups)) {
+        if self._is_eq_assert(s) {
+            return;
+        }
+    }
+    n = self._counter;
+    self._counter += 1;
+    cond_tmp = gen_name(nd, f"__gm_cond_{n}", True);
+    cond_assign = self._assign(cond_tmp, nd.condition);
+    merged: list = [];
+    for i in range(len(a_pos)) {
+        if i in diff {
+            cref = gen_name(nd, f"__gm_cond_{n}", False);
+            merged.append(torch_call(nd, 'where', [cref, a_pos[i], b_pos[i]]));
+        } else {
+            merged.append(a_pos[i]);
+        }
+    }
+    for k in a_kw {
+        merged.append(a_kw[k]);
+    }
+    call_stmt = self._merged_call_stmt(nd, ca, a_pos, merged, diff);
+    gated_true = self._gate_asserts(list(true_setups), n, True);
+    gated_false = self._gate_asserts(list(false_setups), n, False);
+    new_nodes = [cond_assign] + gated_true + gated_false + [call_stmt];
+    replace_stmt(nd, new_nodes);
+}
+
+impl PredicateCtrlFlowPass._has_call(e: uni.UniNode) -> bool {
+    return isinstance(e, uni.FuncCall) or bool(e.get_all_sub_nodes(uni.FuncCall));
+}
+
+impl PredicateCtrlFlowPass._has_none(a: uni.Expr, b: uni.Expr) -> bool {
+    return isinstance(a, uni.Null) or isinstance(b, uni.Null);
+}
+
+impl PredicateCtrlFlowPass._provably_non_tensor(e: uni.Expr) -> bool {
+    return self._scalar_literal(e) or self._non_tensor_container(e);
+}
+
+impl PredicateCtrlFlowPass._scalar_literal(e: uni.Expr) -> bool {
+    if isinstance(e, uni.AtomUnit) {
+        inner = e.value;
+        return isinstance(inner, uni.Expr) and self._scalar_literal(inner);
+    }
+    if isinstance(e, uni.UnaryExpr) {
+        return (e.op is not None)
+            and (e.op.name in [Tok.PLUS, Tok.MINUS, Tok.BW_NOT, Tok.NOT])
+            and self._scalar_literal(e.operand);
+    }
+    return isinstance(e, (uni.Int, uni.Float, uni.Bool));
+}
+
+impl PredicateCtrlFlowPass._non_tensor_container(e: uni.Expr) -> bool {
+    if isinstance(e, uni.AtomUnit) {
+        inner = e.value;
+        return isinstance(inner, uni.Expr) and self._non_tensor_container(inner);
+    }
+    if isinstance(
+        e,
+        (
+            uni.String,
+            uni.MultiString,
+            uni.FString,
+            uni.ListVal,
+            uni.SetVal,
+            uni.TupleVal,
+            uni.DictVal,
+            uni.ListCompr,
+            uni.DictCompr
+        )
+    ) {
+        return True;
+    }
+    if isinstance(e, uni.BinaryExpr) {
+        return self._non_tensor_container(e.left)
+            or self._non_tensor_container(e.right);
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._same_lhs(
+    a: uni.Assignment, b: uni.Assignment
+) -> (uni.Name | None) {
+    if (len(a.target) != 1) or (len(b.target) != 1) {
+        return None;
+    }
+    ta = a.target[0];
+    tb = b.target[0];
+    if (
+        isinstance(ta, uni.Name) and isinstance(tb, uni.Name) and (ta.value == tb.value)
+    ) {
+        return gen_name(ta, ta.value, True);
+    }
+    return None;
+}
+
+impl PredicateCtrlFlowPass._assign(
+    target: uni.Name, value: uni.Expr
+) -> uni.Assignment {
+    return uni.Assignment(
+        target=[target], value=value, type_tag=None, mutable=True, kid=[target, value]
+    );
+}
+
+impl PredicateCtrlFlowPass._hoist(
+    at: uni.UniNode, cond: uni.Expr, t: uni.Expr, f: uni.Expr
+) -> tuple[list, uni.Name, uni.Name, uni.Name] {
+    n = self._counter;
+    (stmts, cond_ref) = self._hoist_cond(at, cond);
+    true_tmp = gen_name(at, f"__gm_true_{n}", True);
+    false_tmp = gen_name(at, f"__gm_false_{n}", True);
+    stmts = stmts + [self._assign(true_tmp, t), self._assign(false_tmp, f)];
+    true_ref = gen_name(at, f"__gm_true_{n}", False);
+    false_ref = gen_name(at, f"__gm_false_{n}", False);
+    return (stmts, cond_ref, true_ref, false_ref);
+}
+
+impl PredicateCtrlFlowPass._hoist_cond(
+    at: uni.UniNode, cond: uni.Expr
+) -> tuple[list, uni.Name] {
+    n = self._counter;
+    self._counter += 1;
+    cond_tmp = gen_name(at, f"__gm_cond_{n}", True);
+    cond_ref = gen_name(at, f"__gm_cond_{n}", False);
+    return ([self._assign(cond_tmp, cond)], cond_ref);
+}
+
+impl PredicateCtrlFlowPass._is_assert_async(stmt: uni.UniNode) -> bool {
+    if not isinstance(stmt, uni.ExprStmt) {
+        return False;
+    }
+    call = stmt.expr;
+    if not isinstance(call, uni.FuncCall) {
+        return False;
+    }
+    return is_torch_attr_target(call.target, '_assert_async');
+}
+
+impl PredicateCtrlFlowPass._is_eq_assert(stmt: uni.UniNode) -> bool {
+    if not isinstance(stmt, uni.ExprStmt) {
+        return False;
+    }
+    call = stmt.expr;
+    return (
+        isinstance(call, uni.FuncCall)
+        and isinstance(call.target, uni.Name)
+        and (call.target.value == '__jac_tensor_eq_assert__')
+    );
+}
+
+impl PredicateCtrlFlowPass._gate_asserts(
+    setups: list, n: int, taken_when_true: bool
+) -> list {
+    out = [];
+    for s in setups {
+        if (not self._is_assert_async(s)) or (not isinstance(s, uni.ExprStmt)) {
+            out.append(s);
+            continue;
+        }
+        call = s.expr;
+        if not isinstance(call, uni.FuncCall) {
+            out.append(s);
+            continue;
+        }
+        pos = split_params(call.params)[0];
+        if not pos {
+            out.append(s);
+            continue;
+        }
+        check = pos[0];
+        cref = gen_name(s, f"__gm_cond_{n}", False);
+        gate: uni.Expr = (
+            torch_call(s, 'logical_not', [cref]) if taken_when_true else cref
+        );
+        new_check = torch_call(s, 'logical_or', [gate, check]);
+        new_params = [new_check] + list(call.params[1:]);
+        new_call = uni.FuncCall(
+            target=call.target,
+            params=new_params,
+            genai_call=None,
+            kid=[call.target] + new_params
+        );
+        out.append(uni.ExprStmt(expr=new_call, in_fstring=False, kid=[new_call]));
+    }
+    return out;
+}
+
+impl PredicateCtrlFlowPass._merged_call_stmt(
+    nd: uni.IfStmt,
+    ca: uni.FuncCall,
+    a_pos: list,
+    merged: list,
+    diff: list
+) -> uni.ExprStmt {
+    tgt = ca.target;
+    if (diff == [1]) and (len(a_pos) >= 2) and isinstance(tgt, uni.AtomTrailer) {
+        rt = tgt.right;
+        first = a_pos[0];
+        if isinstance(rt, uni.Name) and isinstance(first, uni.String) {
+            if rt.value == 'register_buffer' {
+                bufname = first.value.strip('"').strip("'");
+                if bufname and bufname.isidentifier() {
+                    if self._buffer_preregistered(nd, bufname) {
+                        recv = tgt.target;
+                        buf_nm = gen_name(nd, bufname, False);
+                        buf_ref = uni.AtomTrailer(
+                            target=recv,
+                            right=buf_nm,
+                            is_attr=True,
+                            is_null_ok=False,
+                            kid=[recv, buf_nm]
+                        );
+                        copy_nm = gen_name(nd, 'copy_', False);
+                        copy_ref = uni.AtomTrailer(
+                            target=buf_ref,
+                            right=copy_nm,
+                            is_attr=True,
+                            is_null_ok=False,
+                            kid=[buf_ref, copy_nm]
+                        );
+                        val = merged[1];
+                        copy_call = uni.FuncCall(
+                            target=copy_ref,
+                            params=[val],
+                            genai_call=None,
+                            kid=[copy_ref, val]
+                        );
+                        return uni.ExprStmt(
+                            expr=copy_call, in_fstring=False, kid=[copy_call]
+                        );
+                    }
+                }
+            }
+        }
+    }
+    new_call = uni.FuncCall(
+        target=ca.target, params=merged, genai_call=None, kid=[ca.target] + merged
+    );
+    return uni.ExprStmt(expr=new_call, in_fstring=False, kid=[new_call]);
+}
+
+impl PredicateCtrlFlowPass._buffer_preregistered(
+    nd: uni.IfStmt, bufname: str
+) -> bool {
+    owner = nd.find_parent_of_type(uni.Module);
+    if owner is None {
+        return False;
+    }
+    site_ids = [];
+    for c in nd.get_all_sub_nodes(uni.FuncCall) {
+        site_ids.append(id(c));
+    }
+    for call in owner.get_all_sub_nodes(uni.FuncCall) {
+        if id(call) in site_ids {
+            continue;
+        }
+        ctgt = call.target;
+        if not isinstance(ctgt, uni.AtomTrailer) {
+            continue;
+        }
+        cright = ctgt.right;
+        if not isinstance(cright, uni.Name) {
+            continue;
+        }
+        if cright.value != 'register_buffer' {
+            continue;
+        }
+        (pos, kw) = split_params_keyed(call.params);
+        if len(pos) < 1 {
+            continue;
+        }
+        p0 = pos[0];
+        if not isinstance(p0, uni.String) {
+            continue;
+        }
+        if p0.value.strip('"').strip("'") == bufname {
+            return True;
+        }
+    }
+    return False;
+}
diff --git a/mod_jac/jaclang/compiler/passes/graphmend/impl/predicate_ctrl_flow_pass.legality.impl.jac b/jac/jaclang/compiler/passes/graphmend/impl/predicate_ctrl_flow_pass.legality.impl.jac
