--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_config.jac
@@ -0,0 +1,124 @@
+"""Per-transform disable options, threaded from the CLI and jac.toml to per-pass gating."""
+import os;
+import from tests.support {
+    GRAPHMEND_FIXTURES as FIXTURES,
+    graphmend_compile_opts as _compile_opts
+}
+import from jaclang.compiler.driver.compile_options { CompileOptions }
+
+"""Compile a checked-in fixture under graphmend with a disable list and
+return its generated Python source."""
+def _pysrc(name: str, disable: list) -> str {
+    return _compile_opts(
+        os.path.join(FIXTURES, name),
+        CompileOptions(graphmend=True, graphmend_disable=disable)
+    )[0];
+}
+
+test "disabling trap leaves guards unlowered while where and defer still fire" {
+    src = _pysrc("val_guard_all.jac", ["trap"]);
+    assert "raise ValueError" in src;
+    assert "torch._assert_async(" not in src;
+    assert "@__jac_trap_guard__" not in src;
+    assert "torch.where(" in _pysrc("where_return.jac", ["trap"]);
+    assert "__jac_se_emit__(print, " in _pysrc("side_effect.jac", ["trap"]);
+}
+
+test "disabling where leaves branches intact while trap and defer still fire" {
+    src = _pysrc("where_return.jac", ["where"]);
+    assert "torch.where(" not in src;
+    assert "if " in src;
+    assert "torch._assert_async(" in _pysrc("val_guard_all.jac", ["where"]);
+    assert "__jac_se_emit__(print, " in _pysrc("side_effect.jac", ["where"]);
+}
+
+test "disabling defer leaves side effects eager while trap and where still fire" {
+    src = _pysrc("side_effect.jac", ["defer"]);
+    assert "__jac_se_emit__" not in src;
+    assert "__jac_se_guard__" not in src;
+    assert "print(x)" in src;
+    assert "torch._assert_async(" in _pysrc("val_guard_all.jac", ["defer"]);
+    assert "torch.where(" in _pysrc("where_return.jac", ["defer"]);
+}
+
+test "an empty disable list keeps every transform active" {
+    assert "torch._assert_async(" in _pysrc("val_guard_all.jac", []);
+    assert "torch.where(" in _pysrc("where_return.jac", []);
+    assert "__jac_se_emit__(print, " in _pysrc("side_effect.jac", []);
+}
+
+test "the run command bridges the graphmend flags that remain to jac.toml" {
+    import from jaclang.cli.manifest { get_command_meta }
+    meta = get_command_meta("run");
+    assert meta is not None;
+    assert meta is not None;
+    by_name = {a.name: a for a in meta.args};
+    assert "graphmend" not in by_name;
+    assert "graphmend_scope" not in by_name;
+    gd = by_name.get("graphmend_disable");
+    assert gd is not None;
+    assert gd.config_key == "run.graphmend_disable";
+}
+
+test "the run section of jac.toml carries the graphmend keys" {
+    import from jaclang.project.config { JacConfig }
+    cfg = JacConfig.from_toml_str(
+        "[run]\ngraphmend = false\ngraphmend_disable = \"trap\"\n"
+    );
+    assert cfg.run.graphmend is False;
+    assert cfg.run.graphmend_disable == "trap";
+}
+
+test "run graphmend is an off switch that reads as on when absent" {
+    import from jaclang.project.config { JacConfig }
+    assert JacConfig.from_toml_str("[project]\nname = \"p\"\n").run.graphmend is True;
+    assert JacConfig.from_toml_str("[run]\nmain = true\n").run.graphmend is True;
+    assert JacConfig.from_toml_str("[run]\ngraphmend = false\n").run.graphmend is False;
+}
+
+"""A jac.toml written against the earlier tri-state keeps its meaning."""
+test "the legacy mode spellings still resolve to the boolean gate" {
+    import from jaclang.project.config { JacConfig }
+    for spelled in ["true", "\"on\"", "\"auto\""] {
+        cfg = JacConfig.from_toml_str(f"[run]\ngraphmend = {spelled}\n");
+        assert cfg.run.graphmend is True , f"{spelled} must leave graphmend on";
+    }
+    assert JacConfig.from_toml_str("[run]\ngraphmend = \"off\"\n").run.graphmend
+        is False;
+}
+
+test "explicit cli flags beat jac.toml which beats built-in defaults" {
+    import from jaclang.cli.dispatch { _apply_config_defaults }
+    import from jaclang.cli.manifest { get_command_meta }
+    import from jaclang.project.config { JacConfig }
+    meta = get_command_meta("run");
+    assert meta is not None;
+    cfg = JacConfig.from_toml_str("[run]\ngraphmend_disable = \"trap\"\n");
+    at_defaults = {"graphmend_disable": ""};
+    _apply_config_defaults(cfg, meta, at_defaults);
+    assert at_defaults["graphmend_disable"] == "trap";
+    explicit = {"graphmend_disable": "where"};
+    _apply_config_defaults(cfg, meta, explicit);
+    assert explicit["graphmend_disable"] == "where";
+    silent = {"graphmend_disable": ""};
+    _apply_config_defaults(
+        JacConfig.from_toml_str("[run]\nmain = true\n"), meta, silent
+    );
+    assert silent["graphmend_disable"] == "";
+}
+
+test "the cli disable flag reaches the compile options carrier" {
+    import jaclang.cli.commands.execution as execution;
+    import from jaclang.compiler.driver.compile_options { CompileOptions }
+    import from jaclang.project.config { JacConfig }
+    import jaclang.project.config as config_mod;
+    old_config = config_mod._config;
+    try {
+        config_mod._config = JacConfig.from_toml_str("[run]\nmain = true\n");
+        gm_on = execution._apply_graphmend(" trap , defer ");
+        assert CompileOptions().graphmend_disable == ["trap", "defer"];
+        assert gm_on is True;
+    } finally {
+        config_mod._config = old_config;
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_ctrl_flow.jac b/jac/tests/compiler/passes/test_graphmend_ctrl_flow.jac
new file mode 100644
index 0000000..4c85e81
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_ctrl_flow.jac
@@ -0,0 +1,905 @@
+"""Predicated control flow: rewrite shapes and per-condition declines."""
+import os;
+import tempfile;
+import from tests.support {
+    graphmend_break_kinds as _break_kinds,
+    graphmend_compile_path as _compile_path,
+    graphmend_pysrc as _pysrc
+}
+
+"""A Python-source model with data-dependent return branches.
+
+Written to a temp file at test time rather than checked in as a .py fixture:
+the repository does not accept new Python files, and the point of the fixture
+is only that GraphMend ingests .py source, which a generated file exercises
+just as well."""
+glob PY_WHERE_SRC = '''
+import torch
+
+
+@torch.compile()
+def f(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+    x = a / (torch.abs(a) + 1)
+    if b.sum() < 0:
+        return x * (b * -1)
+    else:
+        return x * (b * -2)
+''';
+
+"""Compile the generated .py model above and return its Python lowering."""
+def _py_fixture_src(gm: bool) -> str {
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, "py_where_return.py");
+        with open(path, "w") as fh {
+            fh.write(PY_WHERE_SRC);
+        }
+        return _compile_path(path, gm);
+    }
+}
+
+"""Qwen-Audio-Chat's audio-fusion guard, from `QWenModel.forward`.
+
+Kept verbatim in shape because it is the Table 2 row that separates the two
+rules. [Where] must refuse it: the true branch dereferences `audio_info`, which
+is None on exactly the runs the false branch serves, and it yields a Python list
+of per-segment tensors against a `None` false operand. [Precond] carries it
+instead, because that same dereference happens on every path through the branch
+before any observable effect, which makes `audio_info is not None` a necessary
+condition of reaching the end of the branch."""
+glob PY_AUDIO_FUSION_SRC = '''
+import torch
+from typing import Dict
+
+
+class M(torch.nn.Module):
+    def forward(self, input_ids, past_key_values=None, audio_info=None):
+        if past_key_values is None and torch.any(input_ids == self.start_id):
+            bos_pos = torch.where(input_ids == self.start_id)
+            eos_pos = torch.where(input_ids == self.start_id + 1)
+            audio_pos = torch.stack((bos_pos[0], bos_pos[1], eos_pos[1]), dim=1)
+            if isinstance(audio_info, Dict):
+                audios = self.audio.encode(audio_info["input_audios"])
+            else:
+                audios = torch.concat([a["input_audios"] for a in audio_info])
+        else:
+            audios = None
+        return audios
+''';
+
+"""A model whose torch import sits behind an availability guard."""
+glob PY_GUARDED_IMPORT_SRC = '''
+def _avail():
+    return True
+
+
+if _avail():
+    import torch
+
+
+def _compute_long(config, device, **rope_kwargs):
+    if len(rope_kwargs) > 0:
+        raise ValueError("Unexpected arguments: `**rope_kwargs` should be unset")
+    return torch.arange(0, 8).float().to(device)
+
+
+ROPE_INIT_FUNCTIONS = {"long": _compute_long}
+
+
+@torch.compile()
+def update(self_obj, position_ids, device):
+    seq_len = torch.max(position_ids) + 1
+    if seq_len > 8:
+        if not hasattr(self_obj, "long_inv_freq"):
+            self_obj.long_inv_freq = self_obj.rope_init_fn(self_obj.config, device)
+        self_obj.register_buffer("inv_freq", self_obj.long_inv_freq, persistent=False)
+    else:
+        self_obj.original_inv_freq = self_obj.original_inv_freq.to(device)
+        self_obj.register_buffer("inv_freq", self_obj.original_inv_freq, persistent=False)
+    return self_obj.inv_freq
+''';
+
+"""Write a .py model to a temp file and return its generated Python source."""
+def _compile_path_of_py(src: str, name: str) -> str {
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, name);
+        with open(path, "w") as fh {
+            fh.write(src);
+        }
+        return _compile_path(path, True);
+    }
+}
+
+"""The same, with the graphmend transforms off."""
+def _compile_path_of_py_off(src: str, name: str) -> str {
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, name);
+        with open(path, "w") as fh {
+            fh.write(src);
+        }
+        return _compile_path(path, False);
+    }
+}
+
+"""Import torch or skip the calling test."""
+def _torch -> any {
+    try {
+        import torch;
+        return torch;
+    } except ImportError {
+        testskip("torch not installed");
+    }
+}
+
+"""Compile a fixture and exec its generated Python with @torch.compile inert.
+
+The caller drives the raw function through a counting backend itself, exactly
+as test_graphmend_where_integration does."""
+def _exec_fixture(fixture: str, gm: bool) -> dict {
+    torch = _torch();
+    src = _pysrc(fixture, gm);
+    ns: dict = {};
+    orig_compile = torch.compile;
+    def _shim(*a: any, **k: any) -> any {
+        if a {
+            return a[0];
+        }
+        def _wrap(fn: any) -> any {
+            return fn;
+        }
+        return _wrap;
+    }
+    torch.compile = _shim;
+    try {
+        exec(compile(src, fixture, "exec"), ns);
+    } finally {
+        torch.compile = orig_compile;
+    }
+    return ns;
+}
