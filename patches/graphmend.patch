diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/guard_attr_escapes.jac b/jac/tests/compiler/passes/fixtures/graphmend/guard_attr_escapes.jac
new file mode 100644
index 0000000..dc52de2
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/guard_attr_escapes.jac
@@ -0,0 +1,27 @@
+"""Soundness: a well-formed existence-guarded init whose attribute is ALSO read
+outside the rewritten region. Hoisting creates `long_inv_freq` on runs where the
+original never would, and that other reader can observe the difference, so
+GraphMend must DECLINE. Contrast with where_multi_stmt.jac, where the attribute
+is confined to the region."""
+import torch;
+
+def peek(self_obj: any) -> any {
+    return hasattr(self_obj, "long_inv_freq");
+}
+
+@torch.compile()
+def f(self_obj: any, position_ids: any, device: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if (seq_len > 8) {
+        if not hasattr(self_obj, "long_inv_freq") {
+            self_obj.long_inv_freq = self_obj.rope_init_fn(self_obj.config, device);
+        }
+        self_obj.register_buffer("inv_freq", self_obj.long_inv_freq, persistent=False);
+    } else {
+        self_obj.original_inv_freq = self_obj.original_inv_freq.to(device);
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/guard_body_effects.jac b/jac/tests/compiler/passes/fixtures/graphmend/guard_body_effects.jac
new file mode 100644
index 0000000..b5167ca
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/guard_body_effects.jac
@@ -0,0 +1,22 @@
+"""Soundness: an existence-guarded init whose body carries observable effects
+beyond the memoizing write (console output, a list mutation). Even though the
+guard key matches the memoized attribute, those effects would fire on runs where
+the original program never entered the branch, so GraphMend must DECLINE."""
+import torch;
+
+@torch.compile()
+def f(self_obj: any, position_ids: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if (seq_len > 8) {
+        if not hasattr(self_obj, "cache") {
+            self_obj.log.append("init");
+            self_obj.cache = self_obj.build();
+        }
+        self_obj.register_buffer("inv_freq", self_obj.cache, persistent=False);
+    } else {
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/guard_compare_unproven.jac b/jac/tests/compiler/passes/fixtures/graphmend/guard_compare_unproven.jac
