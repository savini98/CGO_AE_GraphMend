+++ b/jac/tests/compiler/passes/fixtures/graphmend/where_update_impure_body.jac
@@ -0,0 +1,18 @@
+"""Soundness: torch.where evaluates the true operand on every run, so a body
+value the pass cannot prove pure would print on runs the original never took.
+GraphMend must DECLINE."""
+import torch;
+
+def audit(v: any) -> any {
+    print("clamped");
+    return v;
+}
+
+@torch.compile()
+def f(x: any) -> any {
+    out = x * 1;
+    if (torch.isnan(x).any()) {
+        out = audit(x * 2);
+    }
+    return out;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_update_late_local.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_update_late_local.jac
