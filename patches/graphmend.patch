+"""A Python-source model with a tensor-bool validation guard.
+
+Written to a temp file at test time rather than checked in as a .py fixture:
+the repository does not accept new Python files, and the point of the fixture
+is only that GraphMend ingests .py source, which a generated file exercises
+just as well."""
+glob PY_VAL_GUARD_SRC = '''
+import torch
+
+
+@torch.compile()
+def f(x, mask: torch.Tensor):
+    x = torch.relu(x)
+    if not mask.all():
+        raise ValueError("mask must be all true")
+    return torch.sin(x) * 2.0
+''';
+
+"""A .py model whose guard receiver is only declared two call hops up.
+
+`shapes` is unannotated where the guard reads it, and it is reached through a
+plain attribute and then an nn.ModuleList dispatch, which is how a real
+attention stack binds it. Written as .py rather than .jac because the
+`shapes[:, 0]` spelling is a Python subscript the Jac grammar does not take,
+and it is the spelling the shape actually appears in."""
+glob PY_PARAM_CHAIN_SRC = '''
+import torch
+from torch import nn
+
+
+class InnerAttn(nn.Module):
+    def forward(self, x, shapes=None):
+        if (shapes[:, 0] * shapes[:, 1]).sum() != 4:
+            raise ValueError("shapes must cover four positions")
+        return torch.sin(x)
+
+
+class MidLayer(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.attn = InnerAttn()
+
+    def forward(self, x, shapes=None):
+        return self.attn(x, shapes=shapes)
+
+
+class OuterStack(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.layers = nn.ModuleList([MidLayer()])
+
+    def forward(self, x, shapes: torch.Tensor = None):
+        for layer in self.layers:
+            x = layer(x, shapes=shapes)
+        return x
+
+
+compiled_stack = torch.compile(OuterStack())
+''';
+
+"""The same chain with its top removed: nothing calls MidLayer.forward, so
+nothing declares `shapes` and the walk has no evidence to terminate on."""
+glob PY_PARAM_OPEN_SRC = '''
+import torch
+from torch import nn
+
+
+class InnerAttn(nn.Module):
+    def forward(self, x, shapes=None):
+        if (shapes[:, 0] * shapes[:, 1]).sum() != 4:
+            raise ValueError("shapes must cover four positions")
+        return torch.sin(x)
+
+
+class MidLayer(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.attn = InnerAttn()
+
+    def forward(self, x, shapes=None):
+        return self.attn(x, shapes=shapes)
+
+
+compiled_loose = torch.compile(MidLayer())
+''';
