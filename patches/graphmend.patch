--- /dev/null
+++ b/jac/jaclang/compiler/passes/graphmend/impl/predicate_ctrl_flow_pass.legality.impl.jac
@@ -0,0 +1,1083 @@
+import from jaclang.compiler.tools.unparse_pass { unparse_node }
+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.passes.graphmend.ast_edit { split_params_keyed }
+import from jaclang.compiler.passes.graphmend.scope_facts {
+    attr_annotation,
+    attr_dict_kind,
+    find_class,
+    lexical_ability,
+    module_imports_plain,
+    param_annotation,
+    param_names,
+    self_attr_name,
+    wrapping_classes
+}
+import from jaclang.compiler.passes.graphmend.torch_attr_table {
+    cond_is_data_dependent,
+    cond_materializes_scalar,
+    symbol_is_builtin
+}
+import from jaclang.compiler.frontend.constant { SymbolType }
+import from jaclang.compiler.passes.sym_resolve { symbol_ability }
+
+impl PredicateCtrlFlowPass._setups_safe(
+    setups: Sequence[uni.CodeBlockStmt], region: uni.IfStmt
+) -> bool {
+    for s in setups {
+        if isinstance(s, (uni.ReturnStmt, uni.RaiseStmt, uni.CtrlStmt))
+            or s.get_all_sub_nodes(uni.ReturnStmt)
+            or s.get_all_sub_nodes(uni.RaiseStmt)
+            or s.get_all_sub_nodes(uni.CtrlStmt)
+            or (not self._effect_neutral(s, region)) {
+            return False;
+        }
+    }
+    return True;
+}
+
+impl PredicateCtrlFlowPass._static_and_prefix(
+    cond: uni.Expr
+) -> tuple[(uni.Expr | None), (uni.Expr | None)] {
+    e = self._unwrap_expr(cond);
+    if (self._bool_join(e) != 'and') or (not isinstance(e, uni.BoolExpr)) {
+        return (None, e);
+    }
+    vals = [self._unwrap_expr(v) for v in e.values];
+    i = 0;
+    while (i < len(vals)) and (not cond_is_data_dependent(vals[i])) {
+        i += 1;
+    }
+    if i == len(vals) {
+        return (None, None);
+    }
+    if i == 0 {
+        return (None, e);
+    }
+    if (i != 1) or (len(vals) != 2) {
+        return (None, None);
+    }
+    return (vals[0], vals[1]);
+}
+
+impl PredicateCtrlFlowPass._tensor_bool_atom(e: uni.Expr) -> bool {
+    t = e.target if isinstance(e, uni.FuncCall) else None;
+    if isinstance(e, uni.FuncCall)
+        and (not (e.params or []))
+        and isinstance(t, uni.AtomTrailer)
+        and isinstance(t.right, uni.Name)
+        and (t.right.value in _TENSOR_BOOL_REDUCERS)
+        and self._pure_receiver(t.target) {
+        return True;
+    }
+    return cond_is_data_dependent(e) and (not cond_materializes_scalar(e));
+}
+
+impl PredicateCtrlFlowPass._pure_value(v: uni.Expr) -> bool {
+    calls = ([v] if isinstance(v, uni.FuncCall) else [])
+        + list(v.get_all_sub_nodes(uni.FuncCall));
+    for c in calls {
+        if self._pure_callee(c.target) {
+            continue;
+        }
+        if self._call_speculatable(c) {
+            continue;
+        }
+        return False;
+    }
+    return True;
+}
+
+impl PredicateCtrlFlowPass._update_targets(nd: uni.IfStmt) -> (list | None) {
+    if nd.find_parent_of_type(uni.Ability) is None {
+        return None;
+    }
+    out: list = [];
+    for s in (nd.body or []) {
+        if (not isinstance(s, uni.Assignment))
+            or (s.aug_op is not None)
+            or (len(s.target) != 1) {
+            return None;
+        }
+        tgt = s.target[0];
+        v = s.value;
+        if (not isinstance(tgt, uni.Name)) or (not isinstance(v, uni.Expr)) {
+            return None;
+        }
+        if s.get_all_sub_nodes(uni.YieldExpr)
+            or s.get_all_sub_nodes(uni.Assignment)
+            or s.get_all_sub_nodes(uni.ReturnStmt)
+            or s.get_all_sub_nodes(uni.RaiseStmt)
+            or s.get_all_sub_nodes(uni.CtrlStmt) {
+            return None;
+        }
+        if not self._pure_value(v) {
+            return None;
+        }
+        if self._bound_before(nd, tgt.value) {
+            if self._has_none(v, v) or self._provably_non_tensor(v) {
+                return None;
+            }
+            if not self._incoming_selectable(nd, tgt.value) {
+                return None;
+            }
+            out.append((s, tgt, v));
+        } elif self._all_local_targets([tgt], nd) {
+            out.append((s, None, v));
+        } else {
+            return None;
+        }
+    }
+    return out if out else None;
+}
+
+impl PredicateCtrlFlowPass._torch_bound(nd: uni.IfStmt) -> bool {
+    mod = nd.find_parent_of_type(uni.Module);
+    return (mod is not None) and module_imports_plain(mod, 'torch');
+}
+
+impl PredicateCtrlFlowPass._incoming_selectable(nd: uni.IfStmt, name: str) -> bool {
+    scope = nd.find_parent_of_type(uni.Ability);
+    if scope is None {
+        return False;
+    }
+    cur: (uni.UniNode | None) = nd;
+    while (cur is not None) and (cur is not scope) {
+        if isinstance(cur, uni.IfStmt) and self._none_tested(cur.condition, name) {
+            return False;
+        }
+        cur = cur.parent;
+    }
+    cur = nd;
+    while (cur is not None) and (cur is not scope) {
+        p = cur.parent;
+        if p is None {
+            return False;
+        }
+        holder: any = p;
+        b = holder?.body;
+        if isinstance(b, list) and (cur in b) {
+            for s in reversed(b[:b.index(cur)]) {
+                if not isinstance(s, uni.Assignment) {
+                    continue;
+                }
+                for t in (s.target or []) {
+                    if (not isinstance(t, uni.Name)) or (t.value != name) {
+                        continue;
+                    }
+                    v = s.value;
+                    return isinstance(v, uni.Expr)
+                        and (not self._has_none(v, v))
+                        and (not self._provably_non_tensor(v));
+                }
+            }
+        }
+        cur = p;
+    }
+    return self._param_default_selectable(scope, name);
+}
+
+impl PredicateCtrlFlowPass._param_default_selectable(
+    fn: uni.Ability, name: str
+) -> bool {
+    sig = fn.signature;
+    if not isinstance(sig, uni.FuncSignature) {
+        return False;
+    }
+    for prm in (sig.get_parameters() or []) {
+        if (prm?.name is None) or (prm.name.value != name) {
+            continue;
+        }
+        d = prm.value;
+        if d is None {
+            return True;
+        }
+        return (not self._has_none(d, d)) and (not self._provably_non_tensor(d));
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._none_tested(c: (uni.Expr | None), name: str) -> bool {
+    if c is None {
+        return False;
+    }
+    cmps = ([c] if isinstance(c, uni.CompareExpr) else [])
+        + list(c.get_all_sub_nodes(uni.CompareExpr));
+    for cmp in cmps {
+        sides = [cmp.left] + list(cmp.rights or []);
+        named = False;
+        nulled = False;
+        for side in sides {
+            inner = self._unwrap_expr(side);
+            if isinstance(inner, uni.Name) and (inner.value == name) {
+                named = True;
+            }
+            if isinstance(inner, uni.Null) {
+                nulled = True;
+            }
+        }
+        if named and nulled {
+            return True;
+        }
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._bound_before(nd: uni.IfStmt, name: str) -> bool {
+    scope = nd.find_parent_of_type(uni.Ability);
+    if scope is None {
+        return False;
+    }
+    if name in param_names(scope) {
+        return True;
+    }
+    cur: (uni.UniNode | None) = nd;
+    while (cur is not None) and (cur is not scope) {
+        p = cur.parent;
+        if p is None {
+            return False;
+        }
+        holder: any = p;
+        b = holder?.body;
+        if isinstance(b, list) and (cur in b) {
+            for s in b[:b.index(cur)] {
+                if not isinstance(s, uni.Assignment) {
+                    continue;
+                }
+                for t in (s.target or []) {
+                    if isinstance(t, uni.Name) and (t.value == name) {
+                        return True;
+                    }
+                }
+            }
+        }
+        cur = p;
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._effect_neutral(s: uni.UniNode, region: uni.IfStmt) -> bool {
+    if self._is_assert_async(s) {
+        return True;
+    }
+    if self._is_existence_guard(s, region) {
+        return True;
+    }
+    if isinstance(s, uni.Assignment) {
+        return self._assignment_neutral(s, region);
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._is_existence_guard(
+    s: uni.UniNode, region: uni.IfStmt
+) -> bool {
+    if not isinstance(s, uni.IfStmt) {
+        return False;
+    }
+    if s.else_body is not None {
+        return False;
+    }
+    keyed = self._hasattr_key(s.condition);
+    if keyed is None {
+        return False;
+    }
+    (recv, key) = keyed;
+    memoized = False;
+    for st in (s.body or []) {
+        if not isinstance(st, uni.Assignment) {
+            return False;
+        }
+        if self._writes_attr(st, recv, key) {
+            if not self._init_value_safe(st.value) {
+                return False;
+            }
+            memoized = True;
+            continue;
+        }
+        if not self._assignment_neutral(st, region) {
+            return False;
+        }
+    }
+    if not memoized {
+        return False;
+    }
+    return self._attr_confined(region, key);
+}
+
+impl PredicateCtrlFlowPass._init_value_safe(
+    v: (uni.Expr | uni.YieldExpr | None)
+) -> bool {
+    if v is None {
+        return False;
+    }
+    calls = ([v] if isinstance(v, uni.FuncCall) else [])
+        + list(v.get_all_sub_nodes(uni.FuncCall));
+    for c in calls {
+        if not self._call_speculatable(c) {
+            return False;
+        }
+    }
+    return True;
+}
+
+impl PredicateCtrlFlowPass._call_speculatable(c: uni.FuncCall) -> bool {
+    mod = c.find_parent_of_type(uni.Module);
+    if mod is None {
+        return False;
+    }
+    t = c.target;
+    if isinstance(t, uni.Name) {
+        fn = lexical_ability(c.find_parent_of_type(uni.Ability), t.value);
+        if fn is None {
+            fn = self._module_fn(mod, t.value);
+        }
+        if fn is None {
+            return False;
+        }
+        return self._body_pure_nonraising(fn, c, None, self._callsite_ctx(fn, c));
+    }
+    if isinstance(t, uni.AtomTrailer) and isinstance(t.right, uni.Name) {
+        cands = [
+            fn
+            for fn in self._dispatch_table_fns(mod)
+            if self._signature_accepts(fn, c)
+        ];
+        if not cands {
+            return False;
+        }
+        for fn in cands {
+            if not self._body_pure_nonraising(fn, c, None, self._callsite_ctx(fn, c)) {
+                return False;
+            }
+        }
+        return True;
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._signature_accepts(
+    fn: uni.Ability, c: uni.FuncCall
+) -> bool {
+    sig = fn.signature;
+    if (sig is None) or (not isinstance(sig, uni.FuncSignature)) {
+        return False;
+    }
+    named = param_names(fn);
+    n_pos = 0;
+    for prm in (c.params or []) {
+        if isinstance(prm, uni.KWPair) and (prm.key is not None) {
+            if (prm.key.sym_name not in named) and (self._varkw_name(fn) is None) {
+                return False;
+            }
+        } else {
+            n_pos += 1;
+        }
+    }
+    capacity = len(named) + (1 if sig.varargs is not None else 0);
+    return n_pos <= capacity;
+}
+
+impl PredicateCtrlFlowPass._module_fn(
+    mod: uni.Module, name: str
+) -> (uni.Ability | None) {
+    return symbol_ability(mod.lookup(name, deep=False));
+}
+
+impl PredicateCtrlFlowPass._dispatch_table_fns(mod: uni.Module) -> list[uni.Ability] {
+    out: list[uni.Ability] = [];
+    for a in mod.get_all_sub_nodes(uni.Assignment) {
+        d = a.value;
+        if not isinstance(d, uni.DictVal) {
+            continue;
+        }
+        fns: list[uni.Ability] = [];
+        ok = len(d.kv_pairs or []) > 0;
+        for kv in (d.kv_pairs or []) {
+            val = kv.value;
+            fn = None;
+            if isinstance(val, uni.Name) {
+                fn = self._module_fn(mod, val.value);
+            }
+            if fn is None {
+                ok = False;
+                break;
+            }
+            fns.append(fn);
+        }
+        if ok {
+            out.extend(fns);
+        }
+    }
+    return out;
+}
+
+impl PredicateCtrlFlowPass._body_pure_nonraising(
+    fn: uni.Ability,
+    c: uni.FuncCall,
+    seen: (set[int] | None) = None,
+    ctx: (dict[str, list[uni.Archetype]] | None) = None
+) -> bool {
+    marks = seen if seen is not None else set();
+    if id(fn) in marks {
+        return False;
+    }
+    marks.add(id(fn));
+    varkw = self._varkw_name(fn);
+    extra_kw = self._passes_extra_kwargs(fn, c);
+    raise_calls: set[int] = set();
+    for r in fn.get_all_sub_nodes(uni.RaiseStmt) {
+        if (varkw is None) or extra_kw or (not self._guarded_by_varkw(r, varkw, fn)) {
+            return False;
+        }
+        for rc in r.get_all_sub_nodes(uni.FuncCall) {
+            raise_calls.add(id(rc));
+        }
+    }
+    mod = fn.find_parent_of_type(uni.Module);
+    if self._impure_writes(fn, mod) {
+        return False;
+    }
+    for call in fn.get_all_sub_nodes(uni.FuncCall) {
+        if id(call) in raise_calls {
+            continue;
+        }
+        if self._pure_callee(call.target) {
+            continue;
+        }
+        if (ctx is not None) and self._ctx_dict_get(call, ctx) {
+            continue;
+        }
+        if self._witnessed_dict_get(call, fn) {
+            continue;
+        }
+        t = call.target;
+        if isinstance(t, uni.AtomTrailer)
+            and isinstance(t.right, uni.Name)
+            and (t.right.value in _PURE_TENSOR_METHODS)
+            and isinstance(t.target, uni.FuncCall) {
+            continue;
+        }
+        local = None;
+        if isinstance(t, uni.Name) {
+            local = lexical_ability(fn, t.value);
+            if (local is None) and (mod is not None) {
+                local = self._module_fn(mod, t.value);
+            }
+        }
+        if (local is None) or (not self._body_pure_nonraising(local, call, marks)) {
+            return False;
+        }
+    }
+    marks.discard(id(fn));
+    return True;
+}
+
+impl PredicateCtrlFlowPass._witnessed_dict_get(
+    call: uni.FuncCall, fn: uni.Ability
+) -> bool {
+    t = call.target;
+    if not (
+        isinstance(t, uni.AtomTrailer)
+        and isinstance(t.right, uni.Name)
+        and (t.right.value == 'get')
+    ) {
+        return False;
+    }
+    (pos, kw) = split_params_keyed(call.params);
+    if kw or (not pos) or (len(pos) > 2) {
+        return False;
+    }
+    for p in pos {
+        if self._has_call(p) {
+            return False;
+        }
+    }
+    recv = t.target;
+    if not isinstance(recv, uni.AtomTrailer) {
+        return False;
+    }
+    base: any = recv;
+    while isinstance(base, uni.AtomTrailer) {
+        base = base.target;
+    }
+    if (not isinstance(base, uni.Name)) or (base.value not in param_names(fn)) {
+        return False;
+    }
+    mod = fn.find_parent_of_type(uni.Module);
+    if mod is None {
+        return False;
+    }
+    return self._mapping_witnessed(mod, unparse_node(recv).replace(' ', ''));
+}
+
+impl PredicateCtrlFlowPass._mapping_witnessed(mod: uni.Module, key: str) -> bool {
+    for tr in mod.get_all_sub_nodes(uni.AtomTrailer) {
+        if isinstance(tr.right, uni.IndexSlice)
+            and (unparse_node(tr.target).replace(' ', '') == key) {
+            return True;
+        }
+    }
+    for cmp in mod.get_all_sub_nodes(uni.CompareExpr) {
+        for i in range(len(cmp.ops or [])) {
+            if (cmp.ops[i].value != 'in') or (i >= len(cmp.rights or [])) {
+                continue;
+            }
+            if unparse_node(cmp.rights[i]).replace(' ', '') == key {
+                return True;
+            }
+        }
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._impure_writes(
+    fn: uni.Ability, mod: (uni.Module | None)
+) -> bool {
+    outside = self._module_scope_names(mod) if mod is not None else set();
+    if fn.get_all_sub_nodes(uni.DeleteStmt) {
+        return True;
+    }
+    for a in fn.get_all_sub_nodes(uni.Assignment) {
+        for t in (a.target or []) {
+            targets = list(t.values) if isinstance(t, uni.TupleVal) else [t];
+            for tg in targets {
+                if not isinstance(tg, uni.Name) {
+                    return True;
+                }
+                if tg.value in outside {
+                    return True;
+                }
+            }
+        }
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._module_scope_names(mod: uni.Module) -> set[str] {
+    out: set[str] = set();
+    for (name, sym) in mod.names_in_scope.items() {
+        if (
+            (sym.sym_type in {SymbolType.VAR, SymbolType.MOD_VAR})
+            and (not sym.imported)
+        ) {
+            out.add(name);
+        }
+    }
+    return out;
+}
+
+impl PredicateCtrlFlowPass._callsite_ctx(
+    fn: uni.Ability, c: uni.FuncCall
+) -> dict[str, list[uni.Archetype]] {
+    sig = fn.signature;
+    if (sig is None) or (not isinstance(sig, uni.FuncSignature)) {
+        return {};
+    }
+    pnames = param_names(fn);
+    ctx: dict[str, list[uni.Archetype]] = {};
+    selfcls = self._self_classes(c);
+    i = 0;
+    for prm in (c.params or []) {
+        if isinstance(prm, uni.KWPair) {
+            continue;
+        }
+        if i >= len(pnames) {
+            break;
+        }
+        classes = self._arg_classes(prm, c, selfcls);
+        if classes {
+            ctx[pnames[i]] = classes;
+        }
+        i += 1;
+    }
+    return ctx;
+}
+
+impl PredicateCtrlFlowPass._arg_classes(
+    arg: uni.Expr, c: uni.FuncCall, selfcls: list[uni.Archetype]
+) -> list[uni.Archetype] {
+    mod = c.find_parent_of_type(uni.Module);
+    if mod is None {
+        return [];
+    }
+    if isinstance(arg, uni.Name) {
+        site = c.find_parent_of_type(uni.Ability);
+        if site is None {
+            return [];
+        }
+        ann = param_annotation(site, arg.value);
+        if isinstance(ann, uni.Name) {
+            cls = find_class(mod, ann.value, self.prog, self._mat_seen);
+            return [cls] if (cls is not None) else [];
+        }
+        return [];
+    }
+    attr = self_attr_name(arg);
+    if attr is None {
+        return [];
+    }
+    out: list[uni.Archetype] = [];
+    for k in selfcls {
+        ann_name = attr_annotation(k, attr);
+        if ann_name is None {
+            return [];
+        }
+        kmod = k.find_parent_of_type(uni.Module);
+        if kmod is None {
+            return [];
+        }
+        cls = find_class(kmod, ann_name, self.prog, self._mat_seen);
+        if cls is None {
+            return [];
+        }
+        if cls not in out {
+            out.append(cls);
+        }
+    }
+    return out;
+}
+
+impl PredicateCtrlFlowPass._self_classes(c: uni.FuncCall) -> list[uni.Archetype] {
+    inner = c.find_parent_of_type(uni.Ability);
+    if inner is None {
+        return [];
+    }
+    outer: uni.Ability = inner;
+    cur = outer.find_parent_of_type(uni.Ability);
+    while cur is not None {
+        outer = cur;
+        cur = outer.find_parent_of_type(uni.Ability);
+    }
+    if outer is inner {
+        return [];
+    }
+    sig = inner.signature;
+    if not isinstance(sig, uni.FuncSignature) {
+        return [];
+    }
+    params = sig.get_parameters() or [];
+    if (not params) or (params[0]?.name is None) or (params[0].name.value != 'self') {
+        return [];
+    }
+    mod = c.find_parent_of_type(uni.Module);
+    if mod is None {
+        return [];
+    }
+    return wrapping_classes(self.prog, mod, outer.sym_name);
+}
+
+impl PredicateCtrlFlowPass._ctx_dict_get(
+    call: uni.FuncCall, ctx: dict[str, list[uni.Archetype]]
+) -> bool {
+    t = call.target;
+    if not (
+        isinstance(t, uni.AtomTrailer)
+        and isinstance(t.right, uni.Name)
+        and (t.right.value == 'get')
+    ) {
+        return False;
+    }
+    recv = t.target;
+    if not (
+        isinstance(recv, uni.AtomTrailer)
+        and isinstance(recv.right, uni.Name)
+        and isinstance(recv.target, uni.Name)
+    ) {
+        return False;
+    }
+    classes = ctx.get(recv.target.value, []);
+    if not classes {
+        return False;
+    }
+    for k in classes {
+        kind = attr_dict_kind(k, recv.right.value);
+        if kind not in ('dict', 'dict_or_none') {
+            return False;
+        }
+    }
+    return True;
+}
+
+impl PredicateCtrlFlowPass._hasattr_key(c: uni.Expr) -> (tuple[str, str] | None) {
+    if (not isinstance(c, uni.UnaryExpr)) or (c.op is None) or (c.op.value != 'not') {
+        return None;
+    }
+    inner = c.operand;
+    if not (
+        isinstance(inner, uni.FuncCall)
+        and isinstance(inner.target, uni.Name)
+        and (inner.target.value == 'hasattr')
+    ) {
+        return None;
+    }
+    params = list(inner.params or []);
+    if len(params) != 2 {
+        return None;
+    }
+    (recv, key) = (params[0], params[1]);
+    if isinstance(recv, uni.KWPair)
+        or (not isinstance(key, (uni.String, uni.MultiString))) {
+        return None;
+    }
+    lit = key.lit_value;
+    if not isinstance(lit, str) {
+        return None;
+    }
+    return (unparse_node(recv).replace(' ', ''), lit);
+}
+
+impl PredicateCtrlFlowPass._writes_attr(
+    s: uni.Assignment, recv: str, key: str
+) -> bool {
+    for t in (s.target or []) {
+        targets = list(t.values) if isinstance(t, uni.TupleVal) else [t];
+        for tg in targets {
+            if (
+                isinstance(tg, uni.AtomTrailer)
+                and isinstance(tg.right, uni.Name)
+                and (tg.right.value == key)
+                and (unparse_node(tg.target).replace(' ', '') == recv)
+            ) {
+                return True;
+            }
+        }
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._attr_confined(region: uni.IfStmt, key: str) -> bool {
+    mod = region.find_parent_of_type(uni.Module);
+    if mod is None {
+        return False;
+    }
+    for at in mod.get_all_sub_nodes(uni.AtomTrailer) {
+        if (
+            isinstance(at.right, uni.Name)
+            and (at.right.value == key)
+            and (not self._within(at, region))
+        ) {
+            return False;
+        }
+    }
+    for st in mod.get_all_sub_nodes(uni.String) {
+        if (st.lit_value == key) and (not self._within(st, region)) {
+            return False;
+        }
+    }
+    for ms in mod.get_all_sub_nodes(uni.MultiString) {
+        if (ms.lit_value == key) and (not self._within(ms, region)) {
+            return False;
+        }
+    }
+    return True;
+}
+
+impl PredicateCtrlFlowPass._within(nd: uni.UniNode, anc: uni.UniNode) -> bool {
+    cur: (uni.UniNode | None) = nd;
+    while cur is not None {
+        if cur is anc {
+            return True;
+        }
+        cur = cur.parent;
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._varkw_name(fn: uni.Ability) -> (str | None) {
+    sig = fn.signature;
+    if (sig is None) or (not isinstance(sig, uni.FuncSignature)) {
+        return None;
+    }
+    kw = sig.kwargs;
+    if (kw is None) or (kw.name is None) {
+        return None;
+    }
+    return kw.name.value;
+}
+
+impl PredicateCtrlFlowPass._passes_extra_kwargs(
+    fn: uni.Ability, c: uni.FuncCall
+) -> bool {
+    sig = fn.signature;
+    if (sig is None) or (not isinstance(sig, uni.FuncSignature)) {
+        return True;
+    }
+    named = param_names(fn);
+    for prm in (c.params or []) {
+        if isinstance(prm, uni.KWPair) and (prm.key is not None) {
+            if prm.key.sym_name not in named {
+                return True;
+            }
+        }
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._guarded_by_varkw(
+    r: uni.RaiseStmt, varkw: str, fn: uni.Ability
+) -> bool {
+    cur = r.parent;
+    while (cur is not None) and (cur is not fn) {
+        if isinstance(cur, uni.IfStmt) {
+            if self._mentions_name(cur.condition, varkw) {
+                return True;
+            }
+        }
+        cur = cur.parent;
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._mentions_name(e: (uni.Expr | None), nm: str) -> bool {
+    if e is None {
+        return False;
+    }
+    if isinstance(e, uni.Name) and (e.value == nm) {
+        return True;
+    }
+    for n in e.get_all_sub_nodes(uni.Name) {
+        if n.value == nm {
+            return True;
+        }
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._pure_callee(t: (uni.Expr | None)) -> bool {
+    if t is None {
+        return False;
+    }
+    if isinstance(t, uni.Name) {
+        return (t.value in _PURE_BUILTINS)
+            and ((t.sym is None) or symbol_is_builtin(t.sym));
+    }
+    if isinstance(t, uni.AtomTrailer) {
+        base = t.target;
+        while isinstance(base, uni.AtomTrailer) {
+            base = base.target;
+        }
+        if isinstance(base, uni.Name)
+            and (base.value in {'torch', 'math'})
+            and isinstance(t.right, uni.Name)
+            and (t.right.value in _PURE_TORCH_FNS) {
+            return self._pure_root(base);
+        }
+        return isinstance(t.right, uni.Name)
+            and (t.right.value in _PURE_TENSOR_METHODS)
+            and self._pure_receiver(t.target);
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._pure_receiver(recv: (uni.Expr | None)) -> bool {
+    return isinstance(recv, uni.FuncCall) and self._pure_callee(recv.target);
+}
+
+impl PredicateCtrlFlowPass._pure_root(base: uni.Name) -> bool {
+    sym = base.sym;
+    if sym is not None {
+        if sym.decl is None {
+            return False;
+        }
+        mp = sym.decl.find_parent_of_type(uni.ModulePath);
+        if mp is None {
+            return False;
+        }
+        return mp.dot_path_str == base.value;
+    }
+    mod = base.find_parent_of_type(uni.Module);
+    if mod is None {
+        return False;
+    }
+    return module_imports_plain(mod, base.value);
+}
+
+impl PredicateCtrlFlowPass._assignment_neutral(
+    s: uni.Assignment, region: uni.IfStmt
+) -> bool {
+    if self._is_device_move(s) {
+        return self._move_consumed(s, region) and self._consumers_harmless(s, region);
+    }
+    return (
+        (s.value is not None)
+        and (not self._has_call(s.value))
+        and self._all_local_targets(s.target, region)
+    );
+}
+
+impl PredicateCtrlFlowPass._is_device_move(s: uni.Assignment) -> bool {
+    v = s.value;
+    if (v is None) or (len(s.target) != 1) {
+        return False;
+    }
+    if not (
+        isinstance(v, uni.FuncCall)
+        and isinstance(v.target, uni.AtomTrailer)
+        and isinstance(v.target.right, uni.Name)
+        and (v.target.right.value == 'to')
+    ) {
+        return False;
+    }
+    recv = v.target.target;
+    return (
+        unparse_node(recv).replace(' ', '')
+        == unparse_node(s.target[0]).replace(' ', '')
+    );
+}
+
+impl PredicateCtrlFlowPass._move_consumed(
+    s: uni.Assignment, region: uni.IfStmt
+) -> bool {
+    tgt = unparse_node(s.target[0]).replace(' ', '');
+    for at in region.get_all_sub_nodes(uni.AtomTrailer) {
+        if self._within(at, s) {
+            continue;
+        }
+        if unparse_node(at).replace(' ', '') == tgt {
+            return True;
+        }
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._consumers_harmless(
+    s: uni.Assignment, region: uni.IfStmt
+) -> bool {
+    tgt = unparse_node(s.target[0]).replace(' ', '');
+    mod = region.find_parent_of_type(uni.Module);
+    if mod is None {
+        return False;
+    }
+    region_ab = region.find_parent_of_type(uni.Ability);
+    checked: set[int] = set();
+    for at in mod.get_all_sub_nodes(uni.AtomTrailer) {
+        if unparse_node(at).replace(' ', '') != tgt {
+            continue;
+        }
+        if self._within(at, region) {
+            continue;
+        }
+        ab = at.find_parent_of_type(uni.Ability);
+        if (ab is None) or (ab is region_ab) {
+            return False;
+        }
+        if id(ab) in checked {
+            continue;
+        }
+        checked.add(id(ab));
+        if not self._normalizes_first(ab, tgt) {
+            return False;
+        }
+    }
+    return True;
+}
+
+impl PredicateCtrlFlowPass._normalizes_first(ab: uni.Ability, tgt: str) -> bool {
+    norms: list[tuple[int, int]] = [];
+    reads: list[uni.AtomTrailer] = [];
+    for at in ab.get_all_sub_nodes(uni.AtomTrailer) {
+        if unparse_node(at).replace(' ', '') != tgt {
+            continue;
+        }
+        cur: (uni.UniNode | None) = at;
+        while (cur is not None) and (not isinstance(cur, uni.Assignment)) {
+            cur = cur.parent;
+        }
+        if isinstance(cur, uni.Assignment)
+            and self._is_device_move(cur)
+            and (unparse_node(cur.target[0]).replace(' ', '') == tgt) {
+            spot = self._stmt_spot(cur);
+            if spot is not None {
+                norms.append(spot);
+            }
+            continue;
+        }
+        reads.append(at);
+    }
+    for m in reads {
+        chain = self._spot_chain(m);
+        ok = False;
+        for (cid, aidx) in norms {
+            midx = chain.get(cid);
+            if (midx is not None) and (aidx < midx) {
+                ok = True;
+                break;
+            }
+        }
+        if not ok {
+            return False;
+        }
+    }
+    return True;
+}
+
+impl PredicateCtrlFlowPass._stmt_spot(nd: uni.UniNode) -> (tuple[int, int] | None) {
+    spots = list(self._spot_chain(nd).items());
+    return spots[0] if spots else None;
+}
+
+impl PredicateCtrlFlowPass._spot_chain(nd: uni.UniNode) -> dict[int, int] {
+    out: dict[int, int] = {};
+    cur: (uni.UniNode | None) = nd;
+    while cur is not None {
+        p = cur.parent;
+        if p is None {
+            break;
+        }
+        holder: any = p;
+        b = holder?.body;
+        if isinstance(b, list) and (cur in b) {
+            out[id(p)] = b.index(cur);
+        }
+        cur = p;
+    }
+    return out;
+}
+
+impl PredicateCtrlFlowPass._all_local_targets(
+    targets: Sequence[uni.Expr], region: uni.IfStmt
+) -> bool {
+    scope: (uni.UniNode | None) = region.find_parent_of_type(uni.Ability);
+    if scope is None {
+        scope = region.find_parent_of_type(uni.Module);
+    }
+    if scope is None {
+        return False;
+    }
+    vals: set[str] = set();
+    for t in targets {
+        if not isinstance(t, uni.Name) {
+            return False;
+        }
+        vals.add(t.value);
+    }
+    if not vals {
+        return False;
+    }
+    mod = region.find_parent_of_type(uni.Module);
+    if (mod is not None) and (vals & self._module_scope_names(mod)) {
+        return False;
+    }
+    for n in scope.get_all_sub_nodes(uni.Name) {
+        if (n.value in vals) and (not self._within(n, region)) {
+            return False;
+        }
+    }
+    return True;
+}
+
+impl PredicateCtrlFlowPass._setup_writes(
+    setups: Sequence[uni.CodeBlockStmt]
+) -> set[str] {
+    out: set[str] = set();
+    for s in setups {
+        assigns = ([s] if isinstance(s, uni.Assignment) else [])
+            + list(s.get_all_sub_nodes(uni.Assignment));
+        for a in assigns {
+            for t in (a.target or []) {
+                out.add(unparse_node(t).replace(' ', ''));
+            }
+        }
+    }
+    return out;
+}
diff --git a/mod_jac/jaclang/compiler/passes/graphmend/impl/predicate_ctrl_flow_pass.precond.impl.jac b/jac/jaclang/compiler/passes/graphmend/impl/predicate_ctrl_flow_pass.precond.impl.jac
new file mode 100644
index 0000000..fc958a9
--- /dev/null
+++ b/jac/jaclang/compiler/passes/graphmend/impl/predicate_ctrl_flow_pass.precond.impl.jac
@@ -0,0 +1,517 @@
+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.frontend.constant { Tokens as Tok }
+import from jaclang.compiler.passes.graphmend.ast_edit {
+    gen_name,
+    gen_null,
+    gen_token
+}
+import from jaclang.compiler.passes.graphmend.scope_facts { param_names }
+import from jaclang.compiler.passes.graphmend.torch_attr_table { symbol_is_builtin }
+
+impl PredicateCtrlFlowPass._strengthen_guard(nd: uni.IfStmt) -> None {
+    fn = nd.find_parent_of_type(uni.Ability);
+    if (fn is None) or (not (nd.body or [])) {
+        return;
+    }
+    if self._in_try(nd, fn) or (not self._cond_effect_free(nd.condition)) {
+        return;
+    }
+    for n in nd.get_all_sub_nodes(uni.Name) {
+        if n.value.startswith('__gm_') {
+            return;
+        }
+    }
+    for name in self._optional_params(fn) {
+        if self._mentions_name(nd.condition, name)
+            or (not self._never_rebound(fn, name))
+            or (self._seq_scan(nd.body, name) != _SCAN_FATAL) {
+            continue;
+        }
+        self._prepend_conjunct(nd, name);
+        return;
+    }
+}
+
+impl PredicateCtrlFlowPass._cond_effect_free(cond: uni.Expr) -> bool {
+    return self._expr_scan(cond, '') == _SCAN_CLEAN;
+}
+
+impl PredicateCtrlFlowPass._optional_params(fn: uni.Ability) -> list[str] {
+    sig = fn.signature;
+    if not isinstance(sig, uni.FuncSignature) {
+        return [];
+    }
+    out: list[str] = [];
+    for prm in (sig.get_parameters() or []) {
+        d = prm.value;
+        if (prm?.name is None) or prm.is_vararg or prm.is_kwargs or (d is None) {
+            continue;
+        }
+        if isinstance(self._unwrap_expr(d), uni.Null) {
+            out.append(prm.name.value);
+        }
+    }
+    return out;
+}
+
+impl PredicateCtrlFlowPass._never_rebound(fn: uni.Ability, name: str) -> bool {
+    if name not in param_names(fn) {
+        return False;
+    }
+    if fn.get_all_sub_nodes(uni.MatchStmt) {
+        return False;
+    }
+    for a in fn.get_all_sub_nodes(uni.Assignment) {
+        if self._names_bound(a.target or [], name) {
+            return False;
+        }
+    }
+    for b in fn.get_all_sub_nodes(uni.BinaryExpr) {
+        op: any = b.op;
+        if isinstance(op, uni.Token)
+            and (op.name == Tok.WALRUS_EQ)
+            and self._names_bound([b.left], name) {
+            return False;
+        }
+    }
+    for f in fn.get_all_sub_nodes(uni.InForStmt) {
+        if self._names_bound([f.target], name) {
+            return False;
+        }
+    }
+    for ic in fn.get_all_sub_nodes(uni.InnerCompr) {
+        if self._names_bound([ic.target], name) {
+            return False;
+        }
+    }
+    for w in fn.get_all_sub_nodes(uni.ExprAsItem) {
+        if (w.alias is not None) and self._names_bound([w.alias], name) {
+            return False;
+        }
+    }
+    for ex in fn.get_all_sub_nodes(uni.Except) {
+        if (ex.name is not None) and (ex.name.value == name) {
+            return False;
+        }
+    }
+    for d in fn.get_all_sub_nodes(uni.DeleteStmt) {
+        if self._mentions_name(d.target, name) {
+            return False;
+        }
+    }
+    return True;
+}
+
+impl PredicateCtrlFlowPass._names_bound(targets: Sequence[any], name: str) -> bool {
+    for t in (targets or []) {
+        cur: any = self._unwrap_expr(t) if isinstance(t, uni.Expr) else t;
+        if isinstance(cur, uni.UnaryExpr) {
+            cur = self._unwrap_expr(cur.operand);
+        }
+        if isinstance(cur, (uni.TupleVal, uni.ListVal)) {
+            if self._names_bound(list(cur.values or []), name) {
+                return True;
+            }
+            continue;
+        }
+        if isinstance(cur, uni.Name) and (cur.value == name) {
+            return True;
+        }
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._in_try(nd: uni.IfStmt, fn: uni.Ability) -> bool {
+    cur: (uni.UniNode | None) = nd;
+    while (cur is not None) and (cur is not fn) {
+        if isinstance(cur, uni.TryStmt) {
+            return True;
+        }
+        cur = cur.parent;
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._prepend_conjunct(nd: uni.IfStmt, name: str) -> None {
+    ref = gen_name(nd, name, False);
+    nul = gen_null(nd);
+    isn = gen_token(nd, Tok.KW_ISN.value, 'is not');
+    isnone = uni.CompareExpr(
+        left=ref, rights=[nul], ops=[isn], kid=[ref, isn, nul]
+    );
+    lead = uni.CfgExpr(expr=isnone, kid=[isnone]);
+    cond = nd.condition;
+    inner = self._unwrap_expr(cond);
+    vals: list[any] = [];
+    join: any = None;
+    if (self._bool_join(inner) == 'and') and isinstance(inner, uni.BoolExpr) {
+        vals = [lead] + list(inner.values or []);
+        join = inner.op;
+    } else {
+        kept: any = (
+            cond if isinstance(cond, uni.CfgExpr) else uni.CfgExpr(
+                expr=cond, kid=[cond]
+            )
+        );
+        vals = [lead, kept];
+        join = gen_token(nd, Tok.KW_AND.value, 'and');
+    }
+    merged = uni.BoolExpr(op=join, values=vals, kid=[join] + vals);
+    holder: any = nd;
+    setattr(holder, 'condition', merged);
+    kids: list[any] = [merged] + list(nd.body or []);
+    if nd.else_body is not None {
+        kids.append(nd.else_body);
+    }
+    nd.set_kids(kids);
+    self._counter += 1;
+}
+
+impl PredicateCtrlFlowPass._seq_scan(stmts: Sequence[any], name: str) -> int {
+    for s in (stmts or []) {
+        r = self._stmt_scan(s, name);
+        if r != _SCAN_CLEAN {
+            return r;
+        }
+    }
+    return _SCAN_CLEAN;
+}
+
+impl PredicateCtrlFlowPass._else_seq(nd: uni.IfStmt) -> (list[any] | None) {
+    eb = nd.else_body;
+    if eb is None {
+        return [];
+    }
+    if isinstance(eb, uni.ElseStmt) {
+        return list(eb.body or []);
+    }
+    if isinstance(eb, uni.IfStmt) {
+        return [eb];
+    }
+    return None;
+}
+
+impl PredicateCtrlFlowPass._stmt_scan(s: uni.UniNode, name: str) -> int {
+    if isinstance(s, uni.Assignment) {
+        v = s.value;
+        if (s.aug_op is not None) or (not isinstance(v, uni.Expr)) {
+            return _SCAN_UNSAFE;
+        }
+        r = self._expr_scan(v, name);
+        if r != _SCAN_CLEAN {
+            return r;
+        }
+        return (
+            _SCAN_CLEAN
+            if self._local_store_targets(s.target or [])
+            else _SCAN_UNSAFE
+        );
+    }
+    if isinstance(s, uni.ExprStmt) {
+        return self._expr_scan(s.expr, name);
+    }
+    if isinstance(s, uni.AssertStmt) {
+        r = self._expr_scan(s.condition, name);
+        if r != _SCAN_CLEAN {
+            return r;
+        }
+        if s.error_msg is None {
+            return _SCAN_CLEAN;
+        }
+        return (
+            _SCAN_CLEAN
+            if (self._expr_scan(s.error_msg, name) == _SCAN_CLEAN)
+            else _SCAN_UNSAFE
+        );
+    }
+    if isinstance(s, uni.IfStmt) {
+        rc = self._expr_scan(s.condition, name);
+        if rc != _SCAN_CLEAN {
+            return rc;
+        }
+        alt = self._else_seq(s);
+        if alt is None {
+            return _SCAN_UNSAFE;
+        }
+        rt = self._seq_scan(s.body, name);
+        rf = self._seq_scan(alt, name);
+        if (rt == _SCAN_UNSAFE) or (rf == _SCAN_UNSAFE) {
+            return _SCAN_UNSAFE;
+        }
+        return (
+            _SCAN_FATAL
+            if ((rt == _SCAN_FATAL) and (rf == _SCAN_FATAL))
+            else _SCAN_CLEAN
+        );
+    }
+    if isinstance(s, uni.InForStmt) {
+        rc = self._expr_scan(s.collection, name);
+        if rc == _SCAN_FATAL {
+            return _SCAN_FATAL;
+        }
+        if (rc == _SCAN_CLEAN) and self._is_named(s.collection, name) {
+            return _SCAN_FATAL;
+        }
+        return _SCAN_UNSAFE;
+    }
+    return _SCAN_UNSAFE;
+}
+
+impl PredicateCtrlFlowPass._expr_scan(e: (uni.UniNode | None), name: str) -> int {
+    if e is None {
+        return _SCAN_CLEAN;
+    }
+    if isinstance(e, uni.CfgExpr) {
+        return self._expr_scan(e.expr, name);
+    }
+    if isinstance(e, uni.AtomUnit) {
+        return (
+            self._expr_scan(e.value, name)
+            if isinstance(e.value, uni.Expr)
+            else _SCAN_UNSAFE
+        );
+    }
+    if isinstance(e, uni.KWPair) {
+        return self._expr_scan(e.value, name);
+    }
+    if isinstance(e, uni.Name) or isinstance(e, (uni.Literal, uni.MultiString)) {
+        return _SCAN_CLEAN;
+    }
+    if isinstance(e, uni.AtomTrailer) {
+        return self._trailer_scan(e, name);
+    }
+    if isinstance(e, uni.FuncCall) {
+        return self._call_scan(e, name);
+    }
+    if isinstance(e, uni.BinaryExpr) {
+        return self._expr_seq_scan([e.left, e.right], name);
+    }
+    if isinstance(e, uni.CompareExpr) {
+        return self._compare_scan(e, name);
+    }
+    if isinstance(e, uni.BoolExpr) {
+        return self._bool_scan(e, name);
+    }
+    if isinstance(e, uni.UnaryExpr) {
+        return self._expr_scan(e.operand, name);
+    }
+    if isinstance(e, uni.IfElseExpr) {
+        return self._ternary_scan(e, name);
+    }
+    if isinstance(e, (uni.ListVal, uni.SetVal, uni.TupleVal)) {
+        return self._expr_seq_scan(list(e.values or []), name);
+    }
+    if isinstance(e, uni.DictVal) {
+        items: list[any] = [];
+        for kv in (e.kv_pairs or []) {
+            items.append(kv.key);
+            items.append(kv.value);
+        }
+        return self._expr_seq_scan(items, name);
+    }
+    if isinstance(e, uni.DictCompr) {
+        return self._compr_scan(
+            list(e.compr or []), [e.kv_pair.key, e.kv_pair.value], name
+        );
+    }
+    if isinstance(e, uni.ListCompr) {
+        return self._compr_scan(list(e.compr or []), [e.out_expr], name);
+    }
+    return _SCAN_UNSAFE;
+}
+
+impl PredicateCtrlFlowPass._expr_seq_scan(items: list[any], name: str) -> int {
+    for it in items {
+        r = self._expr_scan(it, name);
+        if r != _SCAN_CLEAN {
+            return r;
+        }
+    }
+    return _SCAN_CLEAN;
+}
+
+impl PredicateCtrlFlowPass._bool_scan(e: uni.BoolExpr, name: str) -> int {
+    vals = list(e.values or []);
+    if not vals {
+        return _SCAN_UNSAFE;
+    }
+    first = self._expr_scan(vals[0], name);
+    if first != _SCAN_CLEAN {
+        return first;
+    }
+    for v in vals[1:] {
+        if self._expr_scan(v, name) == _SCAN_UNSAFE {
+            return _SCAN_UNSAFE;
+        }
+    }
+    return _SCAN_CLEAN;
+}
+
+impl PredicateCtrlFlowPass._compare_scan(e: uni.CompareExpr, name: str) -> int {
+    rights = list(e.rights or []);
+    if len(rights) == 1 {
+        return self._expr_seq_scan([e.left, rights[0]], name);
+    }
+    r = self._expr_scan(e.left, name);
+    if r != _SCAN_CLEAN {
+        return r;
+    }
+    for x in rights {
+        if self._expr_scan(x, name) == _SCAN_UNSAFE {
+            return _SCAN_UNSAFE;
+        }
+    }
+    return _SCAN_CLEAN;
+}
+
+impl PredicateCtrlFlowPass._ternary_scan(e: uni.IfElseExpr, name: str) -> int {
+    rc = self._expr_scan(e.condition, name);
+    if rc != _SCAN_CLEAN {
+        return rc;
+    }
+    rt = self._expr_scan(e.value, name);
+    rf = self._expr_scan(e.else_value, name);
+    if (rt == _SCAN_UNSAFE) or (rf == _SCAN_UNSAFE) {
+        return _SCAN_UNSAFE;
+    }
+    return (
+        _SCAN_FATAL
+        if ((rt == _SCAN_FATAL) and (rf == _SCAN_FATAL))
+        else _SCAN_CLEAN
+    );
+}
+
+impl PredicateCtrlFlowPass._trailer_scan(e: uni.AtomTrailer, name: str) -> int {
+    r = self._expr_scan(e.target, name);
+    if r != _SCAN_CLEAN {
+        return r;
+    }
+    right = e.right;
+    if isinstance(right, uni.IndexSlice) {
+        ri = self._slice_scan(right, name);
+        if ri != _SCAN_CLEAN {
+            return ri;
+        }
+    } elif not isinstance(right, uni.Name) {
+        return _SCAN_UNSAFE;
+    }
+    if e.is_null_ok {
+        return _SCAN_CLEAN;
+    }
+    return _SCAN_FATAL if self._is_named(e.target, name) else _SCAN_CLEAN;
+}
+
+impl PredicateCtrlFlowPass._slice_scan(e: uni.IndexSlice, name: str) -> int {
+    items: list[any] = [];
+    for sl in (e.slices or []) {
+        items.append(sl.start);
+        items.append(sl.stop);
+        items.append(sl.step);
+    }
+    return self._expr_seq_scan(items, name);
+}
+
+impl PredicateCtrlFlowPass._call_scan(c: uni.FuncCall, name: str) -> int {
+    r = self._expr_scan(c.target, name);
+    if r != _SCAN_CLEAN {
+        return r;
+    }
+    for p in (c.params or []) {
+        rp = self._expr_scan(p, name);
+        if rp != _SCAN_CLEAN {
+            return rp;
+        }
+    }
+    return _SCAN_CLEAN if self._scan_call_pure(c) else _SCAN_UNSAFE;
+}
+
+impl PredicateCtrlFlowPass._compr_scan(
+    compr: list[any], parts: list[any], name: str
+) -> int {
+    if not compr {
+        return _SCAN_UNSAFE;
+    }
+    head: any = compr[0];
+    r = self._expr_scan(head.collection, name);
+    if r != _SCAN_CLEAN {
+        return r;
+    }
+    if self._is_named(head.collection, name) {
+        return _SCAN_FATAL;
+    }
+    rest: list[any] = list(parts);
+    for ic in compr {
+        holder: any = ic;
+        rest.append(holder.collection);
+        for cnd in (holder.conditional or []) {
+            rest.append(cnd);
+        }
+    }
+    for x in rest {
+        if self._expr_scan(x, name) != _SCAN_CLEAN {
+            return _SCAN_UNSAFE;
+        }
+    }
+    return _SCAN_CLEAN;
+}
+
+impl PredicateCtrlFlowPass._scan_call_pure(c: uni.FuncCall) -> bool {
+    t = c.target;
+    if self._pure_callee(t) {
+        return True;
+    }
+    if isinstance(t, uni.Name) {
+        return (t.value in _PRECOND_BUILTINS)
+            and ((t.sym is None) or symbol_is_builtin(t.sym));
+    }
+    if isinstance(t, uni.AtomTrailer) and isinstance(t.right, uni.Name) {
+        base = t.target;
+        if isinstance(base, uni.Name)
+            and (base.value == 'torch')
+            and (t.right.value in _PRECOND_TORCH_FNS)
+            and self._pure_root(base) {
+            return True;
+        }
+        return (t.right.value in _PURE_TENSOR_METHODS) and (not (c.params or []));
+    }
+    return False;
+}
+
+impl PredicateCtrlFlowPass._is_named(e: (uni.UniNode | None), name: str) -> bool {
+    if (e is None) or (not isinstance(e, uni.Expr)) {
+        return False;
+    }
+    inner = self._unwrap_expr(e);
+    return isinstance(inner, uni.Name) and (inner.value == name);
+}
+
+impl PredicateCtrlFlowPass._local_store_targets(targets: Sequence[any]) -> bool {
+    names: list[uni.Name] = [];
+    for t in (targets or []) {
+        items: list[any] = (
+            list(t.values or [])
+            if isinstance(t, (uni.TupleVal, uni.ListVal))
+            else [t]
+        );
+        for it in items {
+            if not isinstance(it, uni.Name) {
+                return False;
+            }
+            names.append(it);
+        }
+    }
+    if not names {
+        return False;
+    }
+    mod = names[0].find_parent_of_type(uni.Module);
+    if mod is None {
+        return False;
+    }
+    outside = self._module_scope_names(mod);
+    for n in names {
+        if n.value in outside {
+            return False;
+        }
+    }
+    return True;
+}
diff --git a/mod_jac/jaclang/compiler/passes/graphmend/impl/trap_lowering_pass.impl.jac b/jac/jaclang/compiler/passes/graphmend/impl/trap_lowering_pass.impl.jac
new file mode 100644
index 0000000..77c4c25
--- /dev/null
+++ b/jac/jaclang/compiler/passes/graphmend/impl/trap_lowering_pass.impl.jac
@@ -0,0 +1,542 @@
+import builtins;
+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.frontend.constant { GraphBreakKind, GraphMendHelper }
+import from jaclang.compiler.passes.graphmend.ast_edit {
+    facts_for,
+    gen_name,
+    gen_string,
+    insert_after,
+    need_helper,
+    replace_stmt,
+    split_params,
+    torch_call
+}
+import from jaclang.compiler.passes.graphmend.scope_facts {
+    call_argument,
+    claim_chain_reaches,
+    entry_key,
+    entry_module,
+    method_call_sites,
+    param_annotation,
+    param_names
+}
+import from jaclang.compiler.passes.graphmend.torch_attr_table {
+    defining_assignment,
+    has_torch_compile_decorator,
+    is_torch_attr_target,
+    symbol_is_builtin
+}
+
+impl TrapLoweringPass.exit_assignment(nd: uni.Assignment) -> None {
+    if not self._enabled {
+        return;
+    }
+    value = nd.value;
+    if (
+        (not isinstance(value, uni.FuncCall))
+        or (not is_torch_attr_target(value.target, 'compile'))
+    ) {
+        return;
+    }
+    if (not nd.target) or (len(nd.target) != 1) {
+        return;
+    }
+    tgt = nd.target[0];
+    if not isinstance(tgt, uni.Name) {
+        return;
+    }
+    if not insert_after(nd, self._boundary_attach_stmt(nd, tgt.value)) {
+        return;
+    }
+    need_helper(nd, GraphMendHelper.TRAP_GUARD);
+    home = nd.find_parent_of_type(uni.Module);
+    if home is not None {
+        self.prog.graphmend_trap_boundaries.add(
+            f"{home.loc.mod_path}::{tgt.value}"
+        );
+    }
+}
+
+impl TrapLoweringPass._boundary_attach_stmt(
+    at: uni.UniNode, name: str
+) -> uni.Assignment {
+    store = self._gen_name(at, name);
+    store.expr_ctx = uni.ExprCtx.STORE;
+    guard = self._gen_name(at, '__jac_trap_guard__');
+    arg = self._gen_name(at, name);
+    call = uni.FuncCall(target=guard, params=[arg], genai_call=None, kid=[guard, arg]);
+    return uni.Assignment(
+        target=[store], value=call, type_tag=None, mutable=True, kid=[store, call]
+    );
+}
+
+impl TrapLoweringPass.before_pass -> None {
+    self._enabled = (self.prog.options.graphmend is True)
+        and "trap" not in (self.prog.options.graphmend_disable or []);
+    if not self._enabled {
+        self.prune_signal = True;
+    }
+}
+
+impl TrapLoweringPass.exit_if_stmt(nd: uni.IfStmt) -> None {
+    if not self._enabled {
+        return;
+    }
+    if facts_for(nd).breaks.get(nd) != GraphBreakKind.VAL_GUARD {
+        return;
+    }
+    if self._inside_try(nd) {
+        return;
+    }
+    if (not nd.body) or (len(nd.body) != 1) {
+        return;
+    }
+    rs = nd.body[0];
+    if not isinstance(rs, uni.RaiseStmt) {
+        return;
+    }
+    cond = nd.condition;
+    negated_compare = False;
+    x: (uni.Expr | None) = None;
+    if isinstance(cond, uni.UnaryExpr)
+        and (cond.op is not None)
+        and (cond.op.value == 'not') {
+        x = cond.operand;
+    } elif self._condition_is_tensor(cond, nd) {
+        x = torch_call(nd, 'logical_not', [cond]);
+        negated_compare = True;
+    }
+    if x is None {
+        return;
+    }
+    msg = self._raise_message(rs);
+    wrap = self._boundary_ability(nd);
+    covered = (wrap is not None) or self._call_site_covered(nd);
+    type_name = self._exception_type_name(rs) if covered else None;
+    marked = (
+        self._marked_message(nd, msg, type_name)
+            if ((type_name is not None) and (msg is not None))
+            else None
+    );
+    if marked is None {
+        return;
+    }
+    if not self._torch_binds_module(nd) {
+        return;
+    }
+    eq = self._torch_equal_args(x);
+    if eq is not None {
+        (a, b) = eq;
+        need_helper(nd, GraphMendHelper.EQ_ASSERT);
+        replace_stmt(nd, [self._eq_assert_stmt(nd, a, b, marked)]);
+        self._mark_guard(wrap);
+    } elif negated_compare {
+        replace_stmt(nd, [self._assert_async_stmt(nd, x, marked)]);
+        self._mark_guard(wrap);
+    } elif self._returns_tensor_bool(x) and self._tensor_receiver_provable(x, nd) {
+        replace_stmt(nd, [self._assert_async_stmt(nd, x, marked)]);
+        self._mark_guard(wrap);
+    }
+}
+
+impl TrapLoweringPass._inside_try(nd: uni.UniNode) -> bool {
+    tp = nd.find_parent_of_type(uni.TryStmt);
+    return (tp is not None)
+        and (
+            tp.find_parent_of_type(uni.Ability) is nd.find_parent_of_type(uni.Ability)
+        );
+}
+
+impl TrapLoweringPass._boundary_ability(nd: uni.UniNode) -> (uni.Ability | None) {
+    ab = nd.find_parent_of_type(uni.Ability);
+    if ab is None {
+        return None;
+    }
+    if has_torch_compile_decorator(ab) {
+        return ab;
+    }
+    seed = facts_for(ab).boundary.get(ab);
+    if (seed is None) or (not has_torch_compile_decorator(seed)) {
+        return None;
+    }
+    return seed if (seed.find_parent_of_type(uni.Module) is self.ir_in) else None;
+}
+
+impl TrapLoweringPass._call_site_covered(nd: uni.UniNode) -> bool {
+    return self._covering_entry(nd) is not None;
+}
+
+impl TrapLoweringPass._covering_entry(nd: uni.UniNode) -> (str | None) {
+    ab = nd.find_parent_of_type(uni.Ability);
+    if ab is None {
+        return None;
+    }
+    facts = facts_for(ab);
+    bound = facts.boundary.get(ab);
+    if bound is None {
+        return None;
+    }
+    site_key = entry_key(ab);
+    root_key = entry_key(bound);
+    if root_key in facts.wrapped_keys {
+        facts.covered_by[site_key] = root_key;
+        return root_key;
+    }
+    guard_mod = entry_module(site_key);
+    for wrapped in sorted(facts.wrapped_keys) {
+        if claim_chain_reaches(self.prog, entry_module(wrapped), guard_mod) {
+            facts.covered_by[site_key] = wrapped;
+            return wrapped;
+        }
+    }
+    attached = self._program_boundary();
+    if attached is not None {
+        facts.covered_by[site_key] = attached;
+        return attached;
+    }
+    return None;
+}
+
+impl TrapLoweringPass._program_boundary -> (str | None) {
+    for key in sorted(self.prog.graphmend_trap_boundaries) {
+        return key;
+    }
+    return None;
+}
+
+impl TrapLoweringPass._exception_type_name(rs: uni.RaiseStmt) -> (str | None) {
+    cause = rs.cause;
+    if cause is None {
+        return None;
+    }
+    target = cause.target if isinstance(cause, uni.FuncCall) else cause;
+    if not isinstance(target, uni.Name) {
+        return None;
+    }
+    if (target.sym is not None) and not symbol_is_builtin(target.sym) {
+        return None;
+    }
+    cls = getattr(builtins, target.value, None);
+    if isinstance(cls, type) and issubclass(cls, BaseException) {
+        return target.value;
+    }
+    return None;
+}
+
+impl TrapLoweringPass._marked_message(
+    at: uni.UniNode, msg: uni.Expr, type_name: str
+) -> (uni.String | None) {
+    if not isinstance(msg, (uni.String, uni.MultiString)) {
+        return None;
+    }
+    if isinstance(msg, uni.MultiString) {
+        for part in msg.strings {
+            if not isinstance(part, uni.String) {
+                return None;
+            }
+        }
+    }
+    lit = str(msg.lit_value);
+    if "[[/GM-TRAP]]" in lit {
+        return None;
+    }
+    text = "[[GM-TRAP " + type_name + "]]" + lit + "[[/GM-TRAP]]";
+    return self._str(at, text);
+}
+
+impl TrapLoweringPass._mark_guard(ability: (uni.Ability | None)) -> None {
+    if ability is None {
+        return;
+    }
+    for known in self._guarded_fns {
+        if known is ability {
+            return;
+        }
+    }
+    self._guarded_fns.append(ability);
+    need_helper(ability, GraphMendHelper.TRAP_GUARD);
+}
+
+impl TrapLoweringPass.after_pass -> None {
+    for ab in self._guarded_fns {
+        dec = self._gen_name(ab, '__jac_trap_guard__');
+        ab.decorators = [dec] + list(ab.decorators or []);
+        ab.set_kids([dec] + list(ab.kid));
+        dec.parent = ab;
+    }
+    self._guarded_fns = [];
+}
+
+impl TrapLoweringPass._torch_equal_args(x: uni.Expr) -> (tuple | None) {
+    if not isinstance(x, uni.FuncCall) {
+        return None;
+    }
+    call: uni.FuncCall = x;
+    if not is_torch_attr_target(call.target, 'equal') {
+        return None;
+    }
+    pos = split_params(call.params)[0];
+    if len(pos) < 2 {
+        return None;
+    }
+    return (pos[0], pos[1]);
+}
+
+impl TrapLoweringPass._returns_tensor_bool(x: uni.Expr) -> bool {
+    return (
+        isinstance(x, uni.FuncCall)
+        and isinstance(x.target, uni.AtomTrailer)
+        and isinstance(x.target.right, uni.Name)
+        and (x.target.right.value in _TENSOR_BOOL_OPS)
+    );
+}
+
+impl TrapLoweringPass._raise_message(rs: uni.RaiseStmt) -> (uni.Expr | None) {
+    if rs.from_target is not None {
+        return None;
+    }
+    cause = rs.cause;
+    if not isinstance(cause, uni.FuncCall) {
+        return None;
+    }
+    call: uni.FuncCall = cause;
+    pos = split_params(call.params)[0];
+    if (len(pos) != 1) or (len(pos) != len(call.params or [])) {
+        return None;
+    }
+    return pos[0];
+}
+
+impl TrapLoweringPass._gen_name(at: uni.UniNode, value: str) -> uni.Name {
+    return gen_name(at, value, False);
+}
+
+impl TrapLoweringPass._str(at: uni.UniNode, text: str) -> uni.String {
+    esc = text.encode('unicode_escape').decode('ascii').replace('"', '\\"');
+    return gen_string(at, f'"{esc}"');
+}
+
+impl TrapLoweringPass._call_stmt(call: uni.FuncCall) -> uni.ExprStmt {
+    return uni.ExprStmt(expr=call, in_fstring=False, kid=[call]);
+}
+
+impl TrapLoweringPass._eq_assert_stmt(
+    at: uni.UniNode, a: uni.Expr, b: uni.Expr, msg: uni.Expr
+) -> uni.ExprStmt {
+    helper = self._gen_name(at, '__jac_tensor_eq_assert__');
+    params = [a, b, msg];
+    call = uni.FuncCall(
+        target=helper, params=params, genai_call=None, kid=[helper] + params
+    );
+    return self._call_stmt(call);
+}
+
+impl TrapLoweringPass._assert_async_stmt(
+    at: uni.UniNode, x: uni.Expr, msg: uni.Expr
+) -> uni.ExprStmt {
+    torch_nm = self._gen_name(at, 'torch');
+    assert_nm = self._gen_name(at, '_assert_async');
+    target = uni.AtomTrailer(
+        target=torch_nm,
+        right=assert_nm,
+        is_attr=True,
+        is_null_ok=False,
+        kid=[torch_nm, assert_nm]
+    );
+    params = [x, msg];
+    call = uni.FuncCall(
+        target=target, params=params, genai_call=None, kid=[target] + params
+    );
+    return self._call_stmt(call);
+}
+
+impl TrapLoweringPass._condition_is_tensor(cond: uni.Expr, site: uni.UniNode) -> bool {
+    if isinstance(cond, uni.AtomUnit) and isinstance(cond.value, uni.Expr) {
+        return self._condition_is_tensor(cond.value, site);
+    }
+    if isinstance(cond, uni.CompareExpr) {
+        if len(cond.ops or []) != 1 {
+            return False;
+        }
+        if cond.ops[0].value not in {'==', '!=', '<', '>', '<=', '>='} {
+            return False;
+        }
+        operands = [cond.left] + list(cond.rights or []);
+        for e in operands {
+            if self._operand_is_tensor(e, site) {
+                return True;
+            }
+        }
+    }
+    return False;
+}
+
+impl TrapLoweringPass._operand_is_tensor(e: uni.Expr, site: uni.UniNode) -> bool {
+    if isinstance(e, uni.AtomUnit) and isinstance(e.value, uni.Expr) {
+        return self._operand_is_tensor(e.value, site);
+    }
+    if self._tensor_valued_call(e) and self._tensor_receiver_provable(e, site) {
+        return True;
+    }
+    return self._tensor_expr_provable(e, site);
+}
+
+impl TrapLoweringPass._tensor_valued_call(x: uni.Expr) -> bool {
+    return (
+        isinstance(x, uni.FuncCall)
+        and isinstance(x.target, uni.AtomTrailer)
+        and isinstance(x.target.right, uni.Name)
+        and (x.target.right.value in (_TENSOR_BOOL_OPS | _TENSOR_VALUE_OPS))
+    );
+}
+
+impl TrapLoweringPass._torch_factory_call(x: uni.Expr) -> bool {
+    if not isinstance(x, uni.FuncCall) {
+        return False;
+    }
+    t = x.target;
+    if not (isinstance(t, uni.AtomTrailer) and isinstance(t.right, uni.Name)) {
+        return False;
+    }
+    if t.right.value not in _TENSOR_FACTORY_OPS {
+        return False;
+    }
+    return is_torch_attr_target(t, t.right.value) and self._torch_binds_module(x);
+}
+
+impl TrapLoweringPass._tensor_receiver_provable(
+    x: uni.Expr, site: uni.UniNode
+) -> bool {
+    if not (isinstance(x, uni.FuncCall) and isinstance(x.target, uni.AtomTrailer)) {
+        return False;
+    }
+    return self._tensor_expr_provable(x.target.target, site);
+}
+
+impl TrapLoweringPass._tensor_expr_provable(e: uni.Expr, site: uni.UniNode) -> bool {
+    if isinstance(e, uni.AtomUnit) and isinstance(e.value, uni.Expr) {
+        return self._tensor_expr_provable(e.value, site);
+    }
+    if isinstance(e, uni.Name) {
+        if self._param_is_tensor(e.value, site) {
+            return True;
+        }
+        return self._assigned_tensor_provable(e, site);
+    }
+    if isinstance(e, uni.AtomTrailer) and isinstance(e.right, uni.IndexSlice) {
+        return self._tensor_expr_provable(e.target, site);
+    }
+    if self._torch_factory_call(e) {
+        return True;
+    }
+    if isinstance(e, uni.BinaryExpr) {
+        return self._tensor_expr_provable(e.left, site)
+            or self._tensor_expr_provable(e.right, site);
+    }
+    if isinstance(e, uni.CompareExpr) {
+        if self._tensor_expr_provable(e.left, site) {
+            return True;
+        }
+        for r in (e.rights or []) {
+            if self._tensor_expr_provable(r, site) {
+                return True;
+            }
+        }
+        return False;
+    }
+    return False;
+}
+
+impl TrapLoweringPass._assigned_tensor_provable(
+    nm: uni.Name, site: uni.UniNode
+) -> bool {
+    if nm.value in self._tensor_trace {
+        return False;
+    }
+    st = nm.sym_tab;
+    sym = st.lookup(nm.value, deep=True) if st else None;
+    if sym is None {
+        return False;
+    }
+    if len(sym.defn) > 1 {
+        return False;
+    }
+    assign = defining_assignment(sym);
+    if (assign is None) or (assign.value is None) {
+        return False;
+    }
+    self._tensor_trace.add(nm.value);
+    try {
+        return self._tensor_expr_provable(assign.value, site);
+    } finally {
+        self._tensor_trace.discard(nm.value);
+    }
+}
+
+impl TrapLoweringPass._param_is_tensor(name: str, site: uni.UniNode) -> bool {
+    ab = site.find_parent_of_type(uni.Ability);
+    if ab is None {
+        return False;
+    }
+    ann = param_annotation(ab, name);
+    if isinstance(ann, uni.Name) {
+        if self._binds_torch_tensor(ann) {
+            return True;
+        }
+        if ann.value not in {'Any', 'any'} {
+            return False;
+        }
+    } elif ann is not None {
+        return is_torch_attr_target(ann, 'Tensor');
+    }
+    return self._param_from_callers(ab, name);
+}
+
+impl TrapLoweringPass._param_from_callers(ab: uni.Ability, name: str) -> bool {
+    if name not in param_names(ab) {
+        return False;
+    }
+    key = f"{entry_key(ab)}::{name}";
+    if key in self._param_trace {
+        return False;
+    }
+    sites = method_call_sites(self.prog, ab, self._mat_seen);
+    if not sites {
+        return False;
+    }
+    self._param_trace.add(key);
+    try {
+        for call in sites {
+            arg = call_argument(call, ab, name);
+            if (arg is None) or (not self._tensor_expr_provable(arg, call)) {
+                return False;
+            }
+        }
+        return True;
+    } finally {
+        self._param_trace.discard(key);
+    }
+}
+
+impl TrapLoweringPass._torch_binds_module(site: uni.UniNode) -> bool {
+    sym = site.sym_tab.lookup('torch');
+    decl = sym.decl if (sym is not None) else None;
+    mp = decl.find_parent_of_type(uni.ModulePath) if (decl is not None) else None;
+    if (mp is None) or mp.is_import_from or (mp.alias is not None) {
+        return False;
+    }
+    return mp.dot_path_str == 'torch';
+}
+
+impl TrapLoweringPass._binds_torch_tensor(ann: uni.Name) -> bool {
+    decl = ann.sym.decl if (ann.sym is not None) else None;
+    mi = decl.find_parent_of_type(uni.ModuleItem) if (decl is not None) else None;
+    if mi is None {
+        return False;
+    }
+    if not (isinstance(mi.name, uni.Name) and (mi.name.value == 'Tensor')) {
+        return False;
+    }
+    mp = mi.parent.from_loc if isinstance(mi.parent, uni.Import) else None;
+    return (mp is not None) and (mp.dot_path_str == 'torch');
+}
