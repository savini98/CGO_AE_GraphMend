@@ -0,0 +1,364 @@
+"""The compiled region bounds every rewrite; unreached code stays byte-identical."""
+import ast;
+import os;
+import from pathlib { Path }
+import from tempfile { TemporaryDirectory }
+import from tests.support {
+    GRAPHMEND_FIXTURES as FIXTURES,
+    code_mentions_symbol as _mentions_symbol,
+    graphmend_break_kinds as _break_kinds,
+    graphmend_compile_opts as _compile_opts,
+    graphmend_pysrc as _pysrc
+}
+import from jaclang.compiler.driver.program { JacProgram }
+import from jaclang.compiler.driver.compile_options { CompileOptions }
+import from jaclang.project.config { JacConfig }
+import jaclang.project.config as config_mod;
+
+"""Unparse one named function out of generated Python source."""
+def _fn_src(src: str, name: str) -> str {
+    tree = ast.parse(src);
+    for nd in ast.walk(tree) {
+        if isinstance(nd, ast.FunctionDef) and (nd.name == name) {
+            return ast.unparse(nd);
+        }
+    }
+    return "";
+}
+
+"""Compile a fixture with default (auto) options and return its Python source."""
+def _auto_pysrc(name: str) -> str {
+    return _compile_opts(os.path.join(FIXTURES, name))[0];
+}
+
+"""Compile a fixture in an existing program and return its Python source."""
+def _pysrc_in(prog: JacProgram, name: str) -> str {
+    return _compile_opts(
+        os.path.join(FIXTURES, name), CompileOptions(graphmend=True), prog
+    )[0];
+}
+
+test "an unreachable sibling keeps every transformable pattern untouched" {
+    src_on = _pysrc("region_unreachable_sibling.jac", True);
+    src_off = _pysrc("region_unreachable_sibling.jac", False);
+    # The entry chain is transformed as usual.
+    assert "torch._assert_async(mask.all()" in _fn_src(src_on, "entry");
+    assert "__jac_se_emit__" in _fn_src(src_on, "entry");
+    # The sibling holds a lowerable guard, a data-dependent branch, and a
+    # print, yet none of them may move: it is byte-identical to graphmend-off.
+    assert _fn_src(src_on, "orphan") == _fn_src(src_off, "orphan");
+    assert _fn_src(src_on, "orphan_leaf") == _fn_src(src_off, "orphan_leaf");
+    assert "raise ValueError('orphan mask must be all true')" in src_on;
+    assert "print('ORPHAN-EFFECT', y)" in src_on;
+    assert "torch.where" not in src_on;
+}
+
+test "detection tags nothing outside the compiled region" {
+    kinds = sorted(_break_kinds("region_unreachable_sibling.jac"));
+    assert kinds == ["side_effect", "val_guard"];
+}
+
+test "a torch module without torch compile compiles byte identical" {
+    src_on = _pysrc("region_no_compile.jac", True);
+    src_off = _pysrc("region_no_compile.jac", False);
+    src_auto = _auto_pysrc("region_no_compile.jac");
+    assert src_on == src_off;
+    assert src_auto == src_off;
+    assert _break_kinds("region_no_compile.jac") == [];
+}
+
+test "a decorated entry chain is transformed at depth" {
+    src = _pysrc("region_chain.jac", True);
+    assert "__jac_se_emit__" in _fn_src(src, "deep");
+    assert "print('DEEP-EFFECT'" not in src;
+}
+
+test "a cross module helper is transformed when its entry is in the hub" {
+    prog = JacProgram();
+    _pysrc_in(prog, "region_xmod_entry.jac");
+    src = _pysrc_in(prog, "region_xmod_helper.jac");
+    assert "__jac_se_emit__" in _fn_src(src, "far_helper");
+    assert "print('FAR-ORPHAN', x)" in _fn_src(src, "far_orphan");
+}
+
+test "a relative import named like a stdlib module keeps its call edge" {
+    # The sibling json.jac only shares a stdlib name: its import is relative,
+    # which the deny list exempts for class lookups and must exempt for
+    # ability lookups the same way.
+    prog = JacProgram();
+    _pysrc_in(prog, os.path.join("region_relstd", "entry.jac"));
+    src = _pysrc_in(prog, os.path.join("region_relstd", "json.jac"));
+    assert "__jac_se_emit__" in _fn_src(src, "near_helper");
+}
+
+test "a wrapped entry function is transformed through the wrap" {
+    src = _pysrc("region_wrap_fn.jac", True);
+    assert "__jac_se_emit__" in _fn_src(src, "wrapped");
+}
+
+test "a wrap entry callee is transformed at depth" {
+    src = _pysrc("region_wrap_fn.jac", True);
+    assert "__jac_se_emit__" in _fn_src(src, "wrap_helper");
+    assert _break_kinds("region_wrap_fn.jac") == ["side_effect", "side_effect"];
+}
+
+test "a wrapped class compiles forward only" {
+    # torch.compile(Model()) compiles forward; sibling methods stay eager. The
+    # region is forward plus its call edges, never the whole class.
+    src_on = _pysrc("region_wrap_cls.jac", True);
+    src_off = _pysrc("region_wrap_cls.jac", False);
+    assert "__jac_se_emit__" in _fn_src(src_on, "cls_helper");
+    assert _fn_src(src_on, "side_step") == _fn_src(src_off, "side_step");
+    assert "print('SIDE-STEP', x)" in src_on;
+}
+
+test "a seeded forward reaches a method through the self call and no further" {
+    prog = JacProgram();
+    src = _pysrc_in(prog, "region_self_method.jac");
+    assert "__jac_se_emit__" in _fn_src(src, "step");
+    assert "print('UNUSED-EFFECT', x)" in _fn_src(src, "unused");
+    assert "__jac_se_emit__" not in _fn_src(src, "unused");
+}
+
+test "a seeded forward reaches an inherited method through the base chain" {
+    # `helper` is declared on the base class only, so the self-call resolves
+    # only if the walk follows the base chain. `base_orphan` sits beside it and
+    # is called by nothing: the edge is the call, not the declaring class.
+    src_on = _pysrc("region_inherited.jac", True);
+    src_off = _pysrc("region_inherited.jac", False);
+    assert "__jac_se_emit__" in _fn_src(src_on, "helper");
+    assert _fn_src(src_on, "base_orphan") == _fn_src(src_off, "base_orphan");
+    assert "print('BASE-ORPHAN', x)" in src_on;
+}
+
+test "a submodule attribute call reaches the held archetype's method" {
+    # `self.blk` is proven to hold a Block by the constructor assignment, so
+    # `self.blk.project(...)` is a region edge. `self.opaque` is assigned a call
+    # that resolves to no class, so `self.opaque.spare(...)` proves nothing.
+    src_on = _pysrc("region_submodule_attr.jac", True);
+    src_off = _pysrc("region_submodule_attr.jac", False);
+    assert "__jac_se_emit__" in _fn_src(src_on, "project");
+    assert _fn_src(src_on, "spare") == _fn_src(src_off, "spare");
+    assert "print('BLOCK-SPARE', x)" in src_on;
+}
+
+test "a submodule attribute call dispatches to the held class's forward" {
+    # `Mixin.forward` is no seed of its own: the mixin has no Module base and
+    # the class that does declares no forward. The call joins it to the region
+    # through the constructor binding plus the base chain.
+    src_on = _pysrc("region_submod_forward.jac", True);
+    src_off = _pysrc("region_submod_forward.jac", False);
+    assert "__jac_se_emit__(print, ('MIXIN-FORWARD'" in src_on;
+    assert _fn_src(src_on, "mixin_orphan") == _fn_src(src_off, "mixin_orphan");
+    assert "print('MIXIN-ORPHAN', x)" in src_on;
+}
+
+glob CACHE_ENTRY_SRC = "import torch;\n"
+         + "import from usedmod { used_helper }\n\n"
+         + "@torch.compile()\n"
+         + "def f(x: any, mask: torch.Tensor) -> any {\n"
+         + "    x = torch.relu(used_helper(x));\n"
+         + "    if not mask.all() {\n"
+         + "        raise ValueError(\"mask must be all true\");\n"
+         + "    }\n"
+         + "    return torch.sin(x) * 2.0;\n"
+         + "}\n",
+     CACHE_USED_SRC = "import torch;\n\n"
+         + "def used_helper(x: any) -> any {\n"
+         + "    print(\"USED\", x);\n"
+         + "    return torch.relu(x);\n"
+         + "}\n",
+     CACHE_CONF_SRC = "import torch;\n\n"
+         + "def conf_guard(x: any, mask: torch.Tensor) -> any {\n"
+         + "    if not mask.all() {\n"
+         + "        raise ValueError(\"conf mask must be all true\");\n"
+         + "    }\n"
+         + "    return torch.sin(x);\n"
+         + "}\n\n"
+         + "def conf_noisy(x: any) -> any {\n"
+         + "    print(\"CONF\", x);\n"
+         + "    return x;\n"
+         + "}\n";
+
+"""One entry module, one helper it reaches, one torch-importing module nothing
+reaches."""
+def _mk_region_project(tmp: str) -> tuple[str, str, str] {
+    with open(os.path.join(tmp, "jac.toml"), "w") as fh {
+        fh.write(
+            "[project]\nname = \"gmregion\"\nversion = \"0.1.0\"\n"
+                + "entry-point = \"main.jac\"\n"
+        );
+    }
+    main_path = os.path.join(tmp, "main.jac");
+    with open(main_path, "w") as fh {
+        fh.write(CACHE_ENTRY_SRC);
+    }
+    used_path = os.path.join(tmp, "usedmod.jac");
+    with open(used_path, "w") as fh {
+        fh.write(CACHE_USED_SRC);
+    }
+    conf_path = os.path.join(tmp, "confmod.jac");
+    with open(conf_path, "w") as fh {
+        fh.write(CACHE_CONF_SRC);
+    }
+    return (main_path, used_path, conf_path);
+}
+
+test "an entry-less torch module shares its cache artifact with off" {
+    # Every module in the package imports torch, so auto engages GraphMend on
+    # all of them, but only the entry chain has a compiled region. The
+    # entry-less module compiles byte-identical to off, so after one engaged
+    # compile stamps the artifact, auto and off runs share the same cache slot
+    # in both directions.
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, used_path, conf_path) = _mk_region_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_a = JacProgram();
+            code_main = prog_a.get_bytecode(main_path);
+            code_conf = prog_a.get_bytecode(conf_path);
+            assert code_main is not None and code_conf is not None;
+            assert prog_a.mod.hub;
+            assert _mentions_symbol(code_main, "_assert_async");
+            assert not _mentions_symbol(code_conf, "__jac_se_emit__");
+            prog_b = JacProgram();
+            code_b = prog_b.get_bytecode(conf_path);
+            assert code_b is not None;
+            assert not prog_b.mod.hub , (
+                "a second auto run must hit the stamped shared artifact"
+            );
+            config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
+            prog_off = JacProgram();
+            code_off = prog_off.get_bytecode(conf_path);
+            assert code_off is not None;
+            assert not prog_off.mod.hub , (
+                "an off run must share the entry-less module's artifact"
+            );
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+test "a reached helper module keeps its own gm cache variant" {
+    # The helper the entry reaches IS transformed, so its artifact must stay
+    # variant-keyed: an off run may not reuse it and recompiles untransformed.
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, used_path, conf_path) = _mk_region_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_a = JacProgram();
+            code_main = prog_a.get_bytecode(main_path);
+            code_used = prog_a.get_bytecode(used_path);
+            assert code_main is not None and code_used is not None;
+            assert _mentions_symbol(code_used, "__jac_se_emit__") , (
+                "the reached helper must be transformed in realistic order"
+            );
+            config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
+            prog_off = JacProgram();
+            code_off = prog_off.get_bytecode(used_path);
+            assert code_off is not None;
+            assert prog_off.mod.hub , (
+                "an off run must not reuse the transformed helper artifact"
+            );
+            assert not _mentions_symbol(code_off, "__jac_se_emit__");
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+glob REACH_ENTRY_SRC = "import torch;\n"
+         + "import from ..reached { reach_helper }\n\n"
+         + "@torch.compile()\n"
+         + "def `entry(x: any) -> any {\n"
+         + "    return torch.sin(reach_helper(x));\n"
+         + "}\n",
+     REACH_USED_SRC = "import torch;\n\n"
+         + "def reach_helper(x: any) -> any {\n"
+         + "    print(\"REACHED\", x);\n"
+         + "    return torch.relu(x);\n"
+         + "}\n";
+
+"""An entry in a subpackage reaching a helper above that package: the region
+walk follows the from-import, the claim walk, bounded by the entry's package,
+does not, so the helper's own file and configuration say nothing about which
+side of the region it landed on."""
+def _mk_reach_project(tmp: str) -> tuple[(str, str)] {
+    with open(os.path.join(tmp, "jac.toml"), "w") as fh {
+        fh.write("[project]\nname = \"gmreach\"\nversion = \"0.1.0\"\n");
+    }
+    os.mkdir(os.path.join(tmp, "app"));
+    with open(os.path.join(tmp, "app", "__init__.jac"), "w") as fh {
+        fh.write("");
+    }
+    entry_path = os.path.join(tmp, "app", "entry.jac");
+    with open(entry_path, "w") as fh {
+        fh.write(REACH_ENTRY_SRC);
+    }
+    used_path = os.path.join(tmp, "reached.jac");
+    with open(used_path, "w") as fh {
+        fh.write(REACH_USED_SRC);
+    }
+    return (entry_path, used_path);
+}
+
+test "a helper with no region is not served the region artifact" {
+    # Run A is one program, importer first, the order a real run imports in.
+    # Run B is a fresh program on purpose: a separate process compiling the
+    # helper alone, sharing only the warm cache, with no region at all.
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (entry_path, used_path) = _mk_reach_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_a = JacProgram();
+            code_entry = prog_a.get_bytecode(entry_path);
+            code_used = prog_a.get_bytecode(used_path);
+            assert code_entry is not None and code_used is not None;
+            assert _mentions_symbol(code_used, "__jac_se_emit__") , (
+                "the reached helper must be transformed in realistic order"
+            );
+            prog_b = JacProgram();
+            code_b = prog_b.get_bytecode(used_path);
+            assert code_b is not None;
+            assert not _mentions_symbol(code_b, "__jac_se_emit__") , (
+                "a compile with no region must not be served the region artifact"
+            );
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+test "a region member is not served the entry-less artifact" {
+    # The reverse direction. The first program compiles the helper alone, so
+    # its artifact is the untransformed one; the second is a fresh program
+    # compiling the entry first, where the helper IS a region member.
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (entry_path, used_path) = _mk_reach_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_alone = JacProgram();
+            code_alone = prog_alone.get_bytecode(used_path);
+            assert code_alone is not None;
+            assert not _mentions_symbol(code_alone, "__jac_se_emit__");
+            prog_b = JacProgram();
+            code_entry = prog_b.get_bytecode(entry_path);
+            code_used = prog_b.get_bytecode(used_path);
+            assert code_entry is not None and code_used is not None;
+            assert _mentions_symbol(code_used, "__jac_se_emit__") , (
+                "a region member must not be served the entry-less artifact"
+            );
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_region_key.jac b/jac/tests/compiler/passes/test_graphmend_region_key.jac
new file mode 100644
index 0000000..63f2563
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_region_key.jac
@@ -0,0 +1,310 @@
+"""The region cache key derives from the module's reachability closure, so it
+is stable across load orders, indifferent to unrelated modules, and moves
+exactly when a module that feeds the region changes; the guard-lowering
+decision derives from the same closure instead of accumulated program state."""
+import os;
+import from pathlib { Path }
+import from tempfile { TemporaryDirectory }
+import from tests.support { code_mentions_symbol as _mentions_symbol }
+import from jaclang.compiler.driver.program { JacProgram }
+import from jaclang.compiler.driver.jir { get_module_cache_path }
+import from jaclang.project.config { JacConfig }
+import jaclang.project.config as config_mod;
+
+glob KEY_ENTRY_SRC = "import torch;\n"
+         + "import from usedmod { used_helper }\n\n"
+         + "@torch.compile()\n"
+         + "def f(x: any, mask: torch.Tensor) -> any {\n"
+         + "    x = torch.relu(used_helper(x));\n"
+         + "    if not mask.all() {\n"
+         + "        raise ValueError(\"mask must be all true\");\n"
+         + "    }\n"
+         + "    return torch.sin(x) * 2.0;\n"
+         + "}\n",
+     KEY_ENTRY_EDIT_SRC = "import torch;\n"
+         + "import from usedmod { used_helper }\n\n"
+         + "@torch.compile()\n"
+         + "def f(x: any, mask: torch.Tensor) -> any {\n"
+         + "    x = torch.relu(used_helper(x));\n"
+         + "    if not mask.all() {\n"
+         + "        raise ValueError(\"mask must hold no false entry\");\n"
+         + "    }\n"
+         + "    return torch.sin(x) * 2.0;\n"
+         + "}\n",
+     KEY_USED_SRC = "import torch;\n\n"
+         + "def used_helper(x: any) -> any {\n"
+         + "    print(\"USED\", x);\n"
+         + "    return torch.relu(x);\n"
+         + "}\n",
+     KEY_UNREL_SRC = "import torch;\n\n"
+         + "def unrel_guard(x: any, mask: torch.Tensor) -> any {\n"
+         + "    if not mask.all() {\n"
+         + "        raise ValueError(\"unrel mask must be all true\");\n"
+         + "    }\n"
+         + "    return torch.sin(x);\n"
+         + "}\n\n"
+         + "def unrel_noisy(x: any) -> any {\n"
+         + "    print(\"UNREL\", x);\n"
+         + "    return x;\n"
+         + "}\n";
+
+"""An entry, the helper its region reaches, and a torch module nothing touches."""
+def _mk_key_project(tmp: str) -> tuple[str, str, str] {
+    with open(os.path.join(tmp, "jac.toml"), "w") as fh {
+        fh.write(
+            "[project]\nname = \"gmregionkey\"\nversion = \"0.1.0\"\n"
+                + "entry-point = \"main.jac\"\n"
+        );
+    }
+    main_path = os.path.join(tmp, "main.jac");
+    with open(main_path, "w") as fh {
+        fh.write(KEY_ENTRY_SRC);
+    }
+    used_path = os.path.join(tmp, "usedmod.jac");
+    with open(used_path, "w") as fh {
+        fh.write(KEY_USED_SRC);
+    }
+    unrel_path = os.path.join(tmp, "unrel.jac");
+    with open(unrel_path, "w") as fh {
+        fh.write(KEY_UNREL_SRC);
+    }
+    return (main_path, used_path, unrel_path);
+}
+
+test "an unrelated torch module in the program does not move the cache key" {
+    # Run B loads an unrelated module first; the entry and helper artifacts
+    # cached by run A must still hit, since nothing in their closure changed.
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, used_path, unrel_path) = _mk_key_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_a = JacProgram();
+            assert prog_a.get_bytecode(main_path) is not None;
+            code_used_a = prog_a.get_bytecode(used_path);
+            assert code_used_a is not None;
+            assert _mentions_symbol(code_used_a, "__jac_se_emit__");
+            prog_b = JacProgram();
+            assert prog_b.get_bytecode(unrel_path) is not None;
+            code_main_b = prog_b.get_bytecode(main_path);
+            assert code_main_b is not None;
+            assert main_path not in prog_b.mod.hub , (
+                "an unrelated module in the program moved the entry's cache key"
+            );
+            code_used_b = prog_b.get_bytecode(used_path);
+            assert code_used_b is not None;
+            assert used_path not in prog_b.mod.hub , (
+                "an unrelated module in the program moved the helper's cache key"
+            );
+            assert _mentions_symbol(code_used_b, "__jac_se_emit__");
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+test "the cache key is stable across module load orders" {
+    # Same module set, permuted load order: the helper's key may not depend on
+    # what happened to be compiled into the program first.
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, used_path, unrel_path) = _mk_key_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_a = JacProgram();
+            assert prog_a.get_bytecode(main_path) is not None;
+            assert prog_a.get_bytecode(used_path) is not None;
+            prog_c = JacProgram();
+            assert prog_c.get_bytecode(main_path) is not None;
+            assert prog_c.get_bytecode(unrel_path) is not None;
+            code_used_c = prog_c.get_bytecode(used_path);
+            assert code_used_c is not None;
+            assert used_path not in prog_c.mod.hub , (
+                "a permuted load order moved the helper's cache key"
+            );
+            assert _mentions_symbol(code_used_c, "__jac_se_emit__");
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+test "editing a module that feeds the region invalidates the dependent" {
+    # The helper's own source is unchanged; only the entry that feeds its
+    # region moved, so the helper must recompile rather than hit.
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (main_path, used_path, unrel_path) = _mk_key_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_a = JacProgram();
+            assert prog_a.get_bytecode(main_path) is not None;
+            assert prog_a.get_bytecode(used_path) is not None;
+            with open(main_path, "w") as fh {
+                fh.write(KEY_ENTRY_EDIT_SRC);
+            }
+            prog_d = JacProgram();
+            assert prog_d.get_bytecode(main_path) is not None;
+            code_used_d = prog_d.get_bytecode(used_path);
+            assert code_used_d is not None;
+            assert used_path in prog_d.mod.hub , (
+                "a feeder edit must invalidate the dependent's cached artifact"
+            );
+            assert _mentions_symbol(code_used_d, "__jac_se_emit__");
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+glob WRAP_NET_SRC = "import torch;\n\n"
+         + "def net_helper(x: any) -> any {\n"
+         + "    print(\"NET-HELPER\", x);\n"
+         + "    return x * 2.0;\n"
+         + "}\n\n"
+         + "class Net(torch.nn.Module) {\n"
+         + "    def forward(self: any, x: any, mask: torch.Tensor) -> any {\n"
+         + "        if not mask.all() {\n"
+         + "            raise ValueError(\"net mask must be all true\");\n"
+         + "        }\n"
+         + "        return net_helper(torch.relu(x));\n"
+         + "    }\n"
+         + "}\n",
+     WRAP_ENTRY_SRC = "import torch;\n"
+         + "import from netmod { Net }\n\n"
+         + "glob model = torch.compile(Net());\n";
+
+"""A wrap-site entry module and the model module holding the guard."""
+def _mk_wrap_project(tmp: str) -> tuple[str, str] {
+    with open(os.path.join(tmp, "jac.toml"), "w") as fh {
+        fh.write(
+            "[project]\nname = \"gmwrapkey\"\nversion = \"0.1.0\"\n"
+                + "entry-point = \"entry.jac\"\n"
+        );
+    }
+    entry_path = os.path.join(tmp, "entry.jac");
+    with open(entry_path, "w") as fh {
+        fh.write(WRAP_ENTRY_SRC);
+    }
+    net_path = os.path.join(tmp, "netmod.jac");
+    with open(net_path, "w") as fh {
+        fh.write(WRAP_NET_SRC);
+    }
+    return (entry_path, net_path);
+}
+
+test "a guard lowers the same when the wrapping entry is a cache hit" {
+    # Run 2 recompiles only the model module while the wrapping entry hits the
+    # cache; the guard's fate may not depend on which artifacts were hits.
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            (entry_path, net_path) = _mk_wrap_project(tmpdir);
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog1 = JacProgram();
+            assert prog1.get_bytecode(entry_path) is not None;
+            code_net1 = prog1.get_bytecode(net_path);
+            assert code_net1 is not None;
+            assert _mentions_symbol(code_net1, "_assert_async") , (
+                "the cold compile order must lower the covered guard"
+            );
+            net_cache = get_module_cache_path(net_path);
+            assert net_cache.exists();
+            net_cache.unlink();
+            prog2 = JacProgram();
+            assert prog2.get_bytecode(entry_path) is not None;
+            code_net2 = prog2.get_bytecode(net_path);
+            assert code_net2 is not None;
+            assert _mentions_symbol(code_net2, "__jac_se_emit__");
+            assert _mentions_symbol(code_net2, "_assert_async") , (
+                "the guard's fate changed because the wrapping entry was a "
+                + "cache hit instead of a compile"
+            );
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+glob BROKEN_TORCH_SRC = "import torch;\n\n"
+         + "def broken(x: any) -> any {\n"
+         + "    return torch.relu(x;\n"
+         + "}\n";
+
+"""Count the alerts recorded against `path` in `prog`."""
+def _target_errors(prog: JacProgram, path: str) -> int {
+    real = os.path.realpath(path);
+    n = 0;
+    for e in prog.errors_had {
+        try {
+            p = os.path.realpath(e.loc.mod_path);
+        } except Exception {
+            continue;
+        }
+        if p == real {
+            n += 1;
+        }
+    }
+    return n;
+}
+
+test "a broken torch source reports its errors exactly once through the probe" {
+    # The probe parses the target speculatively and trims the alerts it added;
+    # the real compile must then report them once, neither zero nor twice.
+    old_config = config_mod._config;
+    try {
+        with TemporaryDirectory() as tmpdir {
+            tmpdir = os.path.realpath(tmpdir);
+            with open(os.path.join(tmpdir, "jac.toml"), "w") as fh {
+                fh.write(
+                    "[project]\nname = \"gmbroken\"\nversion = \"0.1.0\"\n"
+                        + "entry-point = \"broken.jac\"\n"
+                );
+            }
+            broken_path = os.path.join(tmpdir, "broken.jac");
+            with open(broken_path, "w") as fh {
+                fh.write(BROKEN_TORCH_SRC);
+            }
+            config_mod._config = JacConfig.load(Path(tmpdir) / "jac.toml");
+            prog_on = JacProgram();
+            assert prog_on.get_bytecode(broken_path) is None;
+            n_on = _target_errors(prog_on, broken_path);
+            assert n_on > 0 , (
+                "a broken source must still report its errors after the probe"
+            );
+            config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
+            prog_off = JacProgram();
+            assert prog_off.get_bytecode(broken_path) is None;
+            n_off = _target_errors(prog_off, broken_path);
+            assert n_on == n_off , (
+                f"the probe changed the error count: {n_on} with the probe, "
+                + f"{n_off} without"
+            );
+        }
+    } finally {
+        config_mod._config = old_config;
+    }
+}
+
+test "a wrap seen only through facts materialization covers the guard" {
+    # The entry is parsed into the hub by the claim walk, never compiled; the
+    # lowering decision must derive from that closure, not from compile events.
+    import from tests.support { graphmend_compile_opts as _compile_opts }
+    import from jaclang.compiler.driver.compile_options { CompileOptions }
+    import from jaclang.compiler.passes.graphmend.scope_facts { claim_path }
+    with TemporaryDirectory() as tmpdir {
+        tmpdir = os.path.realpath(tmpdir);
+        (entry_path, net_path) = _mk_wrap_project(tmpdir);
+        prog = JacProgram();
+        assert claim_path(prog, entry_path) , "the wrap entry must claim itself";
+        (net_src, _bc) = _compile_opts(net_path, CompileOptions(graphmend=True), prog);
+        assert "torch._assert_async(mask.all(), " in net_src , (
+            "a wrap visible in the hub must cover the guard without a compile"
+        );
+        assert "raise ValueError" not in net_src;
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_side_effect.jac b/jac/tests/compiler/passes/test_graphmend_side_effect.jac
new file mode 100644
index 0000000..ce13339
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_side_effect.jac
@@ -0,0 +1,444 @@
+"""Deferred side-effect rewrites: buffered emits, hoisted returns, eager flush boundary."""
+import os;
+import tempfile;
+import from tests.support {
+    graphmend_break_kinds as _break_kinds,
+    graphmend_compile_path as _compile_path,
+    graphmend_pysrc as _pysrc
+}
+import from jaclang.lib.jaclib {
+    __jac_log_emit__,
+    __jac_log_flush_hook__,
+    __jac_log_register__,
+    __jac_se_emit__,
+    __jac_se_region_open__
+}
+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.passes.graphmend.ast_edit {
+    append_stmt,
+    gen_name,
+    insert_before
+}
+
+glob _LOG_SEEN: list = [];
+
+"""Record a replayed log message (flush-hook probe)."""
+def _record_log(msg: str) {
+    _LOG_SEEN.append(msg);
+}
+
+"""Raise from inside a replayed log call (flush-hook probe)."""
+def _raise_log(msg: str) {
+    raise RuntimeError("logger down");
+}
+
+glob _EAGER_LOG_SEEN: list = [];
+
+"""Record a message emitted through the slot registry (eager-path probe)."""
+def _record_eager(msg: str) {
+    _EAGER_LOG_SEEN.append(msg);
+}
+
+glob _NESTED_SEEN: list = [];
+
+"""Record a replayed call from either buffer (nested-region probe)."""
+def _record_nested(msg: str) {
+    _NESTED_SEEN.append(msg);
+}
+
+"""Registered twice by the slot-stability test; never called."""
+def _slot_probe(msg: str) {
+    ;
+}
+
+"""A Python-source model with a print between tensor ops.
+
+Written to a temp file at test time rather than checked in as a .py fixture:
+the repository does not accept new Python files, and the point of the fixture
+is only that GraphMend ingests .py source, which a generated file exercises
+just as well."""
+glob PY_SIDE_EFFECT_SRC = '''
+import torch
+
+
+@torch.compile()
+def f(x):
+    x = torch.relu(x)
+    print(x)
+    return torch.sin(x) * 2.0
+''';
+
+"""Compile the generated .py model above and return its Python lowering."""
+def _py_fixture_src(gm: bool) -> str {
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, "py_side_effect.py");
+        with open(path, "w") as fh {
+            fh.write(PY_SIDE_EFFECT_SRC);
+        }
+        return _compile_path(path, gm);
+    }
+}
+
+glob PY_LOCAL_LOGGER_SRC = '''
+import torch
+
+
+class Net(torch.nn.Module):
+    def forward(self, x, local_logger):
+        x = torch.relu(x)
+        local_logger.warning("GM-LOCAL")
+        return torch.sin(x) * 2.0
+
+
+model = torch.compile(Net())
+''';
+
+"""Compile the local-receiver forward model and return its Python lowering."""
+def _py_local_logger_src(gm: bool) -> str {
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, "py_local_logger.py");
+        with open(path, "w") as fh {
+            fh.write(PY_LOCAL_LOGGER_SRC);
+        }
+        return _compile_path(path, gm);
+    }
+}
+
+test "print is buffered and flushed via the runtime helper" {
+    src = _pysrc("side_effect.jac", True);
+    # The mutable positional arg is snapshotted: hoisted to a temp and cloned (if
+    # a tensor) at the call site so a later in-place mutation cannot corrupt the
+    # deferred value.
+    assert "__gm_se_arg_0 = x" in src;
+    assert (
+        "__jac_se_emit__(print, "
+        "(__gm_se_arg_0.clone() if hasattr(__gm_se_arg_0, 'clone') "
+        "else __gm_se_arg_0,), {})"
+    )
+        in src;
+    assert "__jac_se_flush__()" in src;
+    assert (
+        "from jaclang.lib.jaclib import "
+        "__jac_se_emit__, __jac_se_flush__, __jac_se_guard__"
+    )
+        in src;
+    assert _break_kinds("side_effect.jac") == ["side_effect"];
+}
+
+test "a compiled function gets the eager boundary guard" {
+    src = _pysrc("side_effect.jac", True);
+    # The guard must sit ABOVE @torch.compile: prepended, it wraps the compiled
+    # callable from outside, so its try/finally is never traced. Placed inside
+    # the compiled region an untraceable finally makes Dynamo abandon the frame.
+    assert "@__jac_se_guard__" in src;
+    assert src.index("@__jac_se_guard__") < src.index("@torch.compile");
+}
+
+test "return value is hoisted so the flush follows all compute" {
+    src = _pysrc("side_effect.jac", True);
+    # compute assigned to a temp, then flush, then return the temp
+    assert "__gm_ret_0 = torch.sin(x) * 2.0" in src;
+    assert src.index("__gm_ret_0 = ") < src.index("__jac_se_flush__()");
+    assert src.index("__jac_se_flush__()") < src.index("return __gm_ret_0");
+}
+
+test "the buffer is flushed before every return" {
+    src = _pysrc("side_effect_early_return.jac", True);
+    # two exit paths, each preceded by its own flush; both return temps hoisted
+    assert src.count("__jac_se_flush__()") == 2;
+    assert src.count("return __gm_ret_") == 2;
+}
+
+test "logger call is buffered the same way as print" {
+    src = _pysrc("side_effect_logger.jac", True);
+    assert "__jac_se_emit__(log.warning, ('deprecated path',), {})" in src;
+    assert "__jac_se_flush__()" in src;
+}
+
+test "a buffered call's keyword arguments are preserved" {
+    src = _pysrc("logger_kwargs.jac", True);
+    assert (
+        "__jac_se_emit__(logger.warning, ('deprecated',), {'stacklevel': 2})" in src
+    );
+}
+
+test "a non-literal keyword value is snapshotted like a positional" {
+    src = _pysrc("side_effect_kwarg.jac", True);
+    assert "__gm_se_arg_0 = y" in src;
+    assert (
+        "{'extra': __gm_se_arg_0.clone() if hasattr(__gm_se_arg_0, 'clone') "
+        "else __gm_se_arg_0}"
+    )
+        in src;
+}
+
+test "an unpacked argument declines instead of being dropped" {
+    # Detection still tags both; the decline belongs to the transform.
+    src = _pysrc("side_effect_unpack.jac", True);
+    assert "__jac_se_emit__" not in src;
+    assert "print('head', *extra)" in src;
+    assert "logger.warning('deprecated', **opts)" in src;
+    assert _break_kinds("side_effect_unpack.jac") == ["side_effect", "side_effect"];
+}
+
+test "a receiver that does not bind to a logger is left untouched" {
+    # A parameter receiver has no logger-proving binding, so the call is not
+    # tagged at all: no module-scope slot, no buffer, the break stays.
+    src = _py_local_logger_src(True);
+    assert "__jac_log_register__" not in src;
+    assert "__jac_se_emit__" not in src;
+    assert "local_logger.warning('GM-LOCAL')" in src;
+}
+
+test "a logging-named method on a non-logger receiver is not tagged" {
+    # The receiver base must bind to a logger (a logging module import or a
+    # getLogger/get_logger assignment); an arbitrary module declines.
+    src = _pysrc("se_foreign_warn.jac", True);
+    assert "__jac_se_emit__" not in src;
+    assert "myutils.warn_user(y)" in src;
+    assert _break_kinds("se_foreign_warn.jac") == [];
+}
+
+test "an unresolved logger base refuses the module-slot proof" {
+    # _base_binds_at_module is the proof that the receiver binds at module
+    # scope, so the slot registration emitted there can resolve the name; a
+    # Name with no symbol proves nothing and must fail closed. Detection
+    # (_base_binds_logger) filters unresolved bases before this pass runs, so
+    # the polarity is pinned on the proof itself, not on an end-to-end rewrite
+    # that would pass either way.
+    import from jaclang.compiler.passes.graphmend.defer_side_effect_pass {
+        DeferSideEffectPass
+    }
+    import from jaclang.compiler.driver.compile_options { CompileOptions }
+    import from jaclang.compiler.driver.program { JacProgram }
+    prog = JacProgram();
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, "defer_polarity.jac");
+        with open(path, "w") as fh {
+            fh.write("with entry { x = 1; }\n");
+        }
+        mod = prog.compile(file_path=path, options=CompileOptions(graphmend=False));
+    }
+    dp = DeferSideEffectPass(ir_in=mod, prog=prog);
+    base = gen_name(mod, "logger", False);
+    assert base.sym is None;
+    assert dp._base_binds_at_module(base) is False , (
+        "an unresolved base must not prove a module-scope binding"
+    );
+    meth = gen_name(mod, "warning", False);
+    trailer = uni.AtomTrailer(
+        target=base, right=meth, is_attr=True, is_null_ok=False, kid=[base, meth]
+    );
+    call = uni.FuncCall(target=trailer, params=[], genai_call=None, kid=[trailer]);
+    assert dp._is_logger_call(call) is False , (
+        "an unproven base must take the buffered path, not a module slot"
+    );
+}
+
+test "a user-defined name matching a logging pattern is not tagged" {
+    # `warn_and_scale` contains the `warn` pattern, but the name resolves to a
+    # local function; rewriting it would defer arbitrary user compute.
+    src = _pysrc("user_defined_warn.jac", True);
+    assert "__jac_se_emit__" not in src;
+    assert "y = warn_and_scale(x)" in src;
+    assert _break_kinds("user_defined_warn.jac") == [];
+}
+
+test "py source: print side effect is buffered and flushed" {
+    # The .py front-end (PyastBuildPass) produces UniIR whose nodes unparse
+    # differently from .jac-origin nodes, so the rewrite must operate
+    # structurally; this guards `jac run model.py` under the default auto mode.
+    src = _py_fixture_src(True);
+    assert "__gm_se_arg_0 = x" in src;
+    assert "__jac_se_emit__(print, " in src;
+    assert "__jac_se_flush__()" in src;
+    src = _py_fixture_src(False);
+    assert "__jac_se_emit__" not in src;
+    assert "print(x)" in src;
+}
+
+test "no buffering when graphmend disabled" {
+    src = _pysrc("side_effect.jac", False);
+    assert "__jac_se_emit__" not in src;
+    assert "__jac_se_guard__" not in src;
+    assert "print(x)" in src;
+}
+
+test "a deferred logger call emits immediately when no region is open" {
+    # A [Defer] rewrite must be behavior-preserving on the eager path: with no
+    # compiled region open there is nothing to defer to, so the slot call goes
+    # straight through, exactly as __jac_se_emit__ does at depth 0. Buffering it
+    # would hold the message until some unrelated region exits, or drop it.
+    slot = __jac_log_register__(_record_eager);
+    __jac_log_emit__(slot, ("eager", ), {});
+    assert _EAGER_LOG_SEEN == ["eager"] , (
+        f"eager logger call was buffered instead of emitted: {_EAGER_LOG_SEEN}"
+    );
+    # Inside an open region (what the injected forward pre-hook does) the same
+    # call must still buffer and replay on the flush hook.
+    __jac_se_region_open__(None, None);
+    __jac_log_emit__(slot, ("deferred", ), {});
+    assert _EAGER_LOG_SEEN == ["eager"] , (
+        f"call inside an open region was not deferred: {_EAGER_LOG_SEEN}"
+    );
+    __jac_log_flush_hook__(None, None, None);
+    assert _EAGER_LOG_SEEN == ["eager", "deferred"] , (
+        f"deferred call was not replayed: {_EAGER_LOG_SEEN}"
+    );
+}
+
+test "re-registering the same callable reuses its slot" {
+    # Module re-execution re-runs the emitted slot registrations, and the
+    # registry can never evict: live slot integers sit in module globals and
+    # in compiled graphs, so removal or renumbering would break them. Reusing
+    # the existing slot for an equivalent callable is what bounds regrowth.
+    import jaclang.runtime.runtime as rt;
+    s1 = __jac_log_register__(_slot_probe);
+    n1 = len(rt._gm_log_registry);
+    s2 = __jac_log_register__(_slot_probe);
+    assert s2 == s1 , f"same callable got a new slot: {s1} then {s2}";
+    assert len(rt._gm_log_registry) == n1 , "re-registration grew the registry";
+    assert rt._gm_log_registry[s1] is _slot_probe;
+    # A bound method re-read from the same instance is a fresh object each
+    # access; dedup must key on the underlying function and receiver.
+    import logging;
+    lg = logging.getLogger("gm_slot_dedup");
+    b1 = __jac_log_register__(lg.info);
+    n2 = len(rt._gm_log_registry);
+    b2 = __jac_log_register__(lg.info);
+    assert b2 == b1 , f"same bound method got a new slot: {b1} then {b2}";
+    assert len(rt._gm_log_registry) == n2;
+    assert b1 != s1;
+}
+
+test "a raising log call cannot replay stale entries on the next pass" {
+    # The flush hook snapshots and clears the buffer BEFORE replaying, so a
+    # log call that raises drops the batch instead of re-emitting it later.
+    ok_slot = __jac_log_register__(_record_log);
+    boom_slot = __jac_log_register__(_raise_log);
+    __jac_se_region_open__(None, None);
+    __jac_log_emit__(boom_slot, ("first", ), {});
+    __jac_log_emit__(ok_slot, ("second", ), {});
+    raised = None;
+    try {
+        __jac_log_flush_hook__(None, None, None);
+    } except RuntimeError as e {
+        raised = e;
+    }
+    assert raised is not None;
+    __jac_log_emit__(ok_slot, ("third", ), {});
+    __jac_log_flush_hook__(None, None, None);
+    assert _LOG_SEEN == ["third"] , f"stale entries replayed: {_LOG_SEEN}";
+}
+
+test "a nested region exit leaves the enclosing region's buffers intact" {
+    # Nested compiled modules share one context-local depth counter. The inner
+    # module's post-hook drops the depth to 1, not 0: draining there would run
+    # the outer region's buffered calls mid-trace, which is what deferral
+    # exists to prevent, and dynamo replays them again on a recompile.
+    slot = __jac_log_register__(_record_nested);
+    __jac_se_region_open__(None, None);
+    __jac_se_emit__(_record_nested, ("outer-se", ), {});
+    __jac_log_emit__(slot, ("outer-log", ), {});
+    __jac_se_region_open__(None, None);
+    __jac_log_flush_hook__(None, None, None);
+    assert _NESTED_SEEN == [] , (
+        f"inner region exit drained the outer buffers: {_NESTED_SEEN}"
+    );
+    __jac_log_flush_hook__(None, None, None);
+    assert _NESTED_SEEN == ["outer-se", "outer-log"] , (
+        f"outer region exit did not replay: {_NESTED_SEEN}"
+    );
+    # Drained exactly once: the snapshot-and-clear happens on the outer exit.
+    __jac_log_flush_hook__(None, None, None);
+    assert _NESTED_SEEN == ["outer-se", "outer-log"] , (
+        f"entries replayed twice: {_NESTED_SEEN}"
+    );
+}
+
+glob GLOB_TAIL_SRC = "import torch;\n\nglob m = torch.relu;\n";
+
+"""Compile a .jac source string and return its module node."""
+def _compile_mod(src: str) -> uni.Module {
+    import from jaclang.compiler.driver.compile_options { CompileOptions }
+    import from jaclang.compiler.driver.program { JacProgram }
+    with tempfile.TemporaryDirectory() as tmp {
+        path = os.path.join(tmp, "glob_mod.jac");
+        with open(path, "w") as fh {
+            fh.write(src);
+        }
+        return JacProgram().compile(file_path=path, options=CompileOptions());
+    }
+}
+
+test "insert_before climbs out of a module-level glob to the module body" {
+    # The anchor assignment lives in a GlobalVars, whose assignments list has
+    # no statement slot; the insert must land on the module body before the
+    # glob statement, not be dropped.
+    mod = _compile_mod(GLOB_TAIL_SRC);
+    gv = mod.get_all_sub_nodes(uni.GlobalVars)[0];
+    anchor = gv.assignments[0];
+    nm = gen_name(anchor, "__gm_probe__", False);
+    stmt = uni.ExprStmt(expr=nm, in_fstring=False, kid=[nm]);
+    assert insert_before(anchor, stmt);
+    assert stmt in mod.body;
+    assert mod.body.index(stmt) == mod.body.index(gv) - 1;
+    assert mod.kid.index(stmt) == mod.kid.index(gv) - 1;
+    assert stmt.parent is mod;
+}
+
+test "append_stmt lands after a trailing module-level glob" {
+    mod = _compile_mod(GLOB_TAIL_SRC);
+    gv = mod.get_all_sub_nodes(uni.GlobalVars)[0];
+    nm = gen_name(gv, "__gm_probe__", False);
+    stmt = uni.ExprStmt(expr=nm, in_fstring=False, kid=[nm]);
+    assert append_stmt(mod, stmt);
+    assert mod.body[-1] is stmt;
+    assert mod.kid.index(stmt) == mod.kid.index(gv) + 1;
+    assert stmt.parent is mod;
+}
+
+test "a jac glob call-site wrap gets the forward hook registrations" {
+    # `glob m = torch.compile(...)` puts the assignment inside a GlobalVars,
+    # whose `assignments` list is the only thing emitted. Without hooks the
+    # region never opens, so every [Defer] rewrite in the module is a runtime
+    # no-op and the graph break it was meant to close survives.
+    src = _pysrc("region_wrap_cls.jac", True);
+    assert "if hasattr(compiled_net, 'register_forward_pre_hook'):" in src;
+    assert "compiled_net.register_forward_pre_hook(__jac_se_region_open__)" in src;
+    assert (
+        "compiled_net.register_forward_hook(__jac_log_flush_hook__, always_call=True)"
+        in src
+    );
+}
+
+test "serve declines defer only, leaving trap and where to run" {
+    # The defer buffers are process-global, so the transform whose residual that
+    # is declines under serve; the other two transforms are unaffected.
+    import from jaclang.compiler.driver.compile_options {
+        CompileOptions,
+        defer_declines_here,
+        mark_process_serving,
+        process_is_serving
+    }
+    import jaclang.compiler.driver.compile_options as opt_mod;
+    saved = dict(opt_mod._serving_probe);
+    try {
+        opt_mod._serving_probe["serving"] = False;
+        assert process_is_serving() is False;
+        assert defer_declines_here() is False;
+        mark_process_serving();
+        assert process_is_serving() is True;
+        assert defer_declines_here() is True , (
+            "defer must decline while the buffers are process-global and serving"
+        );
+        assert CompileOptions().graphmend is not False , (
+            "serve must not disable graphmend wholesale; only defer declines"
+        );
+        assert "trap" not in (CompileOptions().graphmend_disable or []) , "trap must still run under serve";
+        assert "where" not in (CompileOptions().graphmend_disable or []) , "where must still run under serve";
+    } finally {
+        opt_mod._serving_probe.clear();
+        opt_mod._serving_probe.update(saved);
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_tags.jac b/jac/tests/compiler/passes/test_graphmend_tags.jac
new file mode 100644
index 0000000..e760557
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_tags.jac
@@ -0,0 +1,113 @@
+"""Pass-schedule tags and the schedule-time gate."""
+import os;
+import from tests.support { GRAPHMEND_FIXTURES as FIXTURES }
+import from jaclang.compiler.driver.schedules { get_py_code_gen, validate_schedule }
+import from jaclang.compiler.passes.graphmend.graph_break_detect_pass {
+    GraphBreakDetectPass
+}
+import from jaclang.compiler.passes.graphmend.trap_lowering_pass { TrapLoweringPass }
+import from jaclang.compiler.passes.graphmend.predicate_ctrl_flow_pass {
+    PredicateCtrlFlowPass
+}
+import from jaclang.compiler.passes.graphmend.defer_side_effect_pass {
+    DeferSideEffectPass
+}
+
+test "detect pass provides the graph-breaks tag" {
+    assert GraphBreakDetectPass.PROVIDES == ('graph-breaks', );
+}
+
+test "transform passes require the graph-breaks tag" {
+    for p in [TrapLoweringPass, PredicateCtrlFlowPass, DeferSideEffectPass] {
+        assert 'graph-breaks' in p.REQUIRES;
+    }
+}
+
+test "the transform ordering constraints are declared as tags" {
+    assert 'lowered-guards' in TrapLoweringPass.PROVIDES;
+    assert 'lowered-guards' in PredicateCtrlFlowPass.REQUIRES;
+    assert 'predicated-branches' in PredicateCtrlFlowPass.PROVIDES;
+    assert 'predicated-branches' in DeferSideEffectPass.REQUIRES;
+}
+
+test "the graphmend schedule order derives from tags, not goal position" {
+    ordered: list[type] = [
+        GraphBreakDetectPass,
+        TrapLoweringPass,
+        PredicateCtrlFlowPass,
+        DeferSideEffectPass
+    ];
+    assert validate_schedule(ordered, origin='graphmend tag-derivation test')
+        == ordered;
+    scrambled: list[type] = [
+        DeferSideEffectPass,
+        PredicateCtrlFlowPass,
+        TrapLoweringPass
+    ];
+    refused = False;
+    try {
+        validate_schedule(scrambled, origin='graphmend tag-derivation test');
+    } except RuntimeError {
+        refused = True;
+    }
+    assert refused , "an order that ignores the tags must be refused";
+}
+
+glob GM_PASSES: list[type] = [
+         GraphBreakDetectPass,
+         TrapLoweringPass,
+         PredicateCtrlFlowPass,
+         DeferSideEffectPass
+     ];
+
+test "codegen schedule orders detect before the transforms and validates" {
+    sched = get_py_code_gen(native=False);
+    validate_schedule(sched, origin='graphmend tag test');
+    assert sched.index(GraphBreakDetectPass) < sched.index(TrapLoweringPass);
+    assert sched.index(TrapLoweringPass) < sched.index(PredicateCtrlFlowPass);
+    assert sched.index(PredicateCtrlFlowPass) < sched.index(DeferSideEffectPass);
+}
+
+test "an off codegen schedule leaves the four passes out entirely" {
+    sched = get_py_code_gen(native=False, graphmend=False);
+    validate_schedule(sched, origin='graphmend off schedule');
+    for p in GM_PASSES {
+        assert p not in sched , f"{p.__name__} must not be scheduled when off";
+    }
+}
+
+"""Compile a fixture under the given graphmend setting and collect every pass
+the compiler actually resolved into a schedule."""
+def _scheduled_passes(name: str, gm: bool) -> list {
+    import from jaclang.compiler.driver.compiler { JacCompiler }
+    import from jaclang.compiler.driver.compile_options { CompileOptions }
+    import from jaclang.compiler.driver.program { JacProgram }
+    seen: list = [];
+    orig: any = JacCompiler.run_schedule;
+    def _spy(
+        self: any, mod: any, target_program: any, passes: any, cancel_token: any = None
+    ) {
+        seen.extend(passes);
+        orig(self, mod, target_program, passes, cancel_token);
+    }
+    JacCompiler.run_schedule = _spy;
+    try {
+        JacProgram().compile(
+            file_path=os.path.join(FIXTURES, name), options=CompileOptions(graphmend=gm)
+        );
+    } finally {
+        JacCompiler.run_schedule = orig;
+    }
+    return seen;
+}
+
+test "an off compile never instantiates the graphmend passes" {
+    off = _scheduled_passes("val_guard_all.jac", False);
+    for p in GM_PASSES {
+        assert p not in off , f"{p.__name__} was scheduled on an off compile";
+    }
+    on = _scheduled_passes("val_guard_all.jac", True);
+    for p in GM_PASSES {
+        assert p in on , f"{p.__name__} must run when graphmend is live";
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_trap_integration.jac b/jac/tests/compiler/passes/test_graphmend_trap_integration.jac
new file mode 100644
index 0000000..624d160
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_trap_integration.jac
@@ -0,0 +1,209 @@
+"""Torch-gated: guard lowering collapses the split forward pass back to one FX graph."""
+import ast;
+import os;
+import from tests.support { GRAPHMEND_FIXTURES as FIXTURES }
+import from jaclang.lib.jaclib { __jac_trap_guard__ }
+import from jaclang.compiler.driver.program { JacProgram }
+import from jaclang.compiler.driver.compile_options { CompileOptions }
+
+"""Import torch or skip the calling test."""
+def _torch -> any {
+    try {
+        import torch;
+        return torch;
+    } except ImportError {
+        testskip("torch not installed");
+    }
+}
+
+"""Compile a fixture (with/without graphmend) and exec its generated Python.
+
+``@torch.compile`` is rebound while exec'ing: to identity when `eager` is
+False (the caller drives the raw function through a counting backend), or to
+a REAL eager-backend compile when `eager` is True (the graph-native assert
+then fails asynchronously at the call boundary, where the injected
+``@__jac_trap_guard__`` decorator catches it -- exactly the production path)."""
+def _exec_gm(fixture: str, graphmend: bool, eager: bool) -> dict {
+    torch = _torch();
+    prog = JacProgram();
+    mod = prog.compile(
+        file_path=os.path.join(FIXTURES, fixture),
+        options=CompileOptions(graphmend=graphmend)
+    );
+    pa = mod.gen.py_ast;
+    mod_ast: any = pa[0] if isinstance(pa, list) else pa;
+    src = ast.unparse(mod_ast);
+    ns: dict = {};
+    orig_compile = torch.compile;
+    def _shim(*a: any, **k: any) -> any {
+        def _wrap(f: any) -> any {
+            return orig_compile(f, backend="eager") if eager else f;
+        }
+        if a {
+            return _wrap(a[0]);
+        }
+        return _wrap;
+    }
+    torch.compile = _shim;
+    try {
+        exec(compile(src, fixture, "exec"), ns);
+    } finally {
+        torch.compile = orig_compile;
+    }
+    return ns;
+}
+
+"""Count the contiguous graphs the backend receives for one call of `fn_name`."""
+def _count_graphs(fixture: str, graphmend: bool, fn_name: str, args: tuple) -> int {
+    torch = _torch();
+    ns = _exec_gm(fixture, graphmend, False);
+    graphs: list = [];
+    def _backend(gm: any, inputs: any) -> any {
+        graphs.append(gm);
+        return gm.forward;
+    }
+    torch._dynamo.reset();
+    torch.compile(ns[fn_name], backend=_backend)(*args);
+    return len(graphs);
+}
+
+test "validation guards defragment to one contiguous graph" {
+    torch = _torch();
+    x = torch.tensor([1.0, 2.0, 3.0]);
+    mask = torch.tensor([True, True, True]);
+    for (fixture, args) in [
+        ("val_guard_all.jac", (x, mask)),
+        ("val_guard.jac", (x, x.clone()))
+    ] {
+        orig = _count_graphs(fixture, False, "f", args);
+        fixed = _count_graphs(fixture, True, "f", args);
+        assert orig >= 2 , f"{fixture}: expected >=2 graphs without GraphMend, got {orig}";
+        assert fixed == 1 , f"{fixture}: expected 1 graph with GraphMend, got {fixed}";
+    }
+}
+
+test "trap guard restores exception type and message" {
+    # A failing tensor-bool guard must surface as the ORIGINAL exception type
+    # (ValueError) with the original message, not a raw RuntimeError --
+    # restored by the boundary trap-guard decorator after the graph-native
+    # assert fails.
+    torch = _torch();
+    ns = _exec_gm("val_guard_all.jac", True, True);
+    x = torch.tensor([1.0, 2.0, 3.0]);
+    good = torch.tensor([True, True, True]);
+    bad = torch.tensor([True, False, True]);
+
+    torch._dynamo.reset();
+    out = ns["f"](x, good);
+    assert torch.allclose(out, torch.sin(torch.relu(x)) * 2.0);
+
+    torch._dynamo.reset();
+    raised = None;
+    try {
+        ns["f"](x, bad);
+    } except BaseException as e {
+        raised = e;
+    }
+    assert type(raised) is ValueError , f"expected ValueError, got {repr(raised)}";
+    assert str(raised) == "mask must be all true" , f"message lost: {repr(raised)}";
+    assert "GM-TRAP" not in str(raised) , "internal trap marker leaked to the user";
+}
+
+test "declined guard keeps its original exception contract intact" {
+    # The counterpart to the two tests above: where the exception cannot be
+    # reconstructed at the boundary, GraphMend leaves the guard alone, so the
+    # ORIGINAL raise still runs -- full f-string message, interpolation and all.
+    # Lowering it anyway would have produced ValueError('').
+    torch = _torch();
+    ns = _exec_gm("guard_fstring_msg.jac", True, True);
+    x = torch.tensor([1.0, 2.0, 3.0]);
+    bad = torch.tensor([True, False, True]);
+
+    torch._dynamo.reset();
+    raised = None;
+    try {
+        ns["f"](x, bad);
+    } except BaseException as e {
+        raised = e;
+    }
+    assert type(raised) is ValueError , f"expected ValueError, got {repr(raised)}";
+    assert "mask must be all true" in str(raised) , f"message lost: {repr(raised)}";
+    assert "torch.Size([3])" in str(raised) , f"interpolated detail lost: {repr(
+        raised
+    )}";
+}
+
+test "shape mismatch trips the torch.equal precheck" {
+    # (a == b).all() would broadcast [1,2,3] against [[1,2,3]] to True; the
+    # static shape/dtype precheck in tensor_eq_assert must keep the lowered
+    # guard faithful to torch.equal, which reports them unequal, and raise.
+    torch = _torch();
+    ns = _exec_gm("val_guard.jac", True, True);
+    a = torch.tensor([1.0, 2.0, 3.0]);
+
+    torch._dynamo.reset();
+    out = ns["f"](a, a.clone());
+    assert torch.allclose(out, torch.sin(torch.relu(a)) * 2.0);
+
+    torch._dynamo.reset();
+    raised = None;
+    try {
+        ns["f"](a, a.reshape(1, 3));
+    } except BaseException as e {
+        raised = e;
+    }
+    assert type(raised) is ValueError , f"expected ValueError, got {repr(raised)}";
+    assert str(raised) == "unsupported attention mask" , f"message lost: {repr(
+        raised
+    )}";
+}
+
+"""Raise a RuntimeError carrying `text` verbatim (trap-guard parse probe)."""
+def _raise_runtime(text: str) {
+    raise RuntimeError(text);
+}
+
+"""A non-tensor mask: `.all()` matches the guard shape but returns a plain bool."""
+obj FakeMask {
+    has value: bool = False;
+
+    def all -> bool {
+        return self.value;
+    }
+}
+
+test "non-tensor guard condition keeps its original exception contract" {
+    # The `.all()` match is structural; with `mask: any` there is no static
+    # proof of tensor-ness, so the lowering DECLINES and the original guard
+    # runs unchanged: a duck-typed receiver keeps its exact Python semantics.
+    torch = _torch();
+    ns = _exec_gm("guard_unproven_receiver.jac", True, False);
+    x = torch.tensor([1.0, 2.0, 3.0]);
+    out = ns["f"](x, FakeMask(value=True));
+    assert torch.allclose(out, torch.sin(torch.relu(x)) * 2.0);
+    raised = None;
+    try {
+        ns["f"](x, FakeMask(value=False));
+    } except BaseException as e {
+        raised = e;
+    }
+    assert type(raised) is ValueError , f"expected ValueError, got {repr(raised)}";
+    assert str(raised) == "mask must be all true" , f"message lost: {repr(raised)}";
+}
+
+test "partial trap-marker text propagates unchanged" {
+    # An unrelated RuntimeError that happens to contain marker-like text must
+    # come out of the boundary guard exactly as it went in: not an IndexError
+    # from an unchecked split, and not a mis-restored exception.
+    wrapped = __jac_trap_guard__(_raise_runtime);
+    for text in ["dynamo says [[GM-TRAP oops", "[[GM-TRAP ValueError]]never closed"] {
+        raised = None;
+        try {
+            wrapped(text);
+        } except BaseException as e {
+            raised = e;
+        }
+        assert type(raised) is RuntimeError , f"wrong type: {repr(raised)}";
+        assert str(raised) == text , f"text mangled: {repr(raised)}";
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/test_graphmend_trap_lowering.jac b/jac/tests/compiler/passes/test_graphmend_trap_lowering.jac
new file mode 100644
index 0000000..c17b29b
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_trap_lowering.jac
@@ -0,0 +1,580 @@
+"""Guard lowering: rewrite shapes and one decline fixture per legality condition."""
+import ast;
+import os;
+import tempfile;
+import from tests.support {
+    GRAPHMEND_FIXTURES as FIXTURES,
+    graphmend_compile_opts as _compile_opts,
+    graphmend_compile_path as _compile_path,
+    graphmend_pysrc as _pysrc
+}
+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.driver.program { JacProgram }
+import from jaclang.compiler.driver.compile_options { CompileOptions }
