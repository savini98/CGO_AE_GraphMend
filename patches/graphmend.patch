@@ -0,0 +1,13 @@
+"""Generality: a non-register_buffer callee with TWO differing positional args
+and a preserved kwarg; dynamic signal via .argmax(). Both args are merged."""
+import torch;
+
+@torch.compile()
+def f(t: any, p1: any, q1: any, p2: any, q2: any) -> any {
+    if (t.argmax() > 0) {
+        combine(p1, q1, mode="x");
+    } else {
+        combine(p2, q2, mode="x");
+    }
+    return t;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_multi_stmt.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_multi_stmt.jac
new file mode 100644
index 0000000..82fb108
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/where_multi_stmt.jac
@@ -0,0 +1,53 @@
+"""Multi-statement data-dependent branches that share a trailing
+register_buffer call, with a nested *static* hasattr guard that must be
+preserved and hoisted, not rewritten.
+
+Mirrors the rotary-embedding cache-update idiom in production model code: the
+initializer is reached through an attribute (`self_obj.rope_init_fn`) that is
+bound elsewhere from a module-level dispatch table, so the hoist is licensed
+only because every function in that table is checkably pure and non-raising.
+The `len(rope_kwargs) > 0` validation raise is the upstream idiom
+verbatim -- it is unreachable here because the call passes no keyword outside
+the named parameters."""
+import torch;
+
+def _compute_default_rope(config: any, device: any, **rope_kwargs: any) -> any {
+    if len(rope_kwargs) > 0 {
+        raise ValueError("Unexpected arguments: `**rope_kwargs` should be unset");
+    }
+    return torch.arange(0, 8).float().to(device);
+}
+
+def _compute_longrope(config: any, device: any, **rope_kwargs: any) -> any {
+    if len(rope_kwargs) > 0 {
+        raise ValueError("Unexpected arguments: `**rope_kwargs` should be unset");
+    }
+    return torch.arange(0, 16).float().to(device);
+}
+
+glob ROPE_INIT_FUNCTIONS = {
+         "default": _compute_default_rope,
+         "longrope": _compute_longrope
+     };
+
+@torch.compile()
+def update(self_obj: any, position_ids: any, device: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if hasattr(self_obj.config, "original_max_position_embeddings") {
+        omp = self_obj.config.original_max_position_embeddings;
+    } else {
+        omp = self_obj.config.max_position_embeddings;
+    }
+    if (seq_len > omp) {
+        if not hasattr(self_obj, "long_inv_freq") {
+            self_obj.long_inv_freq = self_obj.rope_init_fn(self_obj.config, device);
+        }
+        self_obj.register_buffer("inv_freq", self_obj.long_inv_freq, persistent=False);
+    } else {
+        self_obj.original_inv_freq = self_obj.original_inv_freq.to(device);
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_nontensor_branch.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_nontensor_branch.jac
