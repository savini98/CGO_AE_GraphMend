+++ b/jac/tests/compiler/passes/fixtures/graphmend/guard_impure_init.jac
@@ -0,0 +1,37 @@
+"""Soundness: an existence-guarded init whose initializer is NOT pure.
+
+Same shape as where_multi_stmt.jac, but one entry in the dispatch table
+performs I/O. Hoisting runs the initializer on executions where
+the original never would, so speculating a side-effecting callee would make that
+effect happen on those runs. Since the attribute callee cannot be resolved to a
+single table entry, EVERY signature-compatible candidate must be clean -- one
+dirty entry must decline the whole rewrite."""
+import torch;
+
+def _compute_clean(config: any, device: any, **rope_kwargs: any) -> any {
+    return torch.arange(0, 8).float().to(device);
+}
+
+def _compute_dirty(config: any, device: any, **rope_kwargs: any) -> any {
+    print("initializing");
+    return torch.arange(0, 16).float().to(device);
+}
+
+glob ROPE_INIT_FUNCTIONS = {"clean": _compute_clean, "dirty": _compute_dirty};
+
+@torch.compile()
+def update(self_obj: any, position_ids: any, device: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if (seq_len > 8) {
+        if not hasattr(self_obj, "long_inv_freq") {
+            self_obj.long_inv_freq = self_obj.rope_init_fn(self_obj.config, device);
+        }
+        self_obj.register_buffer("inv_freq", self_obj.long_inv_freq, persistent=False);
+    } else {
+        self_obj.original_inv_freq = self_obj.original_inv_freq.to(device);
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/guard_in_compiled_class.jac b/jac/tests/compiler/passes/fixtures/graphmend/guard_in_compiled_class.jac
new file mode 100644
index 0000000..3de3a19
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/guard_in_compiled_class.jac
@@ -0,0 +1,18 @@
+"""Data-dependent guard inside a @torch.compile-decorated class.
+
+Detection tags the guard because the enclosing archetype is an entry point, but
+no enclosing ability carries the decorator, so there is no compiled call
+boundary at which a trap guard could restore the exception -- and an async
+assert can surface after the method has already returned. GraphMend declines."""
+import torch;
+
+@torch.compile()
+class Model(torch.nn.Module) {
+    def forward(self: any, x: any, mask: any) -> any {
+        x = torch.relu(x);
+        if not mask.all() {
+            raise ValueError("mask must be all true");
+        }
+        return torch.sin(x) * 2.0;
+    }
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/guard_in_reached_helper.jac b/jac/tests/compiler/passes/fixtures/graphmend/guard_in_reached_helper.jac
new file mode 100644
index 0000000..341b55b
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/guard_in_reached_helper.jac
@@ -0,0 +1,26 @@
+"""Guards in helpers the compiled entry reaches lower at the entry's boundary.
+
+`guarded_entry` carries the decorator, so `__jac_trap_guard__` can be attached
+above it to decode the marker, and both helpers are in its compiled region. One
+helper is declared before the entry and one after, because the boundary
+decorator lands on a function the traversal may already have left behind."""
+import torch;
+
+def early_helper(x: any, mask: torch.Tensor) -> any {
+    if not mask.all() {
+        raise ValueError("early mask must be all true");
+    }
+    return torch.sin(x);
+}
+
+@torch.compile()
+def guarded_entry(x: any, mask: torch.Tensor) -> any {
+    return late_helper(early_helper(torch.relu(x), mask), mask);
+}
+
+def late_helper(x: any, mask: torch.Tensor) -> any {
+    if not mask.all() {
+        raise ValueError("late mask must be all true");
+    }
+    return torch.cos(x);
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/guard_in_try.jac b/jac/tests/compiler/passes/fixtures/graphmend/guard_in_try.jac
new file mode 100644
index 0000000..d2bc818
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/guard_in_try.jac
@@ -0,0 +1,17 @@
+"""Validation guard inside a lexical try: lowering would move the failure to
+an async assert at the boundary, so the enclosing except would silently stop
+firing; the guard must decline."""
+import torch;
+
+@torch.compile()
+def f(x: any, mask: torch.Tensor) -> any {
+    x = torch.relu(x);
+    try {
+        if not mask.all() {
+            raise ValueError("mask must be all true");
+        }
+    } except ValueError {
+        return x;
+    }
+    return torch.sin(x) * 2.0;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/guard_key_mismatch.jac b/jac/tests/compiler/passes/fixtures/graphmend/guard_key_mismatch.jac
new file mode 100644
index 0000000..d80ff41
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/guard_key_mismatch.jac
@@ -0,0 +1,24 @@
+"""Soundness: a non-idempotent observable write (`self.counter += 1`) smuggled
+into a branch under a `hasattr` header whose key is NOT the attribute the body
+assigns. The guard never closes, so the body re-runs on every call -- and
+hoisting it would run the increment on the untaken path too. Recognizing the
+`hasattr` *shape* alone would license this; GraphMend must DECLINE."""
+import torch;
+
+@torch.compile()
+def f(self_obj: any, position_ids: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if (seq_len > 8) {
+        if not hasattr(self_obj, "never_set") {
+            self_obj.counter = self_obj.counter + 1;
+            self_obj.long_inv_freq = self_obj.rope_init_fn(self_obj.config);
+        }
+        self_obj.register_buffer("inv_freq", self_obj.long_inv_freq, persistent=False);
+    } else {
+        self_obj.original_inv_freq = self_obj.original_inv_freq.to("cpu");
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/guard_late_tensor_def.jac b/jac/tests/compiler/passes/fixtures/graphmend/guard_late_tensor_def.jac
new file mode 100644
index 0000000..5406d1f
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/guard_late_tensor_def.jac
@@ -0,0 +1,21 @@
+"""A receiver that is a non-tensor at the guard site and a tensor only later:
+`m` holds a plain list when the guard reads it, and is rebound to a tensor
+after the raise. `defining_assignment` resolves the textually LAST definition,
+so a flow-insensitive proof would read the future and lower the guard against
+a list. Multiple definitions make the binding flow-sensitive: refuse to prove."""
+import torch;
+
+def load_flags -> any {
+    return [1, 1];
+}
+
+@torch.compile()
+def f(x: any, mask: torch.Tensor) -> any {
+    x = torch.relu(x);
+    m = load_flags();
+    if not m.all() {
+        raise ValueError("flags must be all true");
+    }
+    m = mask;
+    return torch.sin(x) * m;
+}
