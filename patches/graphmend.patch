@@ -0,0 +1,16 @@
+"""Data-dependent control flow where both branches make the same call with a
+differing argument, the shared-trailing-call reconciliation shape."""
+import torch;
+
+@torch.compile()
+def f(self_obj: any, position_ids: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if (seq_len > 8) {
+        self_obj.register_buffer("inv_freq", self_obj.long_inv_freq, persistent=False);
+    } else {
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_conditional_normalizer.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_conditional_normalizer.jac
new file mode 100644
index 0000000..cc69f76
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/where_conditional_normalizer.jac
@@ -0,0 +1,26 @@
+"""Soundness: the consumer's first TEXTUAL mention of the moved attribute is
+a normalizing move, but it sits in a branch the reads do not share, so it
+does not dominate them: an execution can skip the normalization and read the
+placement the hoisted move installed. Must DECLINE."""
+import torch;
+
+@torch.compile()
+def f(self_obj: any, position_ids: any, device: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if (seq_len > 8) {
+        self_obj.register_buffer("inv_freq", self_obj.long_inv_freq, persistent=False);
+    } else {
+        self_obj.original_inv_freq = self_obj.original_inv_freq.to(device);
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
+
+def peek(self_obj: any, flag: bool, device: any) -> any {
+    if flag {
+        self_obj.original_inv_freq = self_obj.original_inv_freq.to(device);
+    }
+    return self_obj.original_inv_freq;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_config_import.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_config_import.jac
new file mode 100644
index 0000000..2f3f73b
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/where_config_import.jac
@@ -0,0 +1,33 @@
+"""Cross-module constructor invariant: the config class lives in a sibling
+module, so proving `config.rope_scaling.get(...)` requires following the
+import and materializing that module's AST into the hub on demand. Same
+proof as guard_config_get, one module away."""
+import torch;
+import from rope_config_mod { RopeConfig }
+
+def _compute_long(config: RopeConfig, device: any, **rope_kwargs: any) -> any {
+    if len(rope_kwargs) > 0 {
+        raise ValueError("Unexpected arguments: `**rope_kwargs` should be unset");
+    }
+    factor = config.rope_scaling.get("factor");  # jac:ignore[E1099]
+    return torch.arange(0, 8).float().to(device) * factor;
+}
+
+glob ROPE_INIT_FUNCTIONS = {"long": _compute_long};
+
+@torch.compile()
+def update(self_obj: any, config: RopeConfig, position_ids: any, device: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if (seq_len > 8) {
+        if not hasattr(self_obj, "long_inv_freq") {
+            self_obj.long_inv_freq = self_obj.rope_init_fn(config, device);
+        }
+        self_obj.register_buffer("inv_freq", self_obj.long_inv_freq, persistent=False);
+    } else {
+        self_obj.original_inv_freq = self_obj.original_inv_freq.to(device);
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_device_move_shared.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_device_move_shared.jac
new file mode 100644
index 0000000..8469f2f
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/where_device_move_shared.jac
@@ -0,0 +1,30 @@
+"""Consumer analysis, positive case: the moved attribute has a consumer in
+another function, but that consumer's FIRST mention of the attribute is the
+same normalizing device move, so it re-establishes device placement before
+every read and cannot observe the hoisted move. This is the common shape of
+shared rotary-embedding caches in model code. The hoist is licensed."""
+import torch;
+
+@torch.compile()
+def f(self_obj: any, position_ids: any, device: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if (seq_len > 8) {
+        self_obj.register_buffer("inv_freq", self_obj.long_inv_freq, persistent=False);
+    } else {
+        self_obj.original_inv_freq = self_obj.original_inv_freq.to(device);
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
+
+def dynamic_update(self_obj: any, seq_len: int, device: any) -> any {
+    if (seq_len < 8) {
+        self_obj.original_inv_freq = self_obj.original_inv_freq.to(device);
+        self_obj.register_buffer(
+            "inv_freq", self_obj.original_inv_freq, persistent=False
+        );
+    }
+    return self_obj.inv_freq;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_global_setup.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_global_setup.jac
new file mode 100644
index 0000000..e862851
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/where_global_setup.jac
@@ -0,0 +1,21 @@
+"""Soundness: a branch setup writing a name that also exists at module scope.
+Function-scope confinement cannot see module-level readers, so the collision
+declines."""
+import torch;
+
+glob scale = 1.0;
+
+def read_scale -> float {
+    return scale;
+}
+
+@torch.compile()
+def f(x: any, m: any) -> any {
+    if (x.sum() > 0) {
+        scale = 2.0;
+        m.register_buffer("s", x * scale, persistent=False);
+    } else {
+        m.register_buffer("s", x * 0.5, persistent=False);
+    }
+    return x;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_local_clobber.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_local_clobber.jac
new file mode 100644
index 0000000..caa1b85
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/where_local_clobber.jac
@@ -0,0 +1,19 @@
+"""Soundness: both branches' setups write the same bare local before the
+shared trailing call. Each write is call-free and confined to the region, so
+neither is observable on its own -- but hoisting runs both unconditionally,
+the second overwrites the first, and the merged call then reads the untaken
+branch's value. GraphMend must DECLINE."""
+import torch;
+
+@torch.compile()
+def f(position_ids: any, x: any, y: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    if (seq_len > 8) {
+        scale = x * 2;
+        combine(scale, x, mode="a");
+    } else {
+        scale = y * 3;
+        combine(scale, y, mode="a");
+    }
+    return x;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_local_escape.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_local_escape.jac
new file mode 100644
index 0000000..754515a
--- /dev/null
+++ b/jac/tests/compiler/passes/fixtures/graphmend/where_local_escape.jac
@@ -0,0 +1,18 @@
+"""Soundness: a branch setup writes a bare local that is live outside the
+region. The write is call-free, but hoisting it publishes the taken branch's
+value to code that runs on the untaken path too, so the write is not
+observationally neutral. GraphMend must DECLINE."""
+import torch;
+
+@torch.compile()
+def f(position_ids: any, x: any, y: any) -> any {
+    seq_len = torch.max(position_ids) + 1;
+    scale = x * 0;
+    if (seq_len > 8) {
+        scale = x * 2;
+        combine(scale, x, mode="a");
+    } else {
+        combine(scale, y, mode="a");
+    }
+    return scale;
+}
diff --git a/mod_jac/tests/compiler/passes/fixtures/graphmend/where_multi_arg.jac b/jac/tests/compiler/passes/fixtures/graphmend/where_multi_arg.jac
