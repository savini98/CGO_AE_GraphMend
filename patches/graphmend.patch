+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.frontend.constant { GraphBreakKind, GraphMendHelper }
+import type from jaclang.compiler.frontend.unitree { Ability, UniNode }
+
+obj GraphMendFacts {
+    has breaks: dict[(UniNode, GraphBreakKind)] = {},
+        boundary: dict[(Ability, Ability)] = {},
+        helpers: set[GraphMendHelper] = set(),
+        noop: bool = False,
+        wrapped_keys: set[str] = set(),
+        covered_by: dict[(str, str)] = {};
+}
+
+def facts_for(nd: uni.UniNode) -> GraphMendFacts {
+    mod: (uni.Module | None) = None;
+    if isinstance(nd, uni.Module) {
+        mod = nd;
+    } else {
+        mod = nd.find_parent_of_type(uni.Module);
+    }
+    if mod is None {
+        return GraphMendFacts();
+    }
+    facts = mod.gen.graphmend_facts;
+    if facts is None {
+        facts = GraphMendFacts();
+        mod.gen.graphmend_facts = facts;
+    }
+    return facts;
+}
+
+def gen_name(at: uni.UniNode, value: str, store: bool) -> uni.Name {
+    anchor: any = at;
+    nm = uni.Name.gen_stub_from_node(anchor, value);
+    if store {
+        nm.expr_ctx = uni.ExprCtx.STORE;
+    }
+    return nm;
+}
+
+def gen_string(at: uni.UniNode, value: str) -> uni.String {
+    return uni.String(
+        orig_src=at.loc.orig_src,
+        name='STRING',
+        value=value,
+        line=at.loc.first_line,
+        end_line=at.loc.last_line,
+        col_start=at.loc.col_start,
+        col_end=at.loc.col_end,
+        pos_start=at.loc.pos_start,
+        pos_end=at.loc.pos_end
+    );
+}
+
+def gen_bool(at: uni.UniNode, value: bool) -> uni.Bool {
+    return uni.Bool(
+        orig_src=at.loc.orig_src,
+        name='BOOL',
+        value='True' if value else 'False',
+        line=at.loc.first_line,
+        end_line=at.loc.last_line,
+        col_start=at.loc.col_start,
+        col_end=at.loc.col_end,
+        pos_start=at.loc.pos_start,
+        pos_end=at.loc.pos_end
+    );
+}
+
+def gen_null(at: uni.UniNode) -> uni.Null {
+    return uni.Null(
+        orig_src=at.loc.orig_src,
+        name='NULL',
+        value='None',
+        line=at.loc.first_line,
+        end_line=at.loc.last_line,
+        col_start=at.loc.col_start,
+        col_end=at.loc.col_end,
+        pos_start=at.loc.pos_start,
+        pos_end=at.loc.pos_end
+    );
+}
+
+def gen_token(at: uni.UniNode, name: str, value: str) -> uni.Token {
+    return uni.Token(
+        orig_src=at.loc.orig_src,
+        name=name,
+        value=value,
+        line=at.loc.first_line,
+        end_line=at.loc.last_line,
+        col_start=at.loc.col_start,
+        col_end=at.loc.col_end,
+        pos_start=at.loc.pos_start,
+        pos_end=at.loc.pos_end
+    );
+}
+
+def need_helper(at: uni.UniNode, helper: GraphMendHelper) {
+    facts_for(at).helpers.add(helper);
+}
+
+def torch_call(at: uni.UniNode, fname: str, args: list) -> uni.FuncCall {
+    torch_nm = gen_name(at, 'torch', False);
+    fn_nm = gen_name(at, fname, False);
+    target = uni.AtomTrailer(
+        target=torch_nm,
+        right=fn_nm,
+        is_attr=True,
+        is_null_ok=False,
+        kid=[torch_nm, fn_nm]
+    );
+    return uni.FuncCall(
+        target=target, params=args, genai_call=None, kid=[target] + args
+    );
+}
+
+def split_params(params: any) -> tuple[list[uni.Expr], list[uni.KWPair]] {
+    pos: list[uni.Expr] = [];
+    kws: list[uni.KWPair] = [];
+    for p in (params or []) {
+        if isinstance(p, uni.KWPair) {
+            kws.append(p);
+        } else {
+            pos.append(p);
+        }
+    }
+    return (pos, kws);
+}
+
+def split_params_keyed(params: any) -> tuple[list[uni.Expr], dict[str, uni.KWPair]] {
+    (pos, kws) = split_params(params);
+    keyed: dict[str, uni.KWPair] = {};
+    for kw in kws {
+        if kw.key is not None {
+            keyed[kw.key.sym_name] = kw;
+        }
+    }
+    return (pos, keyed);
+}
+
+def stmt_slot(at: uni.UniNode) -> (tuple | None) {
+    cur: (uni.UniNode | None) = at;
+    while cur is not None {
+        parent = cur.parent;
+        if parent is None {
+            return None;
+        }
+        holder: any = parent;
+        body = holder?.body;
+        if isinstance(body, list) {
+            return (parent, cur, body)
+                if ((cur in body) and (cur in parent.kid))
+                else None;
+        }
+        cur = parent;
+    }
+    return None;
+}
+
+def insert_after(stmt: uni.UniNode, new_stmt: uni.UniNode) -> bool {
+    slot = stmt_slot(stmt);
+    if slot is None {
+        return False;
+    }
+    (parent, anchor, body) = slot;
+    holder: any = parent;
+    i = body.index(anchor);
+    j = parent.kid.index(anchor);
+    setattr(holder, 'body', list(body[:(i + 1)]) + [new_stmt] + list(body[(i + 1):]));
+    parent.set_kids(
+        list(parent.kid[:(j + 1)]) + [new_stmt] + list(parent.kid[(j + 1):])
+    );
+    new_stmt.parent = parent;
+    return True;
+}
+
+def insert_before(stmt: uni.UniNode, new_stmt: uni.UniNode) -> bool {
+    slot = stmt_slot(stmt);
+    if slot is None {
+        return False;
+    }
+    (parent, anchor, body) = slot;
+    holder: any = parent;
+    i = body.index(anchor);
+    j = parent.kid.index(anchor);
+    setattr(holder, 'body', list(body[:i]) + [new_stmt] + list(body[i:]));
+    parent.set_kids(list(parent.kid[:j]) + [new_stmt] + list(parent.kid[j:]));
+    new_stmt.parent = parent;
+    return True;
+}
+
+def append_stmt(owner: uni.UniNode, new_stmt: uni.UniNode) -> bool {
+    holder: any = owner;
+    body = holder?.body;
+    if not isinstance(body, list) {
+        return False;
+    }
+    last = body[-1] if body else None;
+    setattr(holder, 'body', list(body) + [new_stmt]);
+    if (last is not None) and (last in owner.kid) {
+        j = owner.kid.index(last);
+        owner.set_kids(
+            list(owner.kid[:(j + 1)]) + [new_stmt] + list(owner.kid[(j + 1):])
+        );
+    } else {
+        owner.set_kids(list(owner.kid) + [new_stmt]);
+    }
+    new_stmt.parent = owner;
+    return True;
+}
+
+def replace_stmt(old: uni.UniNode, new_nodes: list) -> bool {
+    parent = old.parent;
+    if parent is None {
+        return False;
+    }
+    holder: any = parent;
+    body = holder?.body;
+    if (not isinstance(body, list)) or (old not in body) or (old not in parent.kid) {
+        return False;
+    }
+    i = body.index(old);
+    j = parent.kid.index(old);
+    setattr(holder, 'body', list(body[:i]) + new_nodes + list(body[(i + 1):]));
+    parent.set_kids(list(parent.kid[:j]) + new_nodes + list(parent.kid[(j + 1):]));
+    for child in new_nodes {
+        child.parent = parent;
+    }
+    return True;
+}
diff --git a/mod_jac/jaclang/compiler/passes/graphmend/auto_detect.jac b/jac/jaclang/compiler/passes/graphmend/auto_detect.jac
new file mode 100644
index 0000000..bb196cf
--- /dev/null
+++ b/jac/jaclang/compiler/passes/graphmend/auto_detect.jac
@@ -0,0 +1,55 @@
+import ast as ast3;
+
+def module_imports_torch(src: str, file_path: str) -> bool {
+    if 'torch' not in src {
+        return False;
+    }
+    if file_path.endswith('.py') {
+        return _py_imports_torch(src, file_path);
+    }
+    return _jac_binds_torch(src, file_path);
+}
+
+def file_imports_torch(file_path: str) -> bool {
+    import from jaclang.compiler.driver.jir { read_source_shared }
+    try {
+        src = read_source_shared(file_path);
+        if src is None {
+            return False;
+        }
+        return module_imports_torch(src, file_path);
+    } except Exception {
+        return False;
+    }
+}
+
+def _py_imports_torch(src: str, file_path: str) -> bool {
+    import jaclang.compiler.frontend.unitree as uni;
+    import from jaclang.compiler.driver.pass_driver { run_pass }
+    import from jaclang.compiler.driver.program { JacProgram }
+    import from jaclang.compiler.passes.pyast_load_pass { PyastBuildPass }
+    import from jaclang.compiler.passes.graphmend.scope_facts { module_binds_torch }
+    try {
+        parsed = ast3.parse(src);
+        ret = run_pass(
+            PyastBuildPass,
+            uni.PythonModuleAst(parsed, orig_src=uni.Source(src, mod_path=file_path)),
+            JacProgram()
+        );
+    } except Exception {
+        return False;
+    }
+    return module_binds_torch(ret.ir_out);
+}
+
+def _jac_binds_torch(src: str, file_path: str) -> bool {
+    import from jaclang.compiler.frontend.parser { parse as rd_parse }
+    import from jaclang.compiler.driver.program { JacProgram }
+    import from jaclang.compiler.passes.graphmend.scope_facts { module_binds_torch }
+    try {
+        (mod, _had_error) = rd_parse(src, file_path, prog=JacProgram());
+    } except Exception {
+        return False;
+    }
+    return module_binds_torch(mod);
+}
diff --git a/mod_jac/jaclang/compiler/passes/graphmend/defer_side_effect_pass.jac b/jac/jaclang/compiler/passes/graphmend/defer_side_effect_pass.jac
new file mode 100644
index 0000000..3efccd2
--- /dev/null
+++ b/jac/jaclang/compiler/passes/graphmend/defer_side_effect_pass.jac
@@ -0,0 +1,61 @@
+import jaclang.compiler.frontend.unitree as uni;
+import from jaclang.compiler.passes { UniPass }
+import type from jaclang.compiler.driver.program { JacProgram }
+
+obj DeferSideEffectPass(UniPass) {
+    has prog: JacProgram,
+        _enabled: bool = False,
+        _counter: int = 0,
+        _se_arg_counter: int = 0,
+        _needs_se: set[int] = set(),
+        _guarded: set[int] = set(),
+        _defer_mods: set[int] = set(),
+        _pending_regs: list[tuple[(uni.Archetype | None), uni.Assignment]] = [];
+
+    static has REQUIRES: tuple = ('graph-breaks', 'predicated-branches'),
+        HOST_PASS: bool = True,
+        _LOG_METHODS: set[str] = {
+            'debug',
+            'info',
+            'warning',
+            'warning_once',
+            'error',
+            'exception',
+            'critical',
+            'fatal',
+            'log',
+            'warn'
+        };
+
+    def before_pass -> None;
+    def exit_func_call(nd: uni.FuncCall) -> None;
+    def exit_assignment(nd: uni.Assignment) -> None;
+    def exit_return_stmt(nd: uni.ReturnStmt) -> None;
+    def exit_ability(nd: uni.Ability) -> None;
+    def exit_module(nd: uni.Module) -> None;
+    def _is_logger_call(nd: uni.FuncCall) -> bool;
+    def _base_binds_at_module(base: uni.Name) -> bool;
+    def _logger_emit(nd: uni.FuncCall) -> (uni.FuncCall | None);
+    def _register_assignment(
+        at: uni.UniNode, slot_name: str, callee: uni.Expr
+    ) -> uni.Assignment;
+
+    def _toplevel_archetype(nd: uni.UniNode) -> (uni.Archetype | None);
+    def _pre_hook_register_stmt(at: uni.UniNode, name: str) -> uni.ExprStmt;
+    def _hook_register_stmt(at: uni.UniNode, name: str) -> uni.ExprStmt;
+    def _hook_guard_stmt(at: uni.UniNode, name: str, body: list) -> uni.IfStmt;
+    def _attach_se_guard(nd: uni.Ability) -> None;
+    def _is_compiled_entry(nd: uni.Ability) -> bool;
+    def _str(at: uni.UniNode, text: str) -> uni.String;
+    def _has_unpack(call: uni.FuncCall) -> bool;
+    def _tuple(at: uni.UniNode, values: list[uni.Expr]) -> uni.TupleVal;
+    def _dict_from_kws(at: uni.UniNode, kws: list[uni.KWPair]) -> uni.DictVal;
+    def _buffer_entry(call: uni.FuncCall) -> tuple[uni.TupleVal, list[uni.UniNode]];
+    def _snapshot(
+        call: uni.FuncCall, v: uni.Expr, hoists: list[uni.UniNode]
+    ) -> uni.Expr;
+
+    def _clone_guard(at: uni.UniNode, tmp: str) -> uni.IfElseExpr;
+    def _buffer_append(at: uni.UniNode, ent: uni.TupleVal) -> uni.FuncCall;
+    def _flush_stmt(at: uni.UniNode) -> uni.ExprStmt;
+}
