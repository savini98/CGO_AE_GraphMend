diff --git a/mod_jac/tests/compiler/passes/test_graphmend_where_integration.jac b/jac/tests/compiler/passes/test_graphmend_where_integration.jac
new file mode 100644
index 0000000..8bcb7de
--- /dev/null
+++ b/jac/tests/compiler/passes/test_graphmend_where_integration.jac
@@ -0,0 +1,104 @@
+"""Torch-gated: predication collapses the split forward pass back to one FX graph."""
+import ast;
+import os;
+import from tests.support { GRAPHMEND_FIXTURES as FIXTURES }
+import from jaclang.compiler.driver.program { JacProgram }
+import from jaclang.compiler.driver.compile_options { CompileOptions }
+
+"""Import torch or skip the calling test."""
+def _torch -> any {
+    try {
+        import torch;
+        return torch;
+    } except ImportError {
+        testskip("torch not installed");
+    }
+}
+
+"""Compile a fixture (with/without graphmend) and exec its generated Python.
+
+``@torch.compile`` is rebound to identity while exec'ing; the caller drives
+the raw function through a counting backend itself."""
+def _exec_gm(fixture: str, graphmend: bool) -> dict {
+    torch = _torch();
+    prog = JacProgram();
+    mod = prog.compile(
+        file_path=os.path.join(FIXTURES, fixture),
+        options=CompileOptions(graphmend=graphmend)
+    );
+    pa = mod.gen.py_ast;
+    mod_ast: any = pa[0] if isinstance(pa, list) else pa;
+    src = ast.unparse(mod_ast);
+    ns: dict = {};
+    orig_compile = torch.compile;
+    def _shim(*a: any, **k: any) -> any {
+        if a {
+            return a[0];
+        }
+        def _wrap(f: any) -> any {
+            return f;
+        }
+        return _wrap;
+    }
+    torch.compile = _shim;
+    try {
+        exec(compile(src, fixture, "exec"), ns);
+    } finally {
+        torch.compile = orig_compile;
+    }
+    return ns;
+}
+
+"""Count the contiguous graphs the backend receives for one call of `fn_name`."""
+def _count_graphs(fixture: str, graphmend: bool, fn_name: str, args: tuple) -> int {
+    torch = _torch();
+    ns = _exec_gm(fixture, graphmend);
+    graphs: list = [];
+    def _backend(gm: any, inputs: any) -> any {
+        graphs.append(gm);
+        return gm.forward;
+    }
+    torch._dynamo.reset();
+    torch.compile(ns[fn_name], backend=_backend)(*args);
+    return len(graphs);
+}
+
+test "data-dependent branches defragment to one contiguous graph" {
+    torch = _torch();
+    a = torch.tensor([1.0, 2.0, 3.0]);
+    b = torch.tensor([4.0, 5.0, 6.0]);
+    for (fixture, fn_name, args) in [
+        ("where_return.jac", "with_breaks", (a, b)),
+        ("where_assign.jac", "f", (a, b))
+    ] {
+        orig = _count_graphs(fixture, False, fn_name, args);
+        fixed = _count_graphs(fixture, True, fn_name, args);
+        assert orig >= 2 , f"{fixture}: expected >=2 graphs without GraphMend, got {orig}";
+        assert fixed == 1 , f"{fixture}: expected 1 graph with GraphMend, got {fixed}";
+    }
+}
+
+test "nested guard in a branch defragments via trap + predication" {
+    # A data-dependent branch containing a validation guard collapses to one
+    # graph only if trap lowering (assert) composes with predication.
+    torch = _torch();
+    x = torch.tensor([1.0, 2.0, 3.0]);
+    y = torch.tensor([1.0, 2.0, 3.0]);
+    orig = _count_graphs("nested_guard_in_branch.jac", False, "f", (x, y));
+    fixed = _count_graphs("nested_guard_in_branch.jac", True, "f", (x, y));
+    assert orig >= 2 , f"expected >=2 graphs without GraphMend, got {orig}";
+    assert fixed == 1 , f"expected 1 graph with GraphMend, got {fixed}";
+}
+
+test "re-gated assert stays dormant when its branch is not taken" {
+    # The hoisted assert is re-gated on the branch predicate: it must NOT fire
+    # when the branch that held it is not taken, even if its check would fail.
+    # Here x.sum() <= 0 selects the else branch, so the guard (x == y).all(),
+    # which is False, must be vacuously satisfied rather than raising.
+    torch = _torch();
+    ns = _exec_gm("nested_guard_in_branch.jac", True);
+    x = torch.tensor([-1.0, -2.0, -3.0]);
+    y = torch.tensor([9.0, 9.0, 9.0]);
+    out = ns["f"](x, y);
+    assert torch.allclose(out, x * 3.0) , "untaken-branch guard changed result";
+}
diff --git a/jac/tests/compiler/passes/test_pyast_build_pass.jac b/jac/tests/compiler/passes/test_pyast_build_pass.jac
index 48552a0..453e38b 100644
--- a/jac/tests/compiler/passes/test_pyast_build_pass.jac
+++ b/jac/tests/compiler/passes/test_pyast_build_pass.jac
@@ -16,6 +16,7 @@ import from jaclang.compiler.frontend.helpers { pascal_to_snake }
 import from jaclang.compiler.frontend.parser.lexer { tokenize_full }
 import from jaclang.compiler.driver.program { JacProgram }
 import from jaclang.compiler.frontend.unitree { PythonModuleAst, Source }
+import from jaclang.compiler.frontend { unitree as uni }
 
 glob FIXTURES = os.path.join(JAC_ROOT, "tests", "compiler", "passes", "fixtures");
 
@@ -216,3 +217,46 @@ test "py2jac binop operator precedence" {
     assert "(w - title_len - 2) // 2" in code , f"Expected correct floor-div grouping in: {code}";
     assert "(w - title_len - 1) // 2" in code , f"Expected correct floor-div grouping in: {code}";
 }
+
+"""An else clause must be linked into its parent's kid tree, not just its
+typed field: traversal walks kid, so a node missing there is never visited and
+its body is dropped from generated code. for/else was always correct; try/else
+and while/else were not."""
+test "py else clauses are linked into the kid tree" {
+    try_src = "try:\n    pass\nexcept ValueError:\n    pass\nelse:\n    survived = 1\n";
+    while_src = "n = 0\nwhile n < 1:\n    n = 1\nelse:\n    survived = 1\n";
+    for_src = "for i in range(1):\n    pass\nelse:\n    survived = 1\n";
+
+    try_mod = PyastBuildPass(
+        ir_in=PythonModuleAst(
+            py_ast.parse(try_src), orig_src=Source(try_src, "py_else_kid_try.py")
+        )
+    ).ir_out;
+    tries = try_mod.get_all_sub_nodes(uni.TryStmt);
+    assert len(tries) == 1;
+    try_else = tries[0].else_body;
+    assert try_else is not None;
+    assert try_else in tries[0].kid;
+
+    while_mod = PyastBuildPass(
+        ir_in=PythonModuleAst(
+            py_ast.parse(while_src), orig_src=Source(while_src, "py_else_kid_while.py")
+        )
+    ).ir_out;
+    whiles = while_mod.get_all_sub_nodes(uni.WhileStmt);
+    assert len(whiles) == 1;
+    while_else = whiles[0].else_body;
+    assert while_else is not None;
+    assert while_else in whiles[0].kid;
+
+    for_mod = PyastBuildPass(
+        ir_in=PythonModuleAst(
+            py_ast.parse(for_src), orig_src=Source(for_src, "py_else_kid_for.py")
+        )
+    ).ir_out;
+    fors = for_mod.get_all_sub_nodes(uni.InForStmt);
+    assert len(fors) == 1;
+    for_else = fors[0].else_body;
+    assert for_else is not None;
+    assert for_else in fors[0].kid;
+}
diff --git a/mod_jac/tests/compiler/test_endpoint_effect_resolution.jac b/jac/tests/compiler/test_endpoint_effect_resolution.jac
new file mode 100644
index 0000000..dd1956c
--- /dev/null
+++ b/jac/tests/compiler/test_endpoint_effect_resolution.jac
@@ -0,0 +1,161 @@
+import os;
+import tempfile;
+import from jaclang.compiler.driver.program { JacProgram }
+
+def write_mods(mods: dict[str, str]) -> str {
+    tmp = tempfile.mkdtemp(prefix="jac_endpoint_effect_res_");
+    for (fname, src) in mods.items() {
+        with open(os.path.join(tmp, fname), "w") as f {
+            f.write(src);
+        }
+    }
+    return tmp;
+}
+
+def compile_effects(mods: dict[str, str]) -> dict {
+    tmp = write_mods(mods);
+    prog = JacProgram();
+    mod = prog.compile(os.path.join(tmp, "main.jac"));
+    msgs = [e.pretty_print() for e in prog.errors_had];
+    assert not msgs , f"fixture must compile cleanly, got: {msgs}";
+    return mod.gen.interop_manifest.endpoint_effects;
+}
+
+test "endpoint calling a top-level writer helper gets the exact writer verdict" {
+    effects = compile_effects(
+        {
+            "main.jac": (
+                "node Note {\n"
+                "    has text: str = \"\";\n"
+                "}\n"
+                "def add_note(text: str) -> None {\n"
+                "    root ++> Note(text=text);\n"
+                "}\n"
+                "def:pub save_note(text: str) -> dict {\n"
+                "    add_note(text);\n"
+                "    return {};\n"
+                "}\n"
+            )
+        }
+    );
+    assert effects.get("func:save_note") == {"is_writer": True, "touches": ["Note"]} , (
+        f"top-level helper write must resolve through the deep lookup; got"
+        f" {effects.get('func:save_note')}"
+    );
+}
+
+test "endpoint reaching a writer through a nested function stays a writer" {
+    effects = compile_effects(
+        {
+            "main.jac": (
+                "node Note {\n"
+                "    has text: str = \"\";\n"
+                "}\n"
+                "def outer_helper(text: str) -> None {\n"
+                "    def nested_writer(msg: str) -> None {\n"
+                "        root ++> Note(text=msg);\n"
+                "    }\n"
+                "    nested_writer(text);\n"
+                "}\n"
+                "def:pub save_nested(text: str) -> dict {\n"
+                "    outer_helper(text);\n"
+                "    return {};\n"
+                "}\n"
+            )
+        }
+    );
+    assert effects.get("func:save_nested")
+        == {"is_writer": True, "touches": ["Note"]} , (
+        f"nested callees resolve only via a deep enclosing-scope lookup, so a"
+        f" shallow resolver misses this write; got"
+        f" {effects.get('func:save_nested')}"
+    );
+}
+
+test "endpoint calling a writer method keeps the unresolved method verdict" {
+    effects = compile_effects(
+        {
+            "main.jac": (
+                "node Note {\n"
+                "    has text: str = \"\";\n"
+                "}\n"
+                "obj Store {\n"
+                "    def write_note(text: str) -> None {\n"
+                "        root ++> Note(text=text);\n"
+                "    }\n"
+                "}\n"
+                "def:pub save_via_method(text: str) -> dict {\n"
+                "    st = Store();\n"
+                "    st.write_note(text);\n"
+                "    return {};\n"
+                "}\n"
+            )
+        }
+    );
+    assert effects.get("func:save_via_method")
+        == {"is_writer": True, "touches": ["Note"]} , (
+        f"the AtomTrailer branch follows the method body, so the write is seen"
+        f" and Note is named; got {effects.get('func:save_via_method')}"
+    );
+}
+
+test "endpoint calling a cross-module writer helper keeps the import-binding verdict" {
+    effects = compile_effects(
+        {
+            "helper_mod.jac": (
+                "node Note {\n"
+                "    has text: str = \"\";\n"
+                "}\n"
+                "def remote_add(text: str) -> None {\n"
+                "    root ++> Note(text=text);\n"
+                "}\n"
+            ),
+            "main.jac": (
+                "import from helper_mod { remote_add }\n"
+                "def:pub save_remote(text: str) -> dict {\n"
+                "    remote_add(text);\n"
+                "    return {};\n"
+                "}\n"
+            )
+        }
+    );
+    assert effects.get("func:save_remote")
+        == {"is_writer": True, "touches": ["Note"]} , (
+        f"a cross-module callee is followed through its import binding, so the"
+        f" write is seen and Note is named; got {effects.get('func:save_remote')}"
+    );
+}
+
+test "endpoint constructing a node archetype touches exactly that archetype" {
+    effects = compile_effects(
+        {
+            "main.jac": (
+                "node Todo {\n"
+                "    has title: str = \"\";\n"
+                "}\n"
+                "def:pub make_todo(title: str) -> dict {\n"
+                "    root ++> Todo(title=title);\n"
+                "    return {};\n"
+                "}\n"
+            )
+        }
+    );
+    assert effects.get("func:make_todo") == {"is_writer": True, "touches": ["Todo"]} , (
+        f"a NODE_ARCH constructor call must record the archetype by name; got"
+        f" {effects.get('func:make_todo')}"
+    );
+}
+
+test "pure endpoint gets the exact reader verdict with wildcard touches" {
+    effects = compile_effects(
+        {
+            "main.jac": (
+                "def:pub get_stats -> dict {\n" "    return {\"count\": 10};\n" "}\n"
+            )
+        }
+    );
+    assert effects.get("func:get_stats") == {"is_writer": False, "touches": ["*"]} , (
+        f"a pure endpoint must classify as reader with the wildcard touches"
+        f" list; got {effects.get('func:get_stats')}"
+    );
+}
diff --git a/mod_jac/tests/compiler/test_src_shared_cache.jac b/jac/tests/compiler/test_src_shared_cache.jac
new file mode 100644
index 0000000..82e7d20
--- /dev/null
+++ b/jac/tests/compiler/test_src_shared_cache.jac
@@ -0,0 +1,77 @@
+"""_SRC_SHARED eviction: the shared source cache is a small LRU.
+
+The cache previously clear()ed wholesale when full, so the fifth distinct
+file dropped every entry including the hottest one. Eviction must instead
+drop the least recently used entry and keep hot entries resident.
+"""
+
+import os;
+import tempfile;
+import jaclang.compiler.driver.jir as jir;
+import from jaclang.compiler.driver.jir { read_source_shared }
+
+
+"""Write count files under base and return their paths."""
+def _write_files(base: str, count: int) -> list[str] {
+    paths: list[str] = [];
+    for i in range(count) {
+        p = os.path.join(base, f"m{i}.txt");
+        with open(p, "w") as fh {
+            fh.write(f"src-{i}");
+        }
+        paths.append(p);
+    }
+    return paths;
+}
+
+test "a hot entry survives an insert burst past capacity" {
+    saved = dict(jir._SRC_SHARED);
+    jir._SRC_SHARED.clear();
+    try {
+        with tempfile.TemporaryDirectory() as tmp {
+            paths = _write_files(tmp, 5);
+            hot = paths[0];
+            assert read_source_shared(hot) == "src-0";
+            for p in paths[1:4] {
+                read_source_shared(p);
+            }
+            assert len(jir._SRC_SHARED) == 4;
+            # a hit refreshes recency, so the hot entry is no longer oldest
+            assert read_source_shared(hot) == "src-0";
+            read_source_shared(paths[4]);
+            assert hot in jir._SRC_SHARED , (
+                "the fifth insert dropped the hot entry: not an LRU"
+            );
+            assert paths[1] not in jir._SRC_SHARED , (
+                "expected the least recently used entry to be the one evicted"
+            );
+            assert len(jir._SRC_SHARED) == 4 , "cache exceeded its capacity";
+        }
+    } finally {
+        jir._SRC_SHARED.clear();
+        jir._SRC_SHARED.update(saved);
+    }
+}
+
+test "a stale entry is refreshed in place without growing the cache" {
+    saved = dict(jir._SRC_SHARED);
+    jir._SRC_SHARED.clear();
+    try {
+        with tempfile.TemporaryDirectory() as tmp {
+            paths = _write_files(tmp, 4);
+            for p in paths {
+                read_source_shared(p);
+            }
+            assert len(jir._SRC_SHARED) == 4;
+            with open(paths[0], "w") as fh {
+                fh.write("src-0-rewritten");
+            }
+            assert read_source_shared(paths[0]) == "src-0-rewritten";
+            assert len(jir._SRC_SHARED) == 4;
+            assert paths[1] in jir._SRC_SHARED;
+        }
+    } finally {
+        jir._SRC_SHARED.clear();
+        jir._SRC_SHARED.update(saved);
+    }
+}
diff --git a/jac/tests/support.jac b/jac/tests/support.jac
index 4f62429..7c0ff58 100644
--- a/jac/tests/support.jac
+++ b/jac/tests/support.jac
@@ -11,6 +11,7 @@ Imported as `from tests.support`, which resolves identically under the single
 """
 
 import ctypes;
+import os;
 
 import from pathlib { Path }
 
@@ -19,6 +20,70 @@ glob TESTS_DIR: str = str(Path(__file__).resolve().parent),
      # Repo root (the `jac/` dir): the parent of `tests/`.
      JAC_ROOT: str = str(Path(__file__).resolve().parent.parent);
 
+# Checked-in fixtures for the graphmend compiler-pass tests.
+glob GRAPHMEND_FIXTURES: str = os.path.join(
+         JAC_ROOT, "tests", "compiler", "passes", "fixtures", "graphmend"
+     );
+
+"""Compile a source file with the given options and program (each defaulted
+when omitted) and return its generated Python source and bytecode."""
+def graphmend_compile_opts(
+    path: str, opts: any = None, prog: any = None
+) -> tuple[str, any] {
+    import ast;
+    import from jaclang.compiler.driver.compile_options { CompileOptions }
+    import from jaclang.compiler.driver.program { JacProgram }
+    use_opts = CompileOptions() if opts is None else opts;
+    use_prog: JacProgram = JacProgram() if prog is None else prog;
+    mod = use_prog.compile(file_path=path, options=use_opts);
+    pa = mod.gen.py_ast;
+    mod_ast: any = pa[0] if isinstance(pa, list) else pa;
+    return (ast.unparse(mod_ast), mod.gen.py_bytecode);
+}
+
+"""Compile a source file under the given graphmend setting and return its
+generated Python source."""
+def graphmend_compile_path(path: str, gm: bool) -> str {
+    import from jaclang.compiler.driver.compile_options { CompileOptions }
+    (src, _bc) = graphmend_compile_opts(path, CompileOptions(graphmend=gm));
+    return src;
+}
+
+"""Compile a checked-in graphmend .jac fixture and return its generated
+Python source."""
+def graphmend_pysrc(name: str, gm: bool) -> str {
+    return graphmend_compile_path(os.path.join(GRAPHMEND_FIXTURES, name), gm);
+}
+
+"""Compile a graphmend fixture with the transforms on and list the detection
+tags recorded on the compiled module's facts."""
+def graphmend_break_kinds(name: str) -> list {
+    import from jaclang.compiler.driver.compile_options { CompileOptions }
+    import from jaclang.compiler.driver.program { JacProgram }
+    mod = JacProgram().compile(
+        file_path=os.path.join(GRAPHMEND_FIXTURES, name),
+        options=CompileOptions(graphmend=True)
+    );
+    facts = mod.gen.graphmend_facts;
+    if facts is None {
+        return [];
+    }
+    return [k.value for k in facts.breaks.values()];
+}
+
+"""True when the code object (or any nested one) references the symbol."""
+def code_mentions_symbol(code: any, symbol: str) -> bool {
+    if symbol in code.co_names {
+        return True;
+    }
+    for const in code.co_consts {
+        if hasattr(const, "co_names") and code_mentions_symbol(const, symbol) {
+            return True;
+        }
+    }
+    return False;
+}
